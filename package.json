{
  "name": "erp-monorepo",
  "private": true,
  "scripts": {
    "postinstall": "pnpm db:generate",
    "predev": "pnpm db:generate && pnpm build:packages",
    "build:packages": "turbo run build --filter=./packages/*",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "db:generate": "pnpm --filter @skerp/server db:generate",
    "db:migrate": "pnpm --filter @skerp/server db:migrate",
    "db:deploy": "pnpm --filter @skerp/server db:deploy"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.9.12",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}
