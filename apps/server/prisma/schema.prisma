generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Polymorphic file attachment. Referenced by any host entity via
/// (entityType, entityId). Bytes live in S3; this row holds metadata only.
model Attachment {
  id              String          @id @default(cuid())
  entityType      String
  entityId        String
  branchId        String?
  s3Key           String          @unique
  originalName    String
  mime            String
  sizeBytes       Int
  uploaded        Boolean         @default(false)
  antivirusStatus AntivirusStatus @default(PENDING)
  scanError       String?
  uploadedBy      String
  uploadedAt      DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?
  uploader        User            @relation(fields: [uploadedBy], references: [id])

  @@index([entityType, entityId])
  @@index([antivirusStatus])
  @@index([branchId])
}

model User {
  id                          String      @id @default(uuid())
  userName                    String      @unique
  firstName                   String
  middleName                  String?
  lastName                    String
  email                       String      @unique
  companyId                   String
  branchId                    String
  roleId                      String
  createdAt                   DateTime    @default(now())
  updatedAt                   DateTime    @updatedAt
  password                    String?
  status                      Boolean
  branchScope                 BranchScope @default(ASSIGNED)
  mobile                      String?
  whatsappOptIn               Boolean     @default(false)
  emailOptIn                  Boolean     @default(true)
  notificationQuietHoursStart String?
  notificationQuietHoursEnd   String?

  attachments               Attachment[]
  auditLogs                 AuditLog[]
  inAppNotifications        InAppNotification[]
  notificationDeliveries    NotificationDelivery[]
  notificationSubscriptions UserNotificationSubscription[]
  userPermissions           UserPermission[]
  userBranches              UserBranch[]

  branch  Branch  @relation(fields: [branchId], references: [id])
  company Company @relation(fields: [companyId], references: [id])
  role    Role    @relation(fields: [roleId], references: [id])

  createdLRGroups   LRGroup[] @relation("CreatedLRGroup")
  finalisedLRGroups LRGroup[] @relation("FinalisedLRGroup")
  updatedLRGroups   LRGroup[] @relation("UpdatedLRGroup")

  createdLR LorryReceipt[] @relation("CreatedLR")
  updatedLR LorryReceipt[] @relation("UpdatedLR")

  createdLRDeliveries LRDelivery[]        @relation("CreatedLRDelivery")
  updatedLRDeliveries LRDelivery[]        @relation("UpdatedLRDelivery")
  createdLRAcks       LRAcknowledgement[] @relation("CreatedLRAck")
  updatedLRAcks       LRAcknowledgement[] @relation("UpdatedLRAck")

  approvedOrders Order[]      @relation("ApprovedOrders")
  createdOrders  Order[]      @relation("CreatedOrders")
  updatedOrders  Order[]      @relation("UpdatedOrders")
  orderEvents    OrderEvent[]

  TripStatusHistory TripStatusHistory[]

  createdTrips VehicleTrip[] @relation("CreatedTrips")
  updatedTrips VehicleTrip[] @relation("UpdatedTrips")

  createdVPSchedules   VPSchedule[] @relation("CreatedVPSchedules")
  updatedVPSchedules   VPSchedule[] @relation("UpdatedVPSchedules")
  finalisedVPSchedules VPSchedule[] @relation("FinalisedVPSchedules")

  generatedRailRakes  RailRake[] @relation("GeneratedRailRakes")
  dispatchedRailRakes RailRake[] @relation("DispatchedRailRakes")

  createdMRRRs MRRR[] @relation("CreatedMRRR")
  updatedMRRRs MRRR[] @relation("UpdatedMRRR")

  createdGRNs GRN[] @relation("CreatedGRN")
  updatedGRNs GRN[] @relation("UpdatedGRN")

  createdVPLoadings   VPLoading[] @relation("CreatedVPLoading")
  updatedVPLoadings   VPLoading[] @relation("UpdatedVPLoading")
  cancelledVPLoadings VPLoading[] @relation("CancelledVPLoading")

  createdVPWagonLoadings          VPWagonLoading[] @relation("CreatedVPWagonLoading")
  updatedVPWagonLoadings          VPWagonLoading[] @relation("UpdatedVPWagonLoading")
  verifiedVPWagonLoadings         VPWagonLoading[] @relation("VerifiedVPWagonLoading")
  cancelledVPWagonLoadings        VPWagonLoading[] @relation("CancelledVPWagonLoading")
  capacityOverrideVPWagonLoadings VPWagonLoading[] @relation("VPWagonCapacityOverride")

  createdRailBranchGRNs   RailBranchGRN[] @relation("CreatedRailBranchGRNs")
  updatedRailBranchGRNs   RailBranchGRN[] @relation("UpdatedRailBranchGRNs")
  submittedRailBranchGRNs RailBranchGRN[] @relation("SubmittedRailBranchGRNs")

  createdDeliveryChallans   DeliveryChallan[] @relation("CreatedDeliveryChallans")
  updatedDeliveryChallans   DeliveryChallan[] @relation("UpdatedDeliveryChallans")
  issuedDeliveryChallans    DeliveryChallan[] @relation("IssuedDeliveryChallans")
  cancelledDeliveryChallans DeliveryChallan[] @relation("CancelledDeliveryChallans")

  createdRailRakeOperations   RailRakeOperation[]     @relation("CreatedRailRakeOperations")
  updatedRailRakeOperations   RailRakeOperation[]     @relation("UpdatedRailRakeOperations")
  submittedRailRakeOperations RailRakeOperation[]     @relation("SubmittedRailRakeOperations")
  createdRailRakeCharges      RailRakeCharge[]        @relation("CreatedRailRakeCharges")
  updatedRailRakeCharges      RailRakeCharge[]        @relation("UpdatedRailRakeCharges")
  createdRailRakeWaivers      RailRakeChargeWaiver[]  @relation("CreatedRailRakeWaivers")
  approvedRailRakeWaivers     RailRakeChargeWaiver[]  @relation("ApprovedRailRakeWaivers")
  createdRailRakePayments     RailRakeChargePayment[] @relation("CreatedRailRakeChargePayments")
  confirmedRailRakePayments   RailRakeChargePayment[] @relation("ConfirmedRailRakeChargePayments")

  assignedOneLapTrackerAssignments OneLapTrackerAssignment[] @relation("AssignedOneLapTrackerAssignments")
  releasedOneLapTrackerAssignments OneLapTrackerAssignment[] @relation("ReleasedOneLapTrackerAssignments")

  createdJourneys VehicleJourney[] @relation("CreatedJourneys")
  updatedJourneys VehicleJourney[] @relation("UpdatedJourneys")

  createdTripExpenses   TripExpense[]   @relation("CreatedTripExpenses")
  createdDriverAdvances DriverAdvance[] @relation("CreatedDriverAdvances")
  generatedLogSlips     LogSlip[]       @relation("GeneratedLogSlips")

  tablePrefs UserTablePref[]
}

/// Per-user UI table layout (column order + visibility), keyed per table.
model UserTablePref {
  id        String   @id @default(cuid())
  userId    String
  tableKey  String
  prefs     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tableKey])
}

model Company {
  id                String      @id @default(cuid())
  name              String      @unique
  address           String?
  country           String
  contactPhone      String?
  establishmentYear DateTime
  companyPAN        String?
  companyTAN        String?
  mainLogoPath      String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  cityId            String?
  stateId           String?
  agreements        Agreement[]
  branches          Branch[]
  city              City?       @relation("CityCompanies", fields: [cityId], references: [id])
  state             State?      @relation(fields: [stateId], references: [id])
  users             User[]
}

model Branch {
  id           String  @id @default(cuid())
  branchCode   String  @unique
  name         String
  cityId       String?
  address      String?
  contactName  String?
  contactPhone String?
  email        String?
  weeklyOffDay String?
  gstNo        String?
  workingHours String?

  allowLR      Boolean @default(false)
  isRailHead   Boolean @default(false)
  allowReceipt Boolean @default(true)
  // Marks the HO / hub branch (Jalgaon). Hub on an LR is derived from this,
  // never picked. Exactly one branch should have this set.
  isHeadOffice Boolean @default(false)

  companyId   String
  warehouseId String?

  company    Company     @relation(fields: [companyId], references: [id])
  warehouses Warehouse[] @relation("BranchWarehouses")
  agreements Agreement[] @relation("BranchAgreement")
  workers    Labour[]    @relation("WorkerBranch")

  homeJourneys VehicleJourney[] @relation("JourneyHomeBranch")

  users              User[]
  userBranches       UserBranch[]
  city               City?                @relation(fields: [cityId], references: [id])
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  fromOrders         Order[]              @relation("FromBranch")
  toOrders           Order[]              @relation("ToBranch")
  originGroups       LRGroup[]            @relation("GroupOrigin")
  destinationGroups  LRGroup[]            @relation("GroupDestination")
  hubGroups          LRGroup[]            @relation("GroupHub")
  railheadGroups     LRGroup[]            @relation("GroupRailhead")
  vpSchedulesFrom    VPSchedule[]         @relation("VPScheduleFromBranch")
  vpSchedulesTo      VPSchedule[]         @relation("VPScheduleToBranch")
  railRakesFrom      RailRake[]           @relation("RailRakeFromBranch")
  railRakesTo        RailRake[]           @relation("RailRakeToBranch")
  railRakeOperations RailRakeOperation[]
  deliveryChallans   DeliveryChallan[]    @relation("DeliveryChallanSourceBranch")
  managedRailheads   BranchRailheadArea[]
  creditors          Creditor[]           @relation("BranchCreditor")
  cashPayments       CashPayment[]        @relation("BranchCashPayment")
}

model Warehouse {
  id              String    @id @default(cuid())
  name            String
  type            String
  address         String?
  country         String
  branchId        String
  contactName     String?
  contactPhone    String?
  monthlyRent     BigInt?
  securityDeposit BigInt?
  agreementDate   DateTime?
  expiryDate      DateTime?
  length          Float?
  width           Float?
  breadth         Float?
  gateNo          String?
  storageCapacity Float?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  cityId          String
  stateId         String
  branch          Branch    @relation("BranchWarehouses", fields: [branchId], references: [id])
  city            City      @relation(fields: [cityId], references: [id])
  state           State     @relation(fields: [stateId], references: [id])
}

model Role {
  id              String           @id @default(cuid())
  name            String           @unique
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @default(now()) @updatedAt
  isSystem        Boolean          @default(false)
  rolePermissions RolePermission[]
  users           User[]
}

model PermissionDef {
  id              String           @id @default(cuid())
  key             String           @unique
  moduleCode      String
  description     String?
  isSystem        Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions RolePermission[]
  userPermissions UserPermission[]

  @@index([moduleCode])
}

model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime      @default(now())
  permission   PermissionDef @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role          @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model UserPermission {
  userId       String
  permissionId String
  effect       PermissionEffect
  createdAt    DateTime         @default(now())
  permission   PermissionDef    @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
  @@index([permissionId])
}

model UserBranch {
  userId    String
  branchId  String
  createdAt DateTime @default(now())
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, branchId])
  @@index([branchId])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  action    String
  entity    String
  entityId  String
  before    Json?
  after     Json?
  createdAt DateTime @default(now())
  actor     User     @relation(fields: [actorId], references: [id])

  @@index([entity, entityId])
  @@index([actorId])
  @@index([createdAt])
}

model NotificationEvent {
  id            String                  @id @default(cuid())
  eventType     String
  sourceModule  String
  aggregateType String
  aggregateId   String
  branchId      String?
  actorId       String?
  payload       Json
  dedupeKey     String?                 @unique
  status        NotificationEventStatus @default(PENDING)
  attemptCount  Int                     @default(0)
  lastError     String?
  createdAt     DateTime                @default(now())
  processedAt   DateTime?
  deliveries    NotificationDelivery[]

  @@index([eventType])
  @@index([sourceModule])
  @@index([aggregateType, aggregateId])
  @@index([branchId])
  @@index([status, createdAt])
}

model NotificationRule {
  id                   String                @id @default(cuid())
  eventType            String
  name                 String
  description          String?
  enabled              Boolean               @default(true)
  severity             NotificationSeverity  @default(INFO)
  critical             Boolean               @default(false)
  recipientResolverKey String
  channels             NotificationChannel[]
  templateId           String?
  sourceModule         String?
  branchId             String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  template             NotificationTemplate? @relation(fields: [templateId], references: [id])

  @@index([eventType])
  @@index([enabled])
  @@index([sourceModule])
  @@index([branchId])
}

model NotificationTemplate {
  id                 String              @id @default(cuid())
  code               String
  channel            NotificationChannel
  subject            String?
  body               String
  meta               Json?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  metaCategory       String?
  metaFooter         String?
  metaLanguage       String?
  metaName           String?
  metaParamOrder     String[]            @default([])
  metaRejectedReason String?
  metaStatus         String?
  metaSubmittedAt    DateTime?
  metaSyncedAt       DateTime?
  metaTemplateId     String?
  rules              NotificationRule[]

  @@unique([code, channel])
}

model NotificationDelivery {
  id                String                     @id @default(cuid())
  eventId           String
  channel           NotificationChannel
  recipientUserId   String
  status            NotificationDeliveryStatus @default(PENDING)
  providerMessageId String?
  attemptCount      Int                        @default(0)
  lastError         String?
  sentAt            DateTime?
  deliveredAt       DateTime?
  failedAt          DateTime?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  inAppNotification InAppNotification?
  event             NotificationEvent          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  recipient         User                       @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@unique([eventId, channel, recipientUserId])
  @@index([recipientUserId, status])
  @@index([channel, status])
  @@index([createdAt])
}

model InAppNotification {
  id         String               @id @default(cuid())
  deliveryId String               @unique
  userId     String
  title      String
  body       String
  severity   NotificationSeverity @default(INFO)
  linkUrl    String?
  readAt     DateTime?
  archivedAt DateTime?
  createdAt  DateTime             @default(now())
  delivery   NotificationDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([userId, archivedAt])
}

model UserNotificationSubscription {
  userId     String
  eventType  String
  channel    NotificationChannel
  subscribed Boolean             @default(true)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, eventType, channel])
  @@index([eventType, channel])
}

model Vehicle {
  id                 String        @id @default(cuid())
  vehicleNumber      String        @unique
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  bodyType           String?
  capacityMT         Float
  chasisNumber       String        @unique
  engineNumber       String        @unique
  insuranceCompany   String?
  insuranceDueDate   DateTime?
  insuranceIssueDate DateTime?
  insuranceNumber    String?
  lengthFeet         String?
  ownershipType      ownershipType
  purchaseDate       DateTime?
  wheels             String?
  currentKM          Int
  openingKM          Int
  status             VehicleStatus @default(AVAILABLE)
  vehicleTypeId      String
  transportId        String?
  marketLRGroups     LRGroup[]     @relation("LRGroupMarketVehicle")
  vehicleTypeRef     VehicleType   @relation(fields: [vehicleTypeId], references: [id])
  transport          Transport?    @relation(fields: [transportId], references: [id], onDelete: Restrict)

  VehicleTrip      VehicleTrip[]
  journeys         VehicleJourney[]
  driverAdvances   DriverAdvance[]
  logSlips         LogSlip[]
  deliveryChallans DeliveryChallan[]

  @@index([transportId, ownershipType])
}

model Customer {
  id                      String             @id @default(cuid())
  name                    String
  shortName               String?
  customerPAN             String?
  disallowNewLRBooking    Boolean            @default(false)
  interestRateLatePayment BigInt?
  gstNo                   String?
  creditLimit             BigInt?
  tdsDeductionRate        BigInt?
  address                 String?
  country                 String?
  contactPhone            String?
  primaryEmail            String?
  contactPerson           String?
  mobileNo                String?
  website                 String?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  cityId                  String
  stateId                 String
  agreements              Agreement[]        @relation("CustomerAgreements")
  city                    City               @relation(fields: [cityId], references: [id])
  state                   State              @relation(fields: [stateId], references: [id])
  locations               CustomerLocation[]
  consigneeGroups         LRGroup[]          @relation("GroupConsignee")
  consignorGroups         LRGroup[]          @relation("GroupConsignor")
  consigneeOrders         Order[]            @relation("OrderConsignee")
  orders                  Order[]            @relation("OrderCustomer")
  vehicleTrips            VehicleTrip[]
}

model Agreement {
  id                      String          @id @default(cuid())
  companyId               String
  clientId                String
  startDate               DateTime
  agreementDate           DateTime
  expiryDate              DateTime
  leadGeneratedByBranchId String
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
  cityId                  String
  city                    City            @relation(fields: [cityId], references: [id])
  client                  Customer        @relation("CustomerAgreements", fields: [clientId], references: [id])
  company                 Company         @relation(fields: [companyId], references: [id])
  branch                  Branch          @relation("BranchAgreement", fields: [leadGeneratedByBranchId], references: [id])
  detentionRates          DetentionRate[]
  RateMatrix              RateMatrix[]
}

model DetentionRate {
  id           String            @id @default(cuid())
  agreementId  String
  type         DetentionRateType
  fromDuration Int
  toDuration   Int
  rate         Int
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  agreement    Agreement         @relation(fields: [agreementId], references: [id], onDelete: Cascade)
}

model Route {
  id                String        @id @default(cuid())
  sourceCityId      String
  destinationCityId String
  orders            Order[]
  rateMatrixEntries RateMatrix[]
  destinationCity   City          @relation("DestinationRoute", fields: [destinationCityId], references: [id])
  sourceCity        City          @relation("SourceRoute", fields: [sourceCityId], references: [id])
  VehicleTrip       VehicleTrip[]

  @@unique([sourceCityId, destinationCityId])
}

model RateUnit {
  id         String       @id @default(cuid())
  unitValue  BigInt
  unitType   RateUnitType
  isActive   Boolean      @default(true)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  rateMatrix RateMatrix[]

  @@unique([unitValue, unitType])
}

model RateMatrix {
  id            String            @id @default(cuid())
  agreementId   String
  routeId       String
  rate          BigInt
  transitDays   Int?
  remarks       String?
  vehicleTypeId String?
  transportType RateTransportType @default(ROAD)
  unitId        String?
  agreement     Agreement         @relation(fields: [agreementId], references: [id])
  route         Route             @relation(fields: [routeId], references: [id])
  unit          RateUnit?         @relation(fields: [unitId], references: [id])
  vehicleType   VehicleType?      @relation(fields: [vehicleTypeId], references: [id])
  VehicleTrip   VehicleTrip[]

  @@unique([agreementId, routeId, vehicleTypeId, unitId, transportType])
}

model Driver {
  id                     String           @id @default(cuid())
  name                   String
  photoPath              String?
  type                   String
  birthDate              DateTime?
  anniversaryDate        DateTime?
  mobile                 String
  alternateMobile        String?
  licenseNo              String
  licenseDate            DateTime?
  licenseExpiryDate      DateTime?
  licenseCity            String?
  permanentAddress       String?
  permanentCountry       String?
  permanentState         String?
  permanentCity          String?
  correspondenceAddress  String?
  correspondenceCountry  String?
  correspondenceState    String?
  correspondenceCity     String?
  correspondenceLandline String?
  referencePerson        String?
  referenceContactNo     String?
  bloodGroup             String?
  otherDetails           String?
  salary                 BigInt?
  panNo                  String?
  aadharCardNo           String?
  noTDSApplyAmount       Int?
  tdsRate                Int?
  onLeave                Boolean          @default(false)
  blackListed            Boolean          @default(false)
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  status                 DriverStatus     @default(AVAILABLE)
  VehicleTrip            VehicleTrip[]
  journeys               VehicleJourney[]
  advances               DriverAdvance[]
  logSlips               LogSlip[]
}

model Goods {
  id                String                  @id @default(cuid())
  name              String
  description       String?
  weight            Float?
  length            Float?
  width             Float?
  height            Float?
  isStackingAllowed Boolean                 @default(false)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  category          GoodsCategory
  storagePosition   GoodsStoragePosition
  storageLayer      GoodsStorageLayer
  consignmentGoods  OrderConsignmentGoods[]
  orderItems        OrderItem[]
}

model Labour {
  id                         String            @id @default(cuid())
  name                       String
  photoPath                  String?
  address                    String?
  contactName                String?
  contactPhone               String?
  mobileNo                   String?
  referredBy                 String?
  refContactNo               String?
  startDate                  DateTime?
  pan                        String?
  tdsAmount                  BigInt?
  tdsRate                    BigInt?
  type                       WorkerType
  branchId                   String
  createdAt                  DateTime          @default(now())
  updatedAt                  DateTime          @updatedAt
  cityId                     String
  branch                     Branch            @relation("WorkerBranch", fields: [branchId], references: [id])
  city                       City              @relation(fields: [cityId], references: [id])
  grnLabours                 GRN[]             @relation("GRNLabour")
  supervisedGRNs             GRN[]             @relation("GRNUnloadingSupervisor")
  vpWagonLoadings            VPWagonLoading[]  @relation("VPWagonLoadingLabour")
  supervisedVPWagonLoadings  VPWagonLoading[]  @relation("VPWagonLoadingSupervisor")
  ledRailBranchGRNs          RailBranchGRN[]   @relation("RailBranchGRNLabourLeader")
  supervisedRailBranchGRNs   RailBranchGRN[]   @relation("RailBranchGRNUnloadingSupervisor")
  supervisedDeliveryChallans DeliveryChallan[] @relation("DeliveryChallanSupervisor")
}

model City {
  id                  String                 @id @default(cuid())
  name                String
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  stateId             String
  agreements          Agreement[]
  areas               Area[]
  branches            Branch[]
  state               State                  @relation(fields: [stateId], references: [id])
  companies           Company[]              @relation("CityCompanies")
  customers           Customer[]
  customerLocations   CustomerLocation[]
  labours             Labour[]
  orders              Order[]
  pumps               Pump[]                 @relation("PumpCity")
  destinationFor      RailwayFreightMatrix[] @relation("DestinationCity")
  sourceFor           RailwayFreightMatrix[] @relation("SourceCity")
  destinationRoute    Route[]                @relation("DestinationRoute")
  sourceRoute         Route[]                @relation("SourceRoute")
  spareSuppliers      SparePartSupplier[]    @relation("SparePartySupplierCity")
  transports          Transport[]
  tripUnloadingPoints TripUnloadingPoint[]
  warehouses          Warehouse[]
  journeyStarts       VehicleJourney[]       @relation("JourneyStartCity")
  journeyReturns      VehicleJourney[]       @relation("JourneyReturnCity")
  journeyCurrent      VehicleJourney[]       @relation("JourneyCurrentCity")
  tripsFrom           VehicleTrip[]          @relation("TripFromCity")
  tripsTo             VehicleTrip[]          @relation("TripToCity")
  tripExpenses        TripExpense[]          @relation("TripExpenseCity")
}

model Area {
  id               String  @id @default(cuid())
  name             String
  cityId           String
  formattedAddress String?
  googlePlaceId    String? @unique
  isRailHead       Boolean @default(false)
  latitude         Float?
  longitude        Float?

  customerLocations CustomerLocation[]
  city              City               @relation(fields: [cityId], references: [id])

  vpSchedulesAsSource      VPSchedule[]        @relation("VPScheduleSourceArea")
  vpSchedulesAsDestination VPSchedule[]        @relation("VPScheduleDestinationArea")
  deliveryChallans         DeliveryChallan[]   @relation("DeliveryChallanDestinationArea")
  railRakeOperations       RailRakeOperation[]

  railwayFreightAsSource        RailwayFreightMatrix[] @relation("RailwayFreightSourceArea")
  railwayFreightAsDestination   RailwayFreightMatrix[] @relation("RailwayFreightDestinationArea")
  managingBranches              BranchRailheadArea[]
  lrGroupsAsSourceRailhead      LRGroup[]              @relation("LRGroupSourceRailheadArea")
  lrGroupsAsDestinationRailhead LRGroup[]              @relation("LRGroupDestinationRailheadArea")

  @@unique([cityId, name])
  @@index([isRailHead])
}

