generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum WorkerType {
  Supervisor
  Hamal
  Mechanic
}

enum SpareType {
  Item
  Service
}

enum PartType {
  Item
  Service
}

enum GoodsCategory {
  Heavy
  Light
}

enum GoodsStoragePosition {
  Any
  Horizontal
  Vertical
}

enum GoodsStorageLayer {
  Both
  Bottom
  Upper
}

enum OrderType {
  Truck
  Item
}

enum OrderStatus {
  PendingApproval
  Confirmed
  Rejected
  Cancelled
  InProgress
  Completed
}

enum BranchScope {
  ALL
  ASSIGNED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  WHATSAPP
}

enum NotificationSeverity {
  INFO
  SUCCESS
  WARNING
  CRITICAL
}

enum NotificationEventStatus {
  PENDING
  FANOUT_COMPLETE
  FAILED
}

enum NotificationDeliveryStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  SKIPPED
}

enum AntivirusStatus {
  PENDING
  CLEAN
  INFECTED
  FAILED
}

/// Polymorphic file attachment. Referenced by any host entity via
/// (entityType, entityId). Bytes live in S3; this row holds metadata only.
model Attachment {
  id              String          @id @default(cuid())
  entityType      String // "User" | "Order" | "LR" | "Vehicle" | "Driver" | ...
  entityId        String
  branchId        String? // set from host entity when available (branch scoping later)
  s3Key           String          @unique
  originalName    String
  mime            String
  sizeBytes       Int
  uploaded        Boolean         @default(false) // S3 PUT confirmed
  antivirusStatus AntivirusStatus @default(PENDING)
  scanError       String?
  uploadedBy      String
  uploadedAt      DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?

  uploader User @relation(fields: [uploadedBy], references: [id])

  @@index([entityType, entityId])
  @@index([antivirusStatus])
  @@index([branchId])
}

model User {
  id         String  @id @default(uuid())
  userName   String  @unique
  firstName  String
  middleName String?
  lastName   String
  email      String  @unique
  companyId  String
  branchId   String
  roleId     String
  status     Boolean
  password   String?

  branchScope                 BranchScope @default(ASSIGNED)
  mobile                      String?
  whatsappOptIn               Boolean     @default(false)
  emailOptIn                  Boolean     @default(true)
  notificationQuietHoursStart String?
  notificationQuietHoursEnd   String?

  company Company @relation(fields: [companyId], references: [id])
  branch  Branch  @relation(fields: [branchId], references: [id])
  role    Role    @relation(fields: [roleId], references: [id])

  createdOrders  Order[]      @relation("CreatedOrders")
  updatedOrders  Order[]      @relation("UpdatedOrders")
  approvedOrders Order[]      @relation("ApprovedOrders")
  orderEvents    OrderEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdLR         LorryReceipt[]      @relation("CreatedLR")
  updatedLR         LorryReceipt[]      @relation("UpdatedLR")
  finalisedLR       LorryReceipt[]      @relation("FinalisedLR")
  createdTrips      VehicleTrip[]       @relation("CreatedTrips")
  updatedTrips      VehicleTrip[]       @relation("UpdatedTrips")
  TripStatusHistory TripStatusHistory[]

  userBranches              UserBranch[]
  userPermissions           UserPermission[]
  auditLogs                 AuditLog[]
  notificationDeliveries    NotificationDelivery[]
  inAppNotifications        InAppNotification[]
  notificationSubscriptions UserNotificationSubscription[]
  attachments               Attachment[]
}

model Company {
  id      String  @id @default(cuid())
  name    String  @unique
  address String?
  country String
  stateId String?
  cityId  String?

  contactPhone      String?
  establishmentYear DateTime
  companyPAN        String?
  mainLogoPath      String?
  companyTAN        String?
  branches          Branch[]
  users             User[]
  agreements        Agreement[]
  state             State?      @relation(fields: [stateId], references: [id])
  city              City?       @relation("CityCompanies", fields: [cityId], references: [id])
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
}

model Branch {
  id           String  @id @default(cuid())
  branchCode   String  @unique
  shortCode    String  @unique
  name         String
  cityId       String?
  address      String?
  contactName  String?
  contactPhone String?
  email        String?
  weeklyOffDay String?
  gstNo        String?
  workingHours String?

  allowLR      Boolean @default(false)
  isRailHead   Boolean @default(false)
  allowReceipt Boolean @default(true)
  // Marks the HO / hub branch (Jalgaon). Hub on an LR is derived from this,
  // never picked. Exactly one branch should have this set.
  isHeadOffice Boolean @default(false)

  companyId   String
  warehouseId String?

  company    Company     @relation(fields: [companyId], references: [id])
  warehouses Warehouse[] @relation("BranchWarehouses")
  agreements Agreement[] @relation("BranchAgreement")
  workers    Labour[]    @relation("WorkerBranch")

  users          User[]
  userBranches   UserBranch[]
  city           City?          @relation(fields: [cityId], references: [id])
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  fromOrders     Order[]        @relation("FromBranch")
  toOrders       Order[]        @relation("ToBranch")
  originLRs      LorryReceipt[] @relation("LROrigin")
  destinationLRs LorryReceipt[] @relation("LRDestination")
  hubLRs         LorryReceipt[] @relation("LRHub")
  railheadLRs    LorryReceipt[] @relation("LRRailhead")
}

model Warehouse {
  id      String  @id @default(cuid())
  name    String
  type    String // Can later be enum if needed
  address String?
  country String
  stateId String
  cityId  String

  branchId String

  contactName  String?
  contactPhone String?

  monthlyRent     BigInt?
  securityDeposit BigInt?

  agreementDate DateTime?
  expiryDate    DateTime?

  length          Float?
  width           Float?
  breadth         Float?
  gateNo          String?
  storageCapacity Float?

  branch    Branch   @relation("BranchWarehouses", fields: [branchId], references: [id])
  state     State    @relation(fields: [stateId], references: [id])
  city      City     @relation(fields: [cityId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Role {
  id              String           @id @default(cuid())
  name            String           @unique
  isSystem        Boolean          @default(false)
  users           User[]
  rolePermissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

// Permission catalog: one row per known permission key. Loaded from the
// shared `@skerp/types` registry by the seed script.
model PermissionDef {
  id          String  @id @default(cuid())
  key         String  @unique
  moduleCode  String
  description String?
  isSystem    Boolean @default(false)

  rolePermissions RolePermission[]
  userPermissions UserPermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([moduleCode])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role          @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission PermissionDef @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([roleId, permissionId])
  @@index([permissionId])
}

enum PermissionEffect {
  GRANT
  DENY
}

model UserPermission {
  userId       String
  permissionId String
  effect       PermissionEffect

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission PermissionDef @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([userId, permissionId])
  @@index([permissionId])
}

model UserBranch {
  userId   String
  branchId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([userId, branchId])
  @@index([branchId])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  action    String
  entity    String
  entityId  String
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  actor User @relation(fields: [actorId], references: [id])

  @@index([entity, entityId])
  @@index([actorId])
  @@index([createdAt])
}

model NotificationEvent {
  id            String                  @id @default(cuid())
  eventType     String
  sourceModule  String
  aggregateType String
  aggregateId   String
  branchId      String?
  actorId       String?
  payload       Json
  dedupeKey     String?                 @unique
  status        NotificationEventStatus @default(PENDING)
  attemptCount  Int                     @default(0)
  lastError     String?
  createdAt     DateTime                @default(now())
  processedAt   DateTime?

  deliveries NotificationDelivery[]

  @@index([eventType])
  @@index([sourceModule])
  @@index([aggregateType, aggregateId])
  @@index([branchId])
  @@index([status, createdAt])
}

model NotificationRule {
  id                   String                @id @default(cuid())
  eventType            String
  name                 String
  description          String?
  enabled              Boolean               @default(true)
  severity             NotificationSeverity  @default(INFO)
  critical             Boolean               @default(false)
  recipientResolverKey String
  channels             NotificationChannel[]
  templateId           String?
  sourceModule         String?
  branchId             String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  template NotificationTemplate? @relation(fields: [templateId], references: [id])

  @@index([eventType])
  @@index([enabled])
  @@index([sourceModule])
  @@index([branchId])
}

model NotificationTemplate {
  id        String              @id @default(cuid())
  code      String
  channel   NotificationChannel
  subject   String?
  body      String
  meta      Json?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  // Meta WhatsApp template lifecycle (used only when channel = WHATSAPP)
  metaName           String?
  metaLanguage       String?
  metaCategory       String?
  metaStatus         String? // DRAFT | PENDING | APPROVED | REJECTED | DISABLED
  metaTemplateId     String?
  metaRejectedReason String?
  metaParamOrder     String[]  @default([])
  metaFooter         String?
  metaSubmittedAt    DateTime?
  metaSyncedAt       DateTime?

  rules NotificationRule[]

  @@unique([code, channel])
}

model NotificationDelivery {
  id                String                     @id @default(cuid())
  eventId           String
  channel           NotificationChannel
  recipientUserId   String
  status            NotificationDeliveryStatus @default(PENDING)
  providerMessageId String?
  attemptCount      Int                        @default(0)
  lastError         String?
  sentAt            DateTime?
  deliveredAt       DateTime?
  failedAt          DateTime?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  event             NotificationEvent  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  recipient         User               @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)
  inAppNotification InAppNotification?

  @@unique([eventId, channel, recipientUserId])
  @@index([recipientUserId, status])
  @@index([channel, status])
  @@index([createdAt])
}

model InAppNotification {
  id         String               @id @default(cuid())
  deliveryId String               @unique
  userId     String
  title      String
  body       String
  severity   NotificationSeverity @default(INFO)
  linkUrl    String?
  readAt     DateTime?
  archivedAt DateTime?
  createdAt  DateTime             @default(now())

  delivery NotificationDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  user     User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([userId, archivedAt])
}

model UserNotificationSubscription {
  userId     String
  eventType  String
  channel    NotificationChannel
  subscribed Boolean             @default(true)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, eventType, channel])
  @@index([eventType, channel])
}

enum ownershipType {
  Own_Vehicle
  Market_Vehicle
}

enum vehicleType {
  Container
  Open_Body
  TATA_407
  DCM_Lorry
  DI_Pickup
}

enum VehicleStatus {
  AVAILABLE
  ON_TRIP
}

model Vehicle {
  id            String @id @default(cuid())
  vehicleNumber String @unique
  chasisNumber  String @unique
  engineNumber  String @unique

  ownershipType      ownershipType
  vehicleTypeId      String
  capacityMT         Float
  wheels             String?
  bodyType           String?
  lengthFeet         String?
  openingKM          Int
  currentKM          Int
  purchaseDate       DateTime?
  insuranceNumber    String?
  insuranceCompany   String?
  insuranceIssueDate DateTime?
  insuranceDueDate   DateTime?

  status VehicleStatus @default(AVAILABLE)

  vehicleTypeRef VehicleType @relation(fields: [vehicleTypeId], references: [id])

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  VehicleTrip VehicleTrip[]
}

model Customer {
  id                      String  @id @default(cuid())
  name                    String
  shortName               String?
  customerPAN             String?
  disallowNewLRBooking    Boolean @default(false)
  interestRateLatePayment BigInt?
  gstNo                   String?
  creditLimit             BigInt?
  tdsDeductionRate        BigInt?

  address String?
  country String?
  stateId String
  cityId  String

  contactPhone String?
  primaryEmail String?

  contactPerson String?
  mobileNo      String?
  website       String?

  agreements   Agreement[]        @relation("CustomerAgreements")
  state        State              @relation(fields: [stateId], references: [id])
  city         City               @relation(fields: [cityId], references: [id])
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  orders       Order[]
  locations    CustomerLocation[]
  consignorLRs LorryReceipt[]     @relation("LRConsignor")
  consigneeLRs LorryReceipt[]     @relation("LRConsignee")
  vehicleTrips VehicleTrip[]
}

model Agreement {
  id            String   @id @default(cuid())
  companyId     String
  clientId      String
  cityId        String
  startDate     DateTime
  agreementDate DateTime
  expiryDate    DateTime

  leadGeneratedByBranchId String

  company   Company  @relation(fields: [companyId], references: [id])
  client    Customer @relation("CustomerAgreements", fields: [clientId], references: [id])
  branch    Branch   @relation("BranchAgreement", fields: [leadGeneratedByBranchId], references: [id])
  city      City     @relation(fields: [cityId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  detentionRates DetentionRate[]
  RateMatrix     RateMatrix[]
}

enum DetentionRateType {
  DAY
  HOUR
}

model DetentionRate {
  id           String            @id @default(cuid())
  agreementId  String
  type         DetentionRateType
  fromDuration Int
  toDuration   Int
  rate         Int

  agreement Agreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Route {
  id                String        @id @default(cuid())
  sourceCityId      String
  destinationCityId String
  sourceCity        City          @relation("SourceRoute", fields: [sourceCityId], references: [id])
  destinationCity   City          @relation("DestinationRoute", fields: [destinationCityId], references: [id])
  rateMatrixEntries RateMatrix[]
  VehicleTrip       VehicleTrip[]
  orders            Order[]

  @@unique([sourceCityId, destinationCityId])
}

model RateUnit {
  id        String       @id @default(cuid())
  unitValue BigInt
  unitType  RateUnitType
  isActive  Boolean      @default(true)

  rateMatrix RateMatrix[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([unitValue, unitType])
}

model RateMatrix {
  id            String            @id @default(cuid())
  agreementId   String
  routeId       String
  vehicleTypeId String?
  unitId        String?
  transportType RateTransportType @default(ROAD)

  rate        BigInt
  transitDays Int?
  remarks     String?

  agreement   Agreement    @relation(fields: [agreementId], references: [id])
  route       Route        @relation(fields: [routeId], references: [id])
  vehicleType VehicleType? @relation(fields: [vehicleTypeId], references: [id])
  unit        RateUnit?    @relation(fields: [unitId], references: [id])

  VehicleTrip VehicleTrip[]

  @@unique([agreementId, routeId, vehicleTypeId, unitId, transportType])
}

enum RateUnitType {
  HQ
  LQ
}

enum RateTransportType {
  RAIL_ROAD
  ROAD
}

enum DriverStatus {
  AVAILABLE
  ON_TRIP
}

model Driver {
  id                     String        @id @default(cuid())
  name                   String
  photoPath              String?
  status                 DriverStatus  @default(AVAILABLE)
  type                   String
  birthDate              DateTime?
  anniversaryDate        DateTime?
  mobile                 String
  alternateMobile        String?
  licenseNo              String
  licenseDate            DateTime?
  licenseExpiryDate      DateTime?
  licenseCity            String?
  permanentAddress       String?
  permanentCountry       String?
  permanentState         String?
  permanentCity          String?
  correspondenceAddress  String?
  correspondenceCountry  String?
  correspondenceState    String?
  correspondenceCity     String?
  correspondenceLandline String?
  referencePerson        String?
  referenceContactNo     String?
  bloodGroup             String?
  otherDetails           String?
  salary                 BigInt?
  panNo                  String?
  aadharCardNo           String?
  noTDSApplyAmount       Int?
  tdsRate                Int?
  onLeave                Boolean       @default(false)
  blackListed            Boolean       @default(false)
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  VehicleTrip            VehicleTrip[]
}

model Goods {
  id          String  @id @default(cuid())
  name        String
  description String?

  weight Float?
  length Float?
  width  Float?
  height Float?

  category        GoodsCategory
  storagePosition GoodsStoragePosition
  storageLayer    GoodsStorageLayer

  isStackingAllowed Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItems OrderItem[]
}

model Labour {
  id           String  @id @default(cuid())
  name         String
  photoPath    String? // For uploaded file
  address      String?
  cityId       String
  contactName  String?
  contactPhone String?
  mobileNo     String?

  referredBy   String?
  refContactNo String?

  startDate DateTime?
  pan       String?
  tdsAmount BigInt?
  tdsRate   BigInt?

  type     WorkerType // Enum: Supervisor, Hamal, Mechanic
  branchId String

  branch    Branch   @relation("WorkerBranch", fields: [branchId], references: [id])
  city      City     @relation(fields: [cityId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model City {
  id             String                 @id @default(cuid())
  name           String
  stateId        String
  state          State                  @relation(fields: [stateId], references: [id])
  sourceFor      RailwayFreightMatrix[] @relation("SourceCity")
  destinationFor RailwayFreightMatrix[] @relation("DestinationCity")
  pumps          Pump[]                 @relation("PumpCity")
  spareSuppliers SparePartSupplier[]    @relation("SparePartySupplierCity")

  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  orders              Order[]
  customerLocations   CustomerLocation[]
  sourceRoute         Route[]              @relation("SourceRoute")
  destinationRoute    Route[]              @relation("DestinationRoute")
  areas               Area[]
  companies           Company[]            @relation("CityCompanies")
  branches            Branch[]
  warehouses          Warehouse[]
  customers           Customer[]
  agreements          Agreement[]
  labours             Labour[]
  transports          Transport[]
  tripUnloadingPoints TripUnloadingPoint[]
}

model Area {
  id               String  @id @default(cuid())
  name             String
  cityId           String

  googlePlaceId    String?
  formattedAddress String?
  latitude         Float?
  longitude        Float?

  city City @relation(fields: [cityId], references: [id])

  @@unique([cityId, name])
  @@unique([googlePlaceId])
}

model State {
  id   String @id @default(cuid())
  name String @unique

  cities City[]

  companies  Company[]
  warehouses Warehouse[]
  customers  Customer[]
  transports Transport[]
  pumps      Pump[]
}

model Transport {
  id      String @id @default(cuid())
  name    String
  stateId String
  cityId  String

  state State @relation(fields: [stateId], references: [id])
  city  City  @relation(fields: [cityId], references: [id])

  country String
  phoneNo String @unique
}

model RailwayFreightMatrix {
  id                String @id @default(cuid())
  wagonType         String
  sourceCityId      String
  destinationCityId String
  freightAmount     BigInt

  sourceCity      City     @relation("SourceCity", fields: [sourceCityId], references: [id])
  destinationCity City     @relation("DestinationCity", fields: [destinationCityId], references: [id])
  wagon           Wagon    @relation(fields: [wagonType], references: [name])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Wagon {
  id                   String                 @id @default(cuid())
  name                 String                 @unique
  height               Float
  width                Float
  weight               Float
  RailwayFreightMatrix RailwayFreightMatrix[]
}

model Pump {
  id      String  @id @default(cuid())
  name    String
  address String?
  cityId  String
  stateId String
  country String

  contactName  String?
  contactPhone String?

  rateLastUpdated   DateTime?
  currentDieselRate Int?

  gstIn       String?
  pan         String?
  creditLimit BigInt?

  accountName    String?
  bankName       String?
  branchIfscCode String?

  isBlackListed Boolean @default(false)

  city      City     @relation("PumpCity", fields: [cityId], references: [id])
  state     State    @relation(fields: [stateId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SpareCategory {
  id         String    @id @default(cuid())
  name       String
  type       SpareType // Enum: Item or Service
  ledgerName String?

  parts SparePart[] @relation("PartCategory")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SparePartSupplier {
  id            String  @id @default(cuid())
  name          String
  type          String // Could be an enum if predefined
  shopName      String?
  address       String?
  cityId        String
  contactPerson String?
  contactPhone  String?
  mobileNo      String?
  email         String?
  panNo         String?
  gstin         String?

  spareparts SparePart[] @relation("PartSupplier")
  city       City        @relation("SparePartySupplierCity", fields: [cityId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SparePart {
  id         String   @id @default(cuid())
  name       String
  type       PartType // Item / Service
  categoryId String
  supplierId String

  rate         BigInt
  minimumStock Int
  unit         String

  isRecyclable   Boolean @default(false)
  isBatchTracked Boolean @default(false)

  description String?

  category SpareCategory     @relation("PartCategory", fields: [categoryId], references: [id])
  supplier SparePartSupplier @relation("PartSupplier", fields: [supplierId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id                    String      @id @default(cuid())
  orderNumber           String      @unique
  customerId            String
  fromBranchId          String
  toBranchId            String
  pickupDate            DateTime
  customerLocationId    String?
  pickupAddressOverride String?
  specialInstructions   String?
  routeId               String?
  orderType             OrderType
  truckQuantity         Int?
  vehicleTypeId         String?
  contactPersonName     String?
  contactMobile         String?
  contactEmail          String?
  bookingFreightAmount  BigInt?
  freightOverrideReason String?
  status                OrderStatus @default(PendingApproval)
  rejectionReason       String?
  cancelReason          String?
  fyCode                String
  createdById           String
  updatedById           String?
  approvedById          String?
  approvedAt            DateTime?
  version               Int         @default(0)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  deletedAt             DateTime?

  customer         Customer          @relation(fields: [customerId], references: [id])
  fromBranch       Branch            @relation("FromBranch", fields: [fromBranchId], references: [id])
  toBranch         Branch            @relation("ToBranch", fields: [toBranchId], references: [id])
  vehicleType      VehicleType?      @relation(fields: [vehicleTypeId], references: [id])
  customerLocation CustomerLocation? @relation(fields: [customerLocationId], references: [id])
  city             City?             @relation(fields: [cityId], references: [id])
  cityId           String?
  createdBy        User              @relation("CreatedOrders", fields: [createdById], references: [id])
  approvedBy       User?             @relation("ApprovedOrders", fields: [approvedById], references: [id])
  updatedBy        User?             @relation("UpdatedOrders", fields: [updatedById], references: [id])
  route            Route?            @relation(fields: [routeId], references: [id])

  items         OrderItem[]
  events        OrderEvent[]
  lorryReceipts LorryReceipt[]

  @@index([status])
  @@index([fromBranchId])
  @@index([customerId])
  @@index([fyCode])
  @@index([routeId])
}

model OrderItem {
  id       String   @id @default(cuid())
  orderId  String
  goodsId  String
  quantity Int
  unit     String
  weight   Decimal?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  goods Goods @relation(fields: [goodsId], references: [id])

  @@index([orderId])
}

model OrderEvent {
  id          String   @id @default(cuid())
  orderId     String
  actorId     String
  eventType   String
  note        String?
  payloadDiff Json?
  createdAt   DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor User  @relation(fields: [actorId], references: [id])

  @@index([orderId])
}

model VehicleType {
  id               String   @id @default(cuid())
  code             String   @unique
  name             String
  freightRangeFrom Int?
  freightRangeTo   Int?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  vehicles     Vehicle[]
  orders       Order[]
  rateMatrices RateMatrix[]
}

model CustomerLocation {
  id           String   @id @default(cuid())
  customerId   String
  name         String
  address      String?
  cityId       String
  contactName  String?
  contactPhone String?
  gstNo        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customer            Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  city                City                 @relation(fields: [cityId], references: [id])
  orders              Order[]
  tripUnloadingPoints TripUnloadingPoint[]

  @@index([customerId])
}

model DocumentSequence {
  id         String   @id @default(cuid())
  branchCode String
  fyCode     String
  docType    String
  nextSeq    Int      @default(1)
  updatedAt  DateTime @updatedAt

  @@unique([branchCode, fyCode, docType])
}

enum LRStatus {
  DRAFT
  FINALISED
  CANCELLED
}

enum LRChargeType {
  BASE_FREIGHT
}

enum LRSource {
  FROM_ORDER
  INSTANT
}

enum LRTransportType {
  Road
  Rail
  RoadAndRail
}

enum LRTripLegType {
  DIRECT
  TO_HUB
  FROM_HUB
}

enum LRPriority {
  Normal
  Express
  Critical
}

model LorryReceipt {
  id       String @id @default(cuid())
  lrNumber String @unique
  fyCode   String

  source  LRSource
  orderId String?
  order   Order?   @relation(fields: [orderId], references: [id])

  originBranchId      String
  destinationBranchId String
  originBranch        Branch @relation("LROrigin", fields: [originBranchId], references: [id])
  destinationBranch   Branch @relation("LRDestination", fields: [destinationBranchId], references: [id])

  isMarketVehicle Boolean @default(false)

  // Own vehicle: attach VehicleTrip(s)
  primaryTripId   String?
  secondaryTripId String?
  primaryTrip     VehicleTrip? @relation("LRPrimaryTrip", fields: [primaryTripId], references: [id])
  secondaryTrip   VehicleTrip? @relation("LRSecondaryTrip", fields: [secondaryTripId], references: [id])

  // Market vehicle: manually entered / searched
  marketVehicleNumber String?
  marketDriverName    String?

  transportType LRTransportType @default(Road)

  // Hub (always Jalgaon/HO): set ONLY by the "split at hub" action on a
  // FINALISED LR. Never picked in a form. tripLegType becomes FROM_HUB then.
  tripLegType LRTripLegType @default(DIRECT)
  hubId       String?
  hub         Branch?       @relation("LRHub", fields: [hubId], references: [id])

  // Railhead: order LRs only, required when transportType = RoadAndRail.
  // A user-picked branch where isRailHead = true. Unrelated to hub.
  railheadBranchId String?
  railheadBranch   Branch? @relation("LRRailhead", fields: [railheadBranchId], references: [id])

  consignorId String
  consigneeId String
  consignor   Customer @relation("LRConsignor", fields: [consignorId], references: [id])
  consignee   Customer @relation("LRConsignee", fields: [consigneeId], references: [id])

  sealNumber String?

  status       LRStatus @default(DRAFT)
  cancelReason String?

  invoiceNumber String?
  invoiceAmount BigInt?
  priority      LRPriority @default(Normal)

  finalisedAt   DateTime?
  finalisedById String?
  finalisedBy   User?     @relation("FinalisedLR", fields: [finalisedById], references: [id])

  createdById String
  updatedById String?
  createdBy   User    @relation("CreatedLR", fields: [createdById], references: [id])
  updatedBy   User?   @relation("UpdatedLR", fields: [updatedById], references: [id])

  version   Int       @default(1)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  goods     LRGoods[]
  charges   LRCharge[]
  ewayBills EwayBill[]

  @@index([status])
  @@index([orderId])
  @@index([originBranchId])
  @@index([destinationBranchId])
  @@index([fyCode])
}

model LRGoods {
  id             String       @id @default(cuid())
  lorryReceiptId String
  lorryReceipt   LorryReceipt @relation(fields: [lorryReceiptId], references: [id])

  name        String
  description String?
  quantity    Int
  unit        String
  weight      Decimal?
  length      Float?
  width       Float?
  height      Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lorryReceiptId])
}

model LRCharge {
  id             String       @id @default(cuid())
  lorryReceiptId String
  lorryReceipt   LorryReceipt @relation(fields: [lorryReceiptId], references: [id])

  chargeType  LRChargeType
  amount      BigInt
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lorryReceiptId])
}

model EwayBill {
  id             String       @id @default(cuid())
  lorryReceiptId String
  lorryReceipt   LorryReceipt @relation(fields: [lorryReceiptId], references: [id])

  ewayBillNo  String
  generatedAt DateTime
  expiresAt   DateTime
  generatedBy String?
  documentUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lorryReceiptId])
}

enum TripStatus {
  Planned
  InTransit
  AtDestination
  Completed
  Closed
  Cancelled
}

enum TripType {
  lr
  dc
}

model VehicleTrip {
  id         String     @id @default(cuid())
  tripNumber String     @unique
  // Auto-generated human-readable label (see buildTripName in trip.service.ts).
  tripName   String
  status     TripStatus @default(Planned)
  tripType   TripType

  vehicleId   String
  driverId    String
  routeId     String
  // Full-load trips carry one client. Required for LR trips, null for DC (rake).
  consignorId String?

  onwardFreight BigInt
  isTripEmpty   Boolean   @default(false)
  rakeDate      DateTime? // set when tripType = dc (rake/rail)

  // Stamped on Start (InTransit) / Close — Close is a later phase.
  startDateTime DateTime?
  openingKm     Int?
  endDateTime   DateTime?
  closingKm     Int?

  cancelReason String?
  fyCode       String

  createdById String
  updatedById String?
  version     Int     @default(1)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  vehicle   Vehicle   @relation(fields: [vehicleId], references: [id])
  driver    Driver    @relation(fields: [driverId], references: [id])
  route     Route     @relation(fields: [routeId], references: [id])
  consignor Customer? @relation(fields: [consignorId], references: [id])
  createdBy User      @relation("CreatedTrips", fields: [createdById], references: [id])
  updatedBy User?     @relation("UpdatedTrips", fields: [updatedById], references: [id])

  primaryLRs         LorryReceipt[]       @relation("LRPrimaryTrip")
  secondaryLRs       LorryReceipt[]       @relation("LRSecondaryTrip")
  TripStatusHistory  TripStatusHistory[]
  TripUnloadingPoint TripUnloadingPoint[]
  rateMatrix         RateMatrix?          @relation(fields: [rateMatrixId], references: [id])
  rateMatrixId       String?

  @@index([status])
}

model TripUnloadingPoint {
  id            String    @id @default(cuid())
  vehicleTripId String
  sequence      Int
  cityId        String
  locationId    String?
  plannedDate   DateTime?
  actualDate    DateTime?

  trip     VehicleTrip       @relation(fields: [vehicleTripId], references: [id], onDelete: Cascade)
  city     City              @relation(fields: [cityId], references: [id])
  location CustomerLocation? @relation(fields: [locationId], references: [id])

  @@index([vehicleTripId])
}

model TripStatusHistory {
  id            String      @id @default(cuid())
  trip          VehicleTrip @relation(fields: [vehicleTripId], references: [id], onDelete: Cascade)
  vehicleTripId String
  status        TripStatus
  changedAt     DateTime    @default(now())
  changedBy     User        @relation(fields: [userId], references: [id])
  note          String?
  userId        String
}
