  @@index([toBranchId])
  @@index([sourceAreaId])
  @@index([destinationAreaId])
  @@index([finalisedById])
  @@index([deletedAt])
  // Serves the list endpoint's branch + status filter, sorted by newest first.
  @@index([fromBranchId, status, createdAt(sort: Desc)])
  // Serves the create-time duplicate-schedule check (same route + date).
  @@index([fromBranchId, toBranchId, sourceAreaId, destinationAreaId, scheduleDate])
}

/// ERP master record for a physical tracker synchronized from OneLap.
/// Live positions and route history remain in OneLap and are not persisted here.
model OneLapTracker {
  id String @id @default(cuid())

  oneLapDeviceId Int    @unique
  uniqueId       String @unique
  name           String

  phone          String?
  providerStatus String?
  vehicleNumber  String?
  validityAt     DateTime?
  attributes     Json?

  isEnabled           Boolean @default(true)
  isPresentOnProvider Boolean @default(true)

  lastProviderUpdateAt DateTime?
  lastSyncedAt         DateTime  @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments OneLapTrackerAssignment[]

  @@index([isEnabled])
  @@index([isPresentOnProvider])
  @@index([providerStatus])
  @@index([lastSyncedAt])
}

/// Assignment history for one tracker tracking one complete VP schedule/rake journey.
/// installedOnMrRrRow identifies the wagon physically carrying the tracker.
model OneLapTrackerAssignment {
  id String @id @default(cuid())

  trackerId String
  tracker   OneLapTracker @relation(fields: [trackerId], references: [id], onDelete: Restrict)

  vpScheduleId String
  vpSchedule   VPSchedule @relation(fields: [vpScheduleId], references: [id], onDelete: Restrict)

  installedOnMrRrRowId String
  installedOnMrRrRow   MRRRRow @relation(fields: [installedOnMrRrRowId], references: [id], onDelete: Restrict)

  assignedAt   DateTime @default(now())
  assignedById String
  assignedBy   User     @relation("AssignedOneLapTrackerAssignments", fields: [assignedById], references: [id], onDelete: Restrict)

  releasedAt     DateTime?
  releasedById   String?
  releasedBy     User?                       @relation("ReleasedOneLapTrackerAssignments", fields: [releasedById], references: [id], onDelete: SetNull)
  releaseReason  OneLapTrackerReleaseReason?
  releaseRemarks String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([trackerId])
  @@index([vpScheduleId])
  @@index([installedOnMrRrRowId])
  @@index([releasedAt])
}

model RailRake {
  id String @id @default(cuid())

  rakeNumber        String  @unique
  railwayRakeNumber String?
  fyCode            String

  vpScheduleId String     @unique
  vpSchedule   VPSchedule @relation("VPScheduleRailRake", fields: [vpScheduleId], references: [id], onDelete: Restrict)

  fromBranchId String
  toBranchId   String
  fromBranch   Branch @relation("RailRakeFromBranch", fields: [fromBranchId], references: [id], onDelete: Restrict)
  toBranch     Branch @relation("RailRakeToBranch", fields: [toBranchId], references: [id], onDelete: Restrict)

  status RailRakeStatus @default(CREATED)

  generatedAt   DateTime @default(now())
  generatedById String
  generatedBy   User     @relation("GeneratedRailRakes", fields: [generatedById], references: [id], onDelete: Restrict)

  expectedArrivalAt DateTime?

  dispatchedAt   DateTime?
  dispatchedById String?
  dispatchedBy   User?     @relation("DispatchedRailRakes", fields: [dispatchedById], references: [id], onDelete: SetNull)

  unloadingStartedAt DateTime?
  receivedAt         DateTime?

  dispatchRemarks String?
  remarks         String?

  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branchGrns RailBranchGRN[]
  operations RailRakeOperation[]

  @@index([fromBranchId, status])
  @@index([toBranchId, status])
  @@index([status])
  @@index([fyCode])
  @@index([railwayRakeNumber])
  @@index([createdAt])
}

model RailRakeOperation {
  id String @id @default(cuid())

  railRakeId String
  railRake   RailRake @relation(fields: [railRakeId], references: [id], onDelete: Restrict)

  stage RailRakeOperationStage

  // The API derives branchId from the stage:
  // ORIGIN_RAILHEAD = RailRake.fromBranchId
  // DESTINATION_BRANCH = RailRake.toBranchId
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  // The API derives areaId from the stage:
  // ORIGIN_RAILHEAD = VPSchedule.sourceAreaId
  // DESTINATION_BRANCH = VPSchedule.destinationAreaId
  areaId String
  area   Area   @relation(fields: [areaId], references: [id], onDelete: Restrict)

  arrivalAt   DateTime?
  departureAt DateTime?

  status  RailRakeOperationStatus @default(DRAFT)
  remarks String?

  createdById String
  createdBy   User   @relation("CreatedRailRakeOperations", fields: [createdById], references: [id], onDelete: Restrict)

  updatedById String?
  updatedBy   User?   @relation("UpdatedRailRakeOperations", fields: [updatedById], references: [id], onDelete: SetNull)

  submittedById String?
  submittedBy   User?     @relation("SubmittedRailRakeOperations", fields: [submittedById], references: [id], onDelete: SetNull)
  submittedAt   DateTime?

  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  placements RailRakePlacement[]
  charges    RailRakeCharge[]

  @@unique([railRakeId, stage])
  @@index([branchId, status])
  @@index([stage, status])
  @@index([createdAt])
}

model RailRakePlacement {
  id String @id @default(cuid())

  operationId String
  operation   RailRakeOperation @relation(fields: [operationId], references: [id], onDelete: Cascade)

  sequence Int

  placedAt  DateTime
  removedAt DateTime?

  // Calculation snapshots. Calculation logic remains in the API.
  actualMinutes     Int?
  freeMinutes       Int?
  chargeableMinutes Int?

  calculationVersion Int     @default(1)
  calculationCode    String?

  remarks String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([operationId, sequence])
  @@index([operationId])
}

model RailRakeCharge {
  id String @id @default(cuid())

  operationId String
  operation   RailRakeOperation @relation(fields: [operationId], references: [id], onDelete: Cascade)

  type   RailRakeChargeType
  status RailRakeChargeStatus @default(DRAFT)

  // Calculation inputs/results stored as snapshots.
  actualMinutes     Int?
  freeMinutes       Int?
  chargeableMinutes Int?

  // Money is stored in paise.
  ratePerHour BigInt?
  grossAmount BigInt  @default(0)

  approvedWaiverAmount BigInt @default(0)
  netPayableAmount     BigInt @default(0)
  paidAmount           BigInt @default(0)
  balanceAmount        BigInt @default(0)

  chargeLetterDate DateTime?
  paymentBy        RailRakeChargeParty?

  // No relation to a rate or calculation-method master.
  calculationVersion Int     @default(1)
  calculationCode    String?

  remarks String?

  createdById String
  createdBy   User   @relation("CreatedRailRakeCharges", fields: [createdById], references: [id], onDelete: Restrict)

  updatedById String?
  updatedBy   User?   @relation("UpdatedRailRakeCharges", fields: [updatedById], references: [id], onDelete: SetNull)

  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  waivers  RailRakeChargeWaiver[]
  payments RailRakeChargePayment[]

  @@unique([operationId, type])
  @@index([operationId])
  @@index([status])
}

model RailRakeChargeWaiver {
  id String @id @default(cuid())

  chargeId String
  charge   RailRakeCharge @relation(fields: [chargeId], references: [id], onDelete: Cascade)

  sequence Int
  status   RailRakeWaiverStatus @default(REQUESTED)

  letterGivenAt    DateTime?
  letterApprovedAt DateTime?
  letterReceivedAt DateTime?

  waiverPercentage Decimal? @db.Decimal(5, 2)
  requestedAmount  BigInt?
  approvedAmount   BigInt?

  referenceNumber String?
  remarks         String?

  createdById String
  createdBy   User   @relation("CreatedRailRakeWaivers", fields: [createdById], references: [id], onDelete: Restrict)

  approvedById String?
  approvedBy   User?   @relation("ApprovedRailRakeWaivers", fields: [approvedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([chargeId, sequence])
  @@index([chargeId, status])
}

model RailRakeChargePayment {
  id String @id @default(cuid())

  chargeId String
  charge   RailRakeCharge @relation(fields: [chargeId], references: [id], onDelete: Restrict)

  kind   RailRakePaymentKind
  status RailRakePaymentStatus @default(PENDING)

  // Money is stored in paise.
  amount BigInt

  paymentBy   RailRakeChargeParty
  paymentMode PaymentMode
  paymentAt   DateTime

  referenceNumber String?
  remarks         String?

  createdById String
  createdBy   User   @relation("CreatedRailRakeChargePayments", fields: [createdById], references: [id], onDelete: Restrict)

  confirmedById String?
  confirmedBy   User?     @relation("ConfirmedRailRakeChargePayments", fields: [confirmedById], references: [id], onDelete: SetNull)
  confirmedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([chargeId, status])
  @@index([paymentAt])
}

model VPScheduleWagonCount {
  id String @id @default(cuid())

  vpScheduleId    String
  wagonId         String
  freightMatrixId String?

  count Int @default(0)

  capacityCft   Float?
  capacityMt    Float?
  totalCft      Float?
  totalMt       Float?
  freightAmount BigInt?
  totalFreight  BigInt?

  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  mrRrRows      MRRRRow[]
  vpSchedule    VPSchedule            @relation(fields: [vpScheduleId], references: [id], onDelete: Cascade)
  wagon         Wagon                 @relation(fields: [wagonId], references: [id])
  freightMatrix RailwayFreightMatrix? @relation(fields: [freightMatrixId], references: [id])

  @@unique([vpScheduleId, wagonId])
  @@index([vpScheduleId])
  @@index([wagonId])
  @@index([freightMatrixId])
}

// ── Cash Planning ─────────────────────────────────────────────────────────
// Global, single-tenant (not company/branch scoped). One CashPlanDay per date.
// Money stored as paise in BigInt (see lib/bigint-json.ts, lib/money.ts).

model Creditor {
  id                 String           @id @default(cuid())
  name               String
  category           CreditorCategory
  defaultMode        PaymentMode?
  branchId           String?
  phone              String?
  // Outstanding amount owed (paise). Ledger view groups by category and
  // auto-totals; approving a linked payment draws this down.
  outstandingBalance BigInt           @default(0)
  isActive           Boolean          @default(true)
  deletedAt          DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  branch   Branch?       @relation("BranchCreditor", fields: [branchId], references: [id])
  payments CashPayment[]
}

model CashAccount {
  id           String          @id @default(cuid())
  name         String
  type         CashAccountType
  bankName     String?
  accountLast4 String?
  isActive     Boolean         @default(true)
  deletedAt    DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  balances       CashAccountBalance[]
  payments       CashPayment[]
  driverAdvances DriverAdvance[]
}

model CashPlanDay {
  id         String        @id @default(cuid())
  date       DateTime      @unique @db.Date
  status     CashDayStatus @default(OPEN)
  closedAt   DateTime?
  closedById String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  balances CashAccountBalance[]
  payments CashPayment[]
}

model CashAccountBalance {
  id             String  @id @default(cuid())
  dayId          String
  accountId      String
  openingBalance BigInt // paise; seeded from prior closing, editable
  carriedOpening BigInt? // paise; what carry-forward proposed (for delta flag)

  day     CashPlanDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  account CashAccount @relation(fields: [accountId], references: [id])

  @@unique([dayId, accountId])
}

model CashPayment {
  id            String           @id @default(cuid())
  dayId         String
  creditorId    String?
  payeeName     String
  amount        BigInt // paise
  category      CreditorCategory
  mode          PaymentMode
  segment       CashSegment? // Road / Rail / FCI business segment tag
  projectCode   String? // e.g. "A-52" site/project bucket
  priority      Int              @default(0) // queue ordering; lower = pay first
  branchId      String?
  fromAccountId String?
  status        PaymentStatus    @default(PENDING)
  isLate        Boolean          @default(false)
  note          String?
  approvedById  String?
  approvedAt    DateTime?
  createdById   String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  day         CashPlanDay  @relation(fields: [dayId], references: [id], onDelete: Cascade)
  creditor    Creditor?    @relation(fields: [creditorId], references: [id])
  fromAccount CashAccount? @relation(fields: [fromAccountId], references: [id])
  branch      Branch?      @relation("BranchCashPayment", fields: [branchId], references: [id])

  @@index([dayId])
  @@index([status])
}

// Global (not day-scoped). One row per party/invoice still owed to us. Carries
// the full outstanding (totalAmount) plus the slice expected by expectedDate
// (expectedAmount) — the day forecast sums the expected slices due by the day.
model CashReceivable {
  id             String                  @id @default(cuid())
  partyName      String
  totalAmount    BigInt // outstanding still to be received from this party (paise)
  expectedAmount BigInt                  @default(0) // next slice expected by expectedDate (paise)
  expectedDate   DateTime?               @db.Date
  receivedAmount BigInt? // cumulative received (paise), null until first receipt
  ackReceived    Boolean                 @default(false) // true once fully settled (outstanding = 0)
  note           String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  receipts       CashReceivableReceipt[]
}

// One recorded receipt against a receivable — the slice history / audit trail
// that powers the receivable's timeline view.
model CashReceivableReceipt {
  id           String         @id @default(cuid())
  receivableId String
  receivable   CashReceivable @relation(fields: [receivableId], references: [id], onDelete: Cascade)
  amount       BigInt // received this slice (paise)
  receivedAt   DateTime       @default(now())
  note         String?
  createdAt    DateTime       @default(now())

  @@index([receivableId])
}

model MRRR {
  id String @id @default(cuid())

  mrRrNumber String? @unique

  vpScheduleId String     @unique
  vpSchedule   VPSchedule @relation(fields: [vpScheduleId], references: [id])

  rakeType RakeType?
  status   MRRRStatus @default(DRAFT)

  remarks String?

  createdById String
  updatedById String?

  createdBy User  @relation("CreatedMRRR", fields: [createdById], references: [id])
  updatedBy User? @relation("UpdatedMRRR", fields: [updatedById], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  version   Int       @default(1)

  rows MRRRRow[]

  @@index([vpScheduleId])
  @@index([status])
  @@index([deletedAt])
  @@index([createdById])
}

model MRRRRow {
  id String @id @default(cuid())

  mrRrId String
  mrRr   MRRR   @relation(fields: [mrRrId], references: [id], onDelete: Cascade)

  vpScheduleWagonCountId String
  vpScheduleWagonCount   VPScheduleWagonCount @relation(fields: [vpScheduleWagonCountId], references: [id])

  wagonId        String
  wagon          Wagon  @relation(fields: [wagonId], references: [id])
  wagonTypeLabel String
  rowNumber      Int
  rowLabel       String

  sequenceNo String?
  vpNo       String?
  mrRrNo     String?
  sealNo     String?

  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  vpWagonLoading       VPWagonLoading?
  trackerInstallations OneLapTrackerAssignment[]

  @@unique([mrRrId, rowNumber])
  @@index([mrRrId])
  @@index([wagonId])
  @@index([vpScheduleWagonCountId])
  @@index([mrRrNo])
  @@index([vpNo])
  @@index([sealNo])
}

model GRN {
  id String @id @default(cuid())

  grnNumber String @unique

  lorryReceiptId String       @unique
  lorryReceipt   LorryReceipt @relation(fields: [lorryReceiptId], references: [id])

  status GRNStatus @default(DRAFT)

  gateNo      String
  labourCount Int

  inDateTime       DateTime?
  outDateTime      DateTime?
  unloadingMinutes Int?

  totalQty    Int @default(0)
  receivedQty Int @default(0)
  damageQty   Int @default(0)
  shortageQty Int @default(0)

  totalWeightMt Decimal?

  totalFreight   BigInt?
  balanceFreight BigInt?
  freightPerMt   BigInt?

  detentionDays   Int     @default(0)
  detentionRate   BigInt?
  detentionAmount BigInt  @default(0)

  grossTotal BigInt @default(0)

  advanceAmount            BigInt @default(0)
  damageAmount             BigInt @default(0)
  tdsAmount                BigInt @default(0)
  hamaliAmount             BigInt @default(0)
  printingStationaryAmount BigInt @default(0)

  netAmount BigInt @default(0)

  labourId     String?
  labour       Labour? @relation("GRNLabour", fields: [labourId], references: [id])
  labourName   String?
  labourCharge BigInt?

  unloadingSupervisorId String?
  unloadingSupervisor   Labour?       @relation("GRNUnloadingSupervisor", fields: [unloadingSupervisorId], references: [id], onDelete: SetNull)
  damagesBy             GRNDamagesBy?

  lrCopyChecked      Boolean @default(false)
  invoiceChecked     Boolean @default(false)
  kataReceiptChecked Boolean @default(false)
  wayBillChecked     Boolean @default(false)
  sealNoChecked      Boolean @default(false)

  lrCopyRemark      String?
  invoiceRemark     String?
  kataReceiptRemark String?
  wayBillRemark     String?
  sealNoRemark      String?

  remarks      String?
  cancelReason String?

  createdById String
  updatedById String?

  createdBy User  @relation("CreatedGRN", fields: [createdById], references: [id])
  updatedBy User? @relation("UpdatedGRN", fields: [updatedById], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  version   Int       @default(1)

  goods      GRNGoods[]
  vpLoadings VPLoading[]

  @@index([status])
  @@index([createdById])
  @@index([deletedAt])
}

model GRNGoods {
  id String @id @default(cuid())

  grnId String
  grn   GRN    @relation(fields: [grnId], references: [id], onDelete: Cascade)

  lrGoodsId String?
  lrGoods   LRGoods? @relation(fields: [lrGoodsId], references: [id])

  goodsName   String
  description String?

  totalQty       Int              @default(0)
  receivedQty    Int              @default(0)
  damageQty      Int              @default(0)
  shortageQty    Int              @default(0)
  vpLoadingGoods VPLoadingGoods[]
  quantityUnitId String?
  weight         Decimal?         @db.Decimal(14, 4)
  weightUnitId   String?
  unit           String?

  remarks String?

  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  quantityUnit UnitOfMeasure? @relation("GRNGoodsQuantityUnit", fields: [quantityUnitId], references: [id], onDelete: Restrict)
  weightUnit   UnitOfMeasure? @relation("GRNGoodsWeightUnit", fields: [weightUnitId], references: [id], onDelete: Restrict)

  @@index([grnId])
  @@index([lrGoodsId])
  @@index([quantityUnitId])
  @@index([weightUnitId])
}

model VPLoading {
  id String @id @default(cuid())

  loadingNumber    String @unique
  vpWagonLoadingId String

  vpWagonLoading VPWagonLoading @relation(fields: [vpWagonLoadingId], references: [id], onDelete: Restrict)

  grnId String
  grn   GRN    @relation(fields: [grnId], references: [id], onDelete: Restrict)

  status VPLoadingStatus @default(DRAFT)

  loadedQty      Int      @default(0)
  loadedCft      Decimal? @db.Decimal(14, 4)
  loadedWeightMt Decimal? @db.Decimal(14, 4)

  remarks       String?
  cancelReason  String?
  cancelledById String?

  cancelledBy User? @relation("CancelledVPLoading", fields: [cancelledById], references: [id])

  cancelledAt DateTime?
  createdById String
  updatedById String?

  createdBy User  @relation("CreatedVPLoading", fields: [createdById], references: [id])
  updatedBy User? @relation("UpdatedVPLoading", fields: [updatedById], references: [id])

  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  version   Int              @default(1)
  goods     VPLoadingGoods[]

  @@unique([vpWagonLoadingId, grnId])
  @@index([vpWagonLoadingId])
  @@index([grnId])
  @@index([status])
}

model VPWagonLoading {
  id String @id @default(cuid())

  mrRrRowId String  @unique
  mrRrRow   MRRRRow @relation(fields: [mrRrRowId], references: [id], onDelete: Restrict)

  status VPWagonLoadingStatus @default(DRAFT)

  gateNo String?

  // Hamal / labour handling the wagon loading
  labourId String?
  labour   Labour? @relation("VPWagonLoadingLabour", fields: [labourId], references: [id])

  labourCharge BigInt?

  wagonCapacityCftSnapshot Decimal? @db.Decimal(14, 4)
  wagonCapacityMtSnapshot  Decimal? @db.Decimal(14, 4)

  capacityCheckStatus CapacityCheckStatus @default(NOT_CHECKED)

  capacityExceededCft Decimal? @db.Decimal(14, 4)
  capacityExceededMt  Decimal? @db.Decimal(14, 4)

  capacityOverrideReason String?
  capacityOverrideById   String?
  capacityOverrideBy     User?     @relation("VPWagonCapacityOverride", fields: [capacityOverrideById], references: [id])
  capacityOverrideAt     DateTime?

  loadingSupervisorId String?
  loadingSupervisor   Labour? @relation("VPWagonLoadingSupervisor", fields: [loadingSupervisorId], references: [id], onDelete: SetNull)

  createdById String
  createdBy   User   @relation("CreatedVPWagonLoading", fields: [createdById], references: [id])

  updatedById String?
  updatedBy   User?   @relation("UpdatedVPWagonLoading", fields: [updatedById], references: [id])

  verifiedById String?
  verifiedBy   User?     @relation("VerifiedVPWagonLoading", fields: [verifiedById], references: [id])
  verifiedAt   DateTime?

  cancelledById      String?
  cancelledBy        User?     @relation("CancelledVPWagonLoading", fields: [cancelledById], references: [id])
  cancelledAt        DateTime?
  cancelReason       String?
  loadingStartedAt   DateTime?
  loadingCompletedAt DateTime?

  totalLoadedQty      Int      @default(0)
  totalLoadedCft      Decimal? @db.Decimal(14, 4)
  totalLoadedWeightMt Decimal? @db.Decimal(14, 4)

  remarks String?

  version Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  allocations VPLoading[]
  branchGrn   RailBranchGRN? @relation("RailBranchGRNWagon")

  @@index([mrRrRowId])
  @@index([labourId])
  @@index([loadingSupervisorId])
  @@index([status])
}

model VPLoadingGoods {
  id String @id @default(cuid())

  vpLoadingId String
  vpLoading   VPLoading @relation(fields: [vpLoadingId], references: [id], onDelete: Cascade)

  grnGoodsId String
  grnGoods   GRNGoods @relation(fields: [grnGoodsId], references: [id], onDelete: Restrict)

  loadedQty        Int @default(0)
  loadingDamageQty Int @default(0)

  unitWeightKgSnapshot Decimal? @db.Decimal(12, 3)
  unitCftSnapshot      Decimal? @db.Decimal(12, 4)

  loadedWeightMt    Decimal?          @db.Decimal(14, 4)
  loadedCft         Decimal?          @db.Decimal(14, 4)
  measurementSource MeasurementSource @default(UNKNOWN)
  remarks           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branchGrnItem RailBranchGRNItem? @relation("RailBranchGRNSourceLine")

  @@unique([vpLoadingId, grnGoodsId])
  @@index([vpLoadingId])
  @@index([grnGoodsId])
}

model RailBranchGRN {
  id String @id @default(cuid())

  railRakeId String
  railRake   RailRake @relation(fields: [railRakeId], references: [id], onDelete: Restrict)

  vpWagonLoadingId String         @unique
  vpWagonLoading   VPWagonLoading @relation("RailBranchGRNWagon", fields: [vpWagonLoadingId], references: [id], onDelete: Restrict)

  status RailBranchGRNStatus @default(DRAFT)

  inDateTime       DateTime?
  outDateTime      DateTime?
  unloadingMinutes Int?

  damagesBy GRNDamagesBy @default(NONE)

  labourCount    Int     @default(0)
  labourLeaderId String?
  labourLeader   Labour? @relation("RailBranchGRNLabourLeader", fields: [labourLeaderId], references: [id], onDelete: SetNull)
  labourCharge   BigInt?

  unloadingSupervisorId String?
  unloadingSupervisor   Labour? @relation("RailBranchGRNUnloadingSupervisor", fields: [unloadingSupervisorId], references: [id], onDelete: SetNull)

  totalLoadedQty   Int @default(0)
  totalReceivedQty Int @default(0)
  totalDamageQty   Int @default(0)
  totalShortageQty Int @default(0)

  remarks String?

  createdById String
  createdBy   User   @relation("CreatedRailBranchGRNs", fields: [createdById], references: [id], onDelete: Restrict)

  updatedById String?
  updatedBy   User?   @relation("UpdatedRailBranchGRNs", fields: [updatedById], references: [id], onDelete: SetNull)

  submittedAt   DateTime?
  submittedById String?
  submittedBy   User?     @relation("SubmittedRailBranchGRNs", fields: [submittedById], references: [id], onDelete: SetNull)

  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items            RailBranchGRNItem[]
  deliveryChallans DeliveryChallan[]

  @@index([railRakeId, status])
  @@index([status])
  @@index([createdAt])
}

model RailBranchGRNItem {
  id String @id @default(cuid())

  railBranchGrnId String
  railBranchGrn   RailBranchGRN @relation(fields: [railBranchGrnId], references: [id], onDelete: Cascade)

  vpLoadingGoodsId String         @unique
  vpLoadingGoods   VPLoadingGoods @relation("RailBranchGRNSourceLine", fields: [vpLoadingGoodsId], references: [id], onDelete: Restrict)

  lrNumberSnapshot      String
  consignorNameSnapshot String?
  consigneeNameSnapshot String?
  goodsNameSnapshot     String
  unitSnapshot          String?

  loadedQty   Int
  receivedQty Int @default(0)
  damageQty   Int @default(0)
  shortageQty Int @default(0)

  remarks String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deliveryChallanItems DeliveryChallanItem[]

  @@index([railBranchGrnId])
}

model DeliveryChallan {
  id            String @id @default(cuid())
  challanNumber String @unique
  fyCode        String

  // A challan belongs to exactly one received VP. Multiple challans are
  // allowed for partial quantities or separate customer destinations.
  branchGrnId String
  branchGrn   RailBranchGRN @relation(fields: [branchGrnId], references: [id], onDelete: Restrict)

  // The source is the branch that received the rake, not the rail journey's
  // original from-branch.
  sourceBranchId String
  sourceBranch   Branch @relation("DeliveryChallanSourceBranch", fields: [sourceBranchId], references: [id], onDelete: Restrict)

  destinationAreaId       String?
  destinationArea         Area?             @relation("DeliveryChallanDestinationArea", fields: [destinationAreaId], references: [id], onDelete: Restrict)
  destinationLocationId   String?
  destinationLocation     CustomerLocation? @relation("DeliveryChallanDestinationLocation", fields: [destinationLocationId], references: [id], onDelete: Restrict)
  deliveryAddressSnapshot String?

  vehicleMode DeliveryVehicleMode

  // MARKET requires a transporter and either a registered vehicle or a manual
  // vehicle-number snapshot. OWN requires a registered vehicle.
  transportId String?
  transport   Transport? @relation(fields: [transportId], references: [id], onDelete: Restrict)
  vehicleId   String?
  vehicle     Vehicle?   @relation(fields: [vehicleId], references: [id], onDelete: Restrict)

  transporterNameSnapshot String?
  vehicleNumberSnapshot   String?
  vehicleTypeSnapshot     String?
  driverName              String?
  driverMobile            String?

  totalQuantity Int      @default(0)
  totalWeight   Decimal? @db.Decimal(14, 4)

  freightAmount BigInt?
  advanceAmount BigInt?
  paymentBy     String?

  loadingAt DateTime

  supervisorId String?
  supervisor   Labour? @relation("DeliveryChallanSupervisor", fields: [supervisorId], references: [id], onDelete: SetNull)

  status  DeliveryChallanStatus @default(DRAFT)
  remarks String?

  createdById String
  createdBy   User   @relation("CreatedDeliveryChallans", fields: [createdById], references: [id], onDelete: Restrict)

  updatedById String?
  updatedBy   User?   @relation("UpdatedDeliveryChallans", fields: [updatedById], references: [id], onDelete: SetNull)

  issuedAt   DateTime?
  issuedById String?
  issuedBy   User?     @relation("IssuedDeliveryChallans", fields: [issuedById], references: [id], onDelete: SetNull)

  cancelledAt   DateTime?
  cancelledById String?
  cancelledBy   User?     @relation("CancelledDeliveryChallans", fields: [cancelledById], references: [id], onDelete: SetNull)
  cancelReason  String?

  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items DeliveryChallanItem[]

  @@index([branchGrnId, status])
  @@index([sourceBranchId, status])
  @@index([destinationAreaId])
  @@index([destinationLocationId])
  @@index([transportId])
  @@index([vehicleId])
  @@index([loadingAt])
  @@index([fyCode])
}

model DeliveryChallanItem {
  id String @id @default(cuid())

  deliveryChallanId String
  deliveryChallan   DeliveryChallan @relation(fields: [deliveryChallanId], references: [id], onDelete: Cascade)

  branchGrnItemId String
  branchGrnItem   RailBranchGRNItem @relation(fields: [branchGrnItemId], references: [id], onDelete: Restrict)

  quantity Int

  // Snapshots keep an issued challan printable even if master/display data
  // changes later.
  lrNumberSnapshot        String
  consigneeNameSnapshot   String?
  goodsNameSnapshot       String
  unitSnapshot            String?
  deliveryAddressSnapshot String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([deliveryChallanId, branchGrnItemId])
  @@index([branchGrnItemId])
}

