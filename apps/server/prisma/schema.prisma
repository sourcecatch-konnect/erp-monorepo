model Goods {
  id                String                  @id @default(cuid())
  name              String
  description       String?
  weight            Float?
  length            Float?
  width             Float?
  height            Float?
  isStackingAllowed Boolean                 @default(false)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  category          GoodsCategory
  storagePosition   GoodsStoragePosition
  storageLayer      GoodsStorageLayer
  consignmentGoods  OrderConsignmentGoods[]
  orderItems        OrderItem[]

  @@index([name])
}

model Labour {
  id                         String               @id @default(cuid())
  name                       String
  photoPath                  String?
  address                    String?
  contactName                String?
  contactPhone               String?
  mobileNo                   String?
  referredBy                 String?
  refContactNo               String?
  startDate                  DateTime?
  pan                        String?
  type                       WorkerType
  branchId                   String
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt
  cityId                     String
  branch                     Branch               @relation("WorkerBranch", fields: [branchId], references: [id])
  city                       City                 @relation(fields: [cityId], references: [id])
  grnLabours                 GRN[]                @relation("GRNLabour")
  supervisedGRNs             GRN[]                @relation("GRNUnloadingSupervisor")
  vpWagonLoadings            VPWagonLoading[]     @relation("VPWagonLoadingLabour")
  supervisedVPWagonLoadings  VPWagonLoading[]     @relation("VPWagonLoadingSupervisor")
  ledRailBranchGRNs          RailBranchGRN[]      @relation("RailBranchGRNLabourLeader")
  supervisedRailBranchGRNs   RailBranchGRN[]      @relation("RailBranchGRNUnloadingSupervisor")
  supervisedDeliveryChallans DeliveryChallan[]    @relation("DeliveryChallanSupervisor")
  jobCardPartLines           JobCardPartLine[]
  jobCardServiceLines        JobCardServiceLine[]
  ledger                     Ledger?

  @@index([name])
  @@index([branchId])
  @@index([cityId])
}

model City {
  id                  String                 @id @default(cuid())
  name                String
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  stateId             String
  agreements          Agreement[]
  areas               Area[]
  branches            Branch[]
  state               State                  @relation(fields: [stateId], references: [id])
  companies           Company[]              @relation("CityCompanies")
  customers           Customer[]
  customerLocations   CustomerLocation[]
  labours             Labour[]
  orders              Order[]
  pumps               Pump[]                 @relation("PumpCity")
  destinationFor      RailwayFreightMatrix[] @relation("DestinationCity")
  sourceFor           RailwayFreightMatrix[] @relation("SourceCity")
  destinationRoute    Route[]                @relation("DestinationRoute")
  sourceRoute         Route[]                @relation("SourceRoute")
  spareSuppliers      SparePartSupplier[]    @relation("SparePartySupplierCity")
  transports          Transport[]
  tripUnloadingPoints TripUnloadingPoint[]
  warehouses          Warehouse[]
  journeyStarts       VehicleJourney[]       @relation("JourneyStartCity")
  journeyReturns      VehicleJourney[]       @relation("JourneyReturnCity")
  journeyCurrent      VehicleJourney[]       @relation("JourneyCurrentCity")
  tripsFrom           VehicleTrip[]          @relation("TripFromCity")
  tripsTo             VehicleTrip[]          @relation("TripToCity")
  tripExpenses        TripExpense[]          @relation("TripExpenseCity")

  @@index([name])
  @@index([stateId])
}

model Area {
  id               String  @id @default(cuid())
  name             String
  cityId           String
  formattedAddress String?
  googlePlaceId    String? @unique
  isRailHead       Boolean @default(false)
  latitude         Float?
  longitude        Float?

  customerLocations CustomerLocation[]
  city              City               @relation(fields: [cityId], references: [id])

  vpSchedulesAsSource      VPSchedule[]        @relation("VPScheduleSourceArea")
  vpSchedulesAsDestination VPSchedule[]        @relation("VPScheduleDestinationArea")
  deliveryChallans         DeliveryChallan[]   @relation("DeliveryChallanDestinationArea")
  railRakeOperations       RailRakeOperation[]

  railwayFreightAsSource        RailwayFreightMatrix[] @relation("RailwayFreightSourceArea")
  railwayFreightAsDestination   RailwayFreightMatrix[] @relation("RailwayFreightDestinationArea")
  managingBranches              BranchRailheadArea[]
  lrGroupsAsSourceRailhead      LRGroup[]              @relation("LRGroupSourceRailheadArea")
  lrGroupsAsDestinationRailhead LRGroup[]              @relation("LRGroupDestinationRailheadArea")

  @@unique([cityId, name])
  @@index([isRailHead])
  @@index([name])
}

model BranchRailheadArea {
  branchId  String
  areaId    String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  area   Area   @relation(fields: [areaId], references: [id], onDelete: Restrict)

  @@id([branchId, areaId])
  @@index([areaId])
  @@index([isActive])
}

model State {
  id                        String      @id @default(cuid())
  name                      String      @unique
  cities                    City[]
  companies                 Company[]
  customers                 Customer[]
  billsAsSupplierState      Bill[]      @relation("BillSupplierState")
  billsAsPlaceOfSupplyState Bill[]      @relation("BillPlaceOfSupplyState")
  pumps                     Pump[]
  transports                Transport[]
  warehouses                Warehouse[]
}

model Transport {
  id               String            @id @default(cuid())
  name             String
  country          String
  phoneNo          String            @unique
  cityId           String
  stateId          String
  city             City              @relation(fields: [cityId], references: [id])
  state            State             @relation(fields: [stateId], references: [id])
  marketLRGroups   LRGroup[]         @relation("LRGroupMarketTransport")
  vehicles         Vehicle[]
  deliveryChallans DeliveryChallan[]
  lrgroups         LRGroup[]
  ledger           Ledger?

  @@index([name])
  @@index([cityId])
  @@index([stateId])
}

model RailwayFreightMatrix {
  id String @id @default(cuid())

  wagonId String

  sourceCityId      String
  destinationCityId String

  sourceAreaId      String?
  destinationAreaId String?

  freightAmount BigInt

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sourceCity      City @relation("SourceCity", fields: [sourceCityId], references: [id])
  destinationCity City @relation("DestinationCity", fields: [destinationCityId], references: [id])

  sourceArea      Area? @relation("RailwayFreightSourceArea", fields: [sourceAreaId], references: [id])
  destinationArea Area? @relation("RailwayFreightDestinationArea", fields: [destinationAreaId], references: [id])

  wagon            Wagon                  @relation(fields: [wagonId], references: [id])
  vpScheduleCounts VPScheduleWagonCount[]

  @@index([wagonId])
  @@index([sourceCityId])
  @@index([destinationCityId])
  @@index([sourceAreaId])
  @@index([destinationAreaId])
}

model Wagon {
  id   String @id @default(cuid())
  name String @unique

  height Float
  width  Float
  weight Float

  totalCft             Float?
  capacityMt           Float?
  isActive             Boolean                @default(true)
  mrRrRows             MRRRRow[]
  RailwayFreightMatrix RailwayFreightMatrix[]
  vpScheduleCounts     VPScheduleWagonCount[]
}

model Pump {
  id                String    @id @default(cuid())
  name              String
  address           String?
  cityId            String
  stateId           String
  country           String
  rateLastUpdated   DateTime?
  currentDieselRate Int?
  pan               String?
  creditLimit       BigInt?
  isBlackListed     Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  city  City  @relation("PumpCity", fields: [cityId], references: [id])
  state State @relation(fields: [stateId], references: [id])

  tripExpenses TripExpense[]
  ledger       Ledger?

  @@index([name])
  @@index([cityId])
  @@index([stateId])
}

model SpareCategory {
  id         String      @id @default(cuid())
  name       String
  type       SpareType
  ledgerName String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  parts      SparePart[] @relation("PartCategory")

  @@index([name])
}

model SparePartSupplier {
  id                     String               @id @default(cuid())
  name                   String
  type                   String
  shopName               String?
  address                String?
  cityId                 String
  contactPerson          String?
  contactPhone           String?
  mobileNo               String?
  email                  String?
  panNo                  String?
  gstin                  String?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  spareparts             SparePart[]          @relation("PartSupplier")
  city                   City                 @relation("SparePartySupplierCity", fields: [cityId], references: [id])
  purchaseOrders         PurchaseOrder[]
  spareInwards           SpareInward[]
  spareBatches           SpareBatch[]
  jobCardServiceLines    JobCardServiceLine[]
  serviceBillsAsProvider ServiceBill[]        @relation("ServiceBillProvider")
  replacementLists       ReplacementList[]
  replacementInwards     ReplacementInward[]
  ledger                 Ledger?

  @@index([name])
  @@index([cityId])
}

model SparePart {
  id                     String                    @id @default(cuid())
  name                   String
  type                   PartType
  categoryId             String
  supplierId             String
  rate                   BigInt
  minimumStock           Int
  unit                   String
  isRecyclable           Boolean                   @default(false)
  isBatchTracked         Boolean                   @default(false)
  description            String?
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
  category               SpareCategory             @relation("PartCategory", fields: [categoryId], references: [id])
  supplier               SparePartSupplier         @relation("PartSupplier", fields: [supplierId], references: [id])
  purchaseOrderLines     PurchaseOrderLine[]
  inwardLines            PurchaseOrderInwardLine[]
  batches                SpareBatch[]
  stockLedgers           StockLedger[]
  stockMovements         StockMovement[]
  jobCardPartLines       JobCardPartLine[]
  jobCardServiceLines    JobCardServiceLine[]
  jobCardRemovedParts    JobCardRemovedPart[]
  replacementListLines   ReplacementListLine[]
  replacementInwardLines ReplacementInwardLine[]

  @@index([name])
  @@index([categoryId])
  @@index([supplierId])
}

/// Commitment to buy spare parts from a supplier. Creating/approving a PO
/// never moves stock — only SpareInward posted against it does.
model PurchaseOrder {
  id             String              @id @default(cuid())
  poNumber       String?             @unique
  fyCode         String
  branchId       String
  supplierId     String
  status         PurchaseOrderStatus @default(DRAFT)
  poDate         DateTime
  expectedDate   DateTime?
  remarks        String?
  estimatedPaise BigInt              @default(0)

  createdById   String
  updatedById   String?
  approvedById  String?
  approvedAt    DateTime?
  cancelledById String?
  cancelledAt   DateTime?
  cancelReason  String?
  version       Int       @default(1)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  branch      Branch            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  supplier    SparePartSupplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdBy   User              @relation("CreatedPurchaseOrders", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy   User?             @relation("UpdatedPurchaseOrders", fields: [updatedById], references: [id], onDelete: SetNull)
  approvedBy  User?             @relation("ApprovedPurchaseOrders", fields: [approvedById], references: [id], onDelete: SetNull)
  cancelledBy User?             @relation("CancelledPurchaseOrders", fields: [cancelledById], references: [id], onDelete: SetNull)

  lines   PurchaseOrderLine[]
  inwards SpareInward[]

  @@index([branchId, status])
  @@index([supplierId, status])
  @@index([fyCode])
}

model PurchaseOrderLine {
  id          String @id @default(cuid())
  poId        String
  sparePartId String
  lineNumber  Int
  qtyOrdered  Int
  qtyReceived Int    @default(0)
  ratePaise   BigInt
  amountPaise BigInt

  po          PurchaseOrder             @relation(fields: [poId], references: [id], onDelete: Cascade)
  sparePart   SparePart                 @relation(fields: [sparePartId], references: [id], onDelete: Restrict)
  inwardLines PurchaseOrderInwardLine[]

  @@unique([poId, lineNumber])
  @@index([sparePartId])
}

enum PurchaseOrderStatus {
  DRAFT
  APPROVED
  SENT
  PARTIALLY_RECEIVED
  RECEIVED
  CLOSED
  CANCELLED
}

/// Goods receipt against a PurchaseOrder. Partial receipt is normal — a PO
/// can have many SpareInward rows until fully received. Posting an inward
/// increases stock (StockMovement + StockLedger) and books the supplier
/// payable (Dr Spare Inventory / Cr Supplier Payable).
model SpareInward {
  id                  String            @id @default(cuid())
  inwardNumber        String?           @unique
  fyCode              String
  branchId            String
  poId                String
  supplierId          String
  status              SpareInwardStatus @default(DRAFT)
  inwardDate          DateTime
  supplierInvoiceNo   String
  supplierInvoiceDate DateTime?
  grossAmountPaise    BigInt            @default(0)
  discountPaise       BigInt            @default(0)
  payableAmountPaise  BigInt            @default(0)
  remarks             String?

  journalEntryId String? @unique

  createdById   String
  postedById    String?
  postedAt      DateTime?
  cancelledById String?
  cancelledAt   DateTime?
  cancelReason  String?
  version       Int       @default(1)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  branch       Branch            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  po           PurchaseOrder     @relation(fields: [poId], references: [id], onDelete: Restrict)
  supplier     SparePartSupplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdBy    User              @relation("CreatedSpareInwards", fields: [createdById], references: [id], onDelete: Restrict)
  postedBy     User?             @relation("PostedSpareInwards", fields: [postedById], references: [id], onDelete: SetNull)
  cancelledBy  User?             @relation("CancelledSpareInwards", fields: [cancelledById], references: [id], onDelete: SetNull)
  journalEntry JournalEntry?     @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)

  lines            PurchaseOrderInwardLine[]
  replacementLists ReplacementList[]

  @@index([branchId, status])
  @@index([poId])
  @@index([supplierId])
  @@index([fyCode])
}

model PurchaseOrderInwardLine {
  id              String    @id @default(cuid())
  inwardId        String
  poLineId        String
  sparePartId     String
  qtyReceived     Int
  qtyRejected     Int       @default(0)
  ratePaise       BigInt
  amountPaise     BigInt
  batchNo         String?
  warrantyExpiry  DateTime?
  guaranteeExpiry DateTime?

  inward               SpareInward           @relation(fields: [inwardId], references: [id], onDelete: Cascade)
  poLine               PurchaseOrderLine     @relation(fields: [poLineId], references: [id], onDelete: Restrict)
  sparePart            SparePart             @relation(fields: [sparePartId], references: [id], onDelete: Restrict)
  batch                SpareBatch?
  replacementListLines ReplacementListLine[]

  @@index([inwardId])
  @@index([poLineId])
  @@index([sparePartId])
}

enum SpareInwardStatus {
  DRAFT
  POSTED
  CANCELLED
}

/// One received lot of a part — the unit "batch/invoice-wise" old ERP tracks
/// warranty/guarantee against. Created 1:1 with a posted inward line.
model SpareBatch {
  id              String    @id @default(cuid())
  sparePartId     String
  supplierId      String
  branchId        String
  inwardLineId    String?   @unique
  batchNo         String?
  qtyReceived     Int
  qtyRemaining    Int
  unitCostPaise   BigInt
  warrantyExpiry  DateTime?
  guaranteeExpiry DateTime?
  createdAt       DateTime  @default(now())

  sparePart                SparePart                @relation(fields: [sparePartId], references: [id], onDelete: Restrict)
  supplier                 SparePartSupplier        @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  branch                   Branch                   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  inwardLine               PurchaseOrderInwardLine? @relation(fields: [inwardLineId], references: [id], onDelete: Restrict)
  jobCardPartLines         JobCardPartLine[]
  removedPartOrigin        JobCardRemovedPart?
  replacementOriginalLines ReplacementListLine[]    @relation("ReplacementOriginalBatch")
  replacementNewLine       ReplacementInwardLine?   @relation("ReplacementNewBatch")

  @@index([sparePartId, branchId])
  @@index([qtyRemaining])
}

/// Denormalised current stock per (part, branch) — always the sum of its
/// StockMovement rows. Moving-average cost recomputed on every INWARD.
model StockLedger {
  id                 String   @id @default(cuid())
  sparePartId        String
  branchId           String
  currentQty         Int      @default(0)
  movingAvgCostPaise BigInt   @default(0)
  updatedAt          DateTime @updatedAt

  sparePart SparePart @relation(fields: [sparePartId], references: [id], onDelete: Restrict)
  branch    Branch    @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@unique([sparePartId, branchId])
}

/// Append-only stock audit trail. `qtyDelta` is signed: + for INWARD/RETURN,
/// − for ISSUE. `balanceQtyAfter` is a point-in-time snapshot for audit —
/// StockLedger.currentQty is the live figure.
model StockMovement {
  id              String            @id @default(cuid())
  sparePartId     String
  branchId        String
  movementType    StockMovementType
  qtyDelta        Int
  unitCostPaise   BigInt
  balanceQtyAfter Int
  refType         String
  refId           String
  createdById     String
  createdAt       DateTime          @default(now())

  sparePart SparePart @relation(fields: [sparePartId], references: [id], onDelete: Restrict)
  branch    Branch    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  createdBy User      @relation("CreatedStockMovements", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([sparePartId, branchId, createdAt])
  @@index([refType, refId])
}

enum StockMovementType {
  INWARD
  ISSUE
  RETURN
  ADJUSTMENT
}

/// A truck's workshop visit. Parts issued at Finalise decrement stock
/// (specific-batch costing, not blended average) and post one expense
/// voucher; external/sublet services are recorded here but billed later by
/// a separate Service Bill (they carry no ledger entry of their own yet).
model JobCard {
  id            String              @id @default(cuid())
  jobCardNumber String?             @unique
  fyCode        String
  branchId      String
  vehicleId     String
  driverId      String
  truckStatus   TruckLocationStatus
  inDateTime    DateTime
  outDateTime   DateTime?
  openingKm     Int
  closingKm     Int?
  status        JobCardStatus       @default(DRAFT)
  remarks       String?

  totalPartsAmountPaise   BigInt @default(0)
  totalServiceAmountPaise BigInt @default(0)
  totalAmountPaise        BigInt @default(0)

  journalEntryId String? @unique

  createdById   String
  finalisedById String?
  finalisedAt   DateTime?
  cancelledById String?
  cancelledAt   DateTime?
  cancelReason  String?
  version       Int       @default(1)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  branch       Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  vehicle      Vehicle       @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  driver       Driver        @relation(fields: [driverId], references: [id], onDelete: Restrict)
  createdBy    User          @relation("CreatedJobCards", fields: [createdById], references: [id], onDelete: Restrict)
  finalisedBy  User?         @relation("FinalisedJobCards", fields: [finalisedById], references: [id], onDelete: SetNull)
  cancelledBy  User?         @relation("CancelledJobCards", fields: [cancelledById], references: [id], onDelete: SetNull)
  journalEntry JournalEntry? @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)

  partLines    JobCardPartLine[]
  serviceLines JobCardServiceLine[]
  removedParts JobCardRemovedPart[]

  @@index([branchId, status])
  @@index([vehicleId])
  @@index([fyCode])
}

model JobCardPartLine {
  id            String  @id @default(cuid())
  jobCardId     String
  sparePartId   String
  batchId       String
  mechanicId    String?
  qty           Int
  unitCostPaise BigInt
  amountPaise   BigInt
  description   String?

  jobCard         JobCard              @relation(fields: [jobCardId], references: [id], onDelete: Cascade)
  sparePart       SparePart            @relation(fields: [sparePartId], references: [id], onDelete: Restrict)
  batch           SpareBatch           @relation(fields: [batchId], references: [id], onDelete: Restrict)
  mechanic        Labour?              @relation(fields: [mechanicId], references: [id], onDelete: SetNull)
  removedPartRefs JobCardRemovedPart[]

  @@index([jobCardId])
  @@index([sparePartId])
  @@index([batchId])
}

/// External / sublet work performed on the job. Carries no ledger entry at
/// Job Card Finalise — a future Service Bill batches unbilled lines from one
/// provider and posts the accrual then (billedInServiceBillId marks it done).
model JobCardServiceLine {
  id                    String  @id @default(cuid())
  jobCardId             String
  serviceProviderId     String
  sparePartId           String
  mechanicId            String?
  qty                   Int
  ratePaise             BigInt
  amountPaise           BigInt
  description           String?
  billedInServiceBillId String?

  jobCard         JobCard           @relation(fields: [jobCardId], references: [id], onDelete: Cascade)
  serviceProvider SparePartSupplier @relation(fields: [serviceProviderId], references: [id], onDelete: Restrict)
  sparePart       SparePart         @relation(fields: [sparePartId], references: [id], onDelete: Restrict)
  mechanic        Labour?           @relation(fields: [mechanicId], references: [id], onDelete: SetNull)
  serviceBillLine ServiceBillLine?

  @@index([jobCardId])
  @@index([serviceProviderId])
  @@index([billedInServiceBillId])
}

enum JobCardStatus {
  DRAFT
  FINALISED
  CANCELLED
}

enum TruckLocationStatus {
  AT_HO
  IN_TRANSIT
}

/// A part taken off a truck during a Job Card — distinct from Supplier
/// Replacement (that's keyed off the original purchase bill, not a truck
/// visit). REUSABLE re-enters stock as a new batch at its original issue
/// cost with a reversing entry; REPAIRABLE/SCRAP are logged only in v1.
model JobCardRemovedPart {
  id                String               @id @default(cuid())
  jobCardId         String
  sparePartId       String
  relatedPartLineId String?
  qty               Int
  condition         RemovedPartCondition
  unitCostPaise     BigInt?
  newBatchId        String?              @unique
  journalEntryId    String?              @unique
  remarks           String?

  createdById String
  createdAt   DateTime @default(now())

  jobCard         JobCard          @relation(fields: [jobCardId], references: [id], onDelete: Cascade)
  sparePart       SparePart        @relation(fields: [sparePartId], references: [id], onDelete: Restrict)
  relatedPartLine JobCardPartLine? @relation(fields: [relatedPartLineId], references: [id], onDelete: SetNull)
  newBatch        SpareBatch?      @relation(fields: [newBatchId], references: [id], onDelete: SetNull)
  journalEntry    JournalEntry?    @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)
  createdBy       User             @relation("CreatedJobCardRemovedParts", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([jobCardId])
  @@index([sparePartId])
}

enum RemovedPartCondition {
  REUSABLE
  REPAIRABLE
  SCRAP
}

/// Bills a provider's completed-but-unbilled JobCardServiceLine rows in one
/// batch. Posts the accrual (Dr Repair Expense / Cr Provider Payable) —
/// Job Card Finalise deliberately does NOT post for service lines, so this
/// is the only place the expense is booked once.
model ServiceBill {
  id                  String            @id @default(cuid())
  serviceBillNumber   String?           @unique
  fyCode              String
  branchId            String
  serviceProviderId   String
  status              ServiceBillStatus @default(DRAFT)
  billDate            DateTime
  providerInvoiceNo   String
  providerInvoiceDate DateTime?
  grossAmountPaise    BigInt            @default(0)
  discountPaise       BigInt            @default(0)
  netAmountPaise      BigInt            @default(0)
  paidAmountPaise     BigInt            @default(0)
  remarks             String?

  journalEntryId String? @unique

  createdById   String
  postedById    String?
  postedAt      DateTime?
  cancelledById String?
  cancelledAt   DateTime?
  cancelReason  String?
  version       Int       @default(1)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  branch          Branch            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  serviceProvider SparePartSupplier @relation("ServiceBillProvider", fields: [serviceProviderId], references: [id], onDelete: Restrict)
  createdBy       User              @relation("CreatedServiceBills", fields: [createdById], references: [id], onDelete: Restrict)
  postedBy        User?             @relation("PostedServiceBills", fields: [postedById], references: [id], onDelete: SetNull)
  cancelledBy     User?             @relation("CancelledServiceBills", fields: [cancelledById], references: [id], onDelete: SetNull)
  journalEntry    JournalEntry?     @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)

  lines    ServiceBillLine[]
  payments ServiceBillPayment[]

  @@index([branchId, status])
  @@index([serviceProviderId, status])
  @@index([fyCode])
}

model ServiceBillLine {
  id                   String @id @default(cuid())
  serviceBillId        String
  jobCardServiceLineId String @unique
  amountPaise          BigInt

  serviceBill        ServiceBill        @relation(fields: [serviceBillId], references: [id], onDelete: Cascade)
  jobCardServiceLine JobCardServiceLine @relation(fields: [jobCardServiceLineId], references: [id], onDelete: Restrict)

  @@index([serviceBillId])
}

enum ServiceBillStatus {
  DRAFT
  POSTED
  CANCELLED
}

/// A defective part sent back to a supplier — keyed off the ORIGINAL
/// purchase inward, not a truck/Job Card (that's JobCardRemovedPart, a
/// different flow). Creating a line moves the part's original batch qty
/// out of stock immediately (it has physically left); ReplacementInward
/// brings the replacement back.
model ReplacementList {
  id                String                @id @default(cuid())
  replacementNumber String?               @unique
  fyCode            String
  branchId          String
  supplierId        String
  originalInwardId  String
  status            ReplacementListStatus @default(PENDING)
  requestDate       DateTime
  remarks           String?

  createdById   String
  cancelledById String?
  cancelledAt   DateTime?
  cancelReason  String?
  version       Int       @default(1)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  branch         Branch            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  supplier       SparePartSupplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  originalInward SpareInward       @relation(fields: [originalInwardId], references: [id], onDelete: Restrict)
  createdBy      User              @relation("CreatedReplacementLists", fields: [createdById], references: [id], onDelete: Restrict)
  cancelledBy    User?             @relation("CancelledReplacementLists", fields: [cancelledById], references: [id], onDelete: SetNull)

  lines              ReplacementListLine[]
  replacementInwards ReplacementInward[]

  @@index([branchId, status])
  @@index([supplierId, status])
  @@index([fyCode])
}

model ReplacementListLine {
  id                   String          @id @default(cuid())
  replacementListId    String
  sparePartId          String
  originalInwardLineId String
  originalBatchId      String
  qtyRequested         Int
  qtyReceived          Int             @default(0)
  replacementType      ReplacementType
  remarks              String?

  replacementList    ReplacementList         @relation(fields: [replacementListId], references: [id], onDelete: Cascade)
  sparePart          SparePart               @relation(fields: [sparePartId], references: [id], onDelete: Restrict)
  originalInwardLine PurchaseOrderInwardLine @relation(fields: [originalInwardLineId], references: [id], onDelete: Restrict)
  originalBatch      SpareBatch              @relation("ReplacementOriginalBatch", fields: [originalBatchId], references: [id], onDelete: Restrict)
  inwardLines        ReplacementInwardLine[]

  @@index([replacementListId])
  @@index([originalInwardLineId])
  @@index([originalBatchId])
}

enum ReplacementListStatus {
  PENDING
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum ReplacementType {
  FREE
  PAYABLE
  CREDIT_NOTE
}

/// The replacement part(s) coming back from the supplier — partial receipt
/// normal. A PAYABLE line posts only the DIFFERENTIAL amount (the original
/// value is already on the books from the first purchase); FREE posts
/// nothing.
model ReplacementInward {
  id                      String            @id @default(cuid())
  replacementInwardNumber String?           @unique
  fyCode                  String
  branchId                String
  replacementListId       String
  supplierId              String
  status                  SpareInwardStatus @default(POSTED)
  inwardDate              DateTime
  supplierChallanNo       String?
  supplierChallanDate     DateTime?
  differentialAmountPaise BigInt            @default(0)
  remarks                 String?

  journalEntryId String? @unique

  createdById   String
  postedById    String?
  postedAt      DateTime?
  cancelledById String?
  cancelledAt   DateTime?
  cancelReason  String?
  version       Int       @default(1)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  branch          Branch            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  replacementList ReplacementList   @relation(fields: [replacementListId], references: [id], onDelete: Restrict)
  supplier        SparePartSupplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdBy       User              @relation("CreatedReplacementInwards", fields: [createdById], references: [id], onDelete: Restrict)
  postedBy        User?             @relation("PostedReplacementInwards", fields: [postedById], references: [id], onDelete: SetNull)
  cancelledBy     User?             @relation("CancelledReplacementInwards", fields: [cancelledById], references: [id], onDelete: SetNull)
  journalEntry    JournalEntry?     @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)

  lines ReplacementInwardLine[]

  @@index([branchId, status])
  @@index([replacementListId])
  @@index([fyCode])
}

model ReplacementInwardLine {
  id                      String    @id @default(cuid())
  replacementInwardId     String
  replacementListLineId   String
  sparePartId             String
  qtyReceived             Int
  differentialRatePaise   BigInt    @default(0)
  differentialAmountPaise BigInt    @default(0)
  batchNo                 String?
  warrantyExpiry          DateTime?
  guaranteeExpiry         DateTime?
  newBatchId              String?   @unique

  replacementInward   ReplacementInward   @relation(fields: [replacementInwardId], references: [id], onDelete: Cascade)
  replacementListLine ReplacementListLine @relation(fields: [replacementListLineId], references: [id], onDelete: Restrict)
  sparePart           SparePart           @relation(fields: [sparePartId], references: [id], onDelete: Restrict)
  newBatch            SpareBatch?         @relation("ReplacementNewBatch", fields: [newBatchId], references: [id], onDelete: SetNull)

  @@index([replacementInwardId])
  @@index([replacementListLineId])
}

/// One disbursement against a POSTED ServiceBill. Partial-pay aware — a bill
/// accumulates payments until ServiceBill.paidAmountPaise == netAmountPaise.
/// Independent of the Vendor Payment 3-stage engine for now (a dedicated,
/// quick path); may later be superseded by a `type = JOBCARD` slip there.
model ServiceBillPayment {
  id              String      @id @default(cuid())
  serviceBillId   String
  paidPaise       BigInt
  tdsPaise        BigInt      @default(0)
  paymentMode     PaymentMode
  paymentDate     DateTime
  referenceNumber String?
  fromAccountId   String
  journalEntryId  String?     @unique
  remarks         String?

  createdById String
  createdAt   DateTime @default(now())

  serviceBill  ServiceBill   @relation(fields: [serviceBillId], references: [id], onDelete: Restrict)
  fromAccount  CashAccount   @relation(fields: [fromAccountId], references: [id], onDelete: Restrict)
  journalEntry JournalEntry? @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)
  createdBy    User          @relation("CreatedServiceBillPayments", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([serviceBillId])
}

model Order {
  id                    String             @id @default(cuid())
  orderNumber           String             @unique
  customerId            String
  fromBranchId          String
  toBranchId            String
  pickupDate            DateTime
  customerLocationId    String?
  pickupAddressOverride String?
  specialInstructions   String?
  orderType             OrderType
  truckQuantity         Int?
  vehicleTypeId         String?
  contactPersonName     String?
  contactMobile         String?
  contactEmail          String?
  bookingFreightAmount  BigInt?
  freightOverrideReason String?
  status                OrderStatus        @default(PendingApproval)
  rejectionReason       String?
  cancelReason          String?
  fyCode                String
  createdById           String
  updatedById           String?
  approvedById          String?
  approvedAt            DateTime?
  version               Int                @default(0)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  deletedAt             DateTime?
  cityId                String?
  routeId               String?
  consigneeId           String?
  lrGroups              LRGroup[]
  approvedBy            User?              @relation("ApprovedOrders", fields: [approvedById], references: [id])
  city                  City?              @relation(fields: [cityId], references: [id])
  consignee             Customer?          @relation("OrderConsignee", fields: [consigneeId], references: [id])
  createdBy             User               @relation("CreatedOrders", fields: [createdById], references: [id])
  customer              Customer           @relation("OrderCustomer", fields: [customerId], references: [id])
  customerLocation      CustomerLocation?  @relation(fields: [customerLocationId], references: [id])
  fromBranch            Branch             @relation("FromBranch", fields: [fromBranchId], references: [id])
  route                 Route?             @relation(fields: [routeId], references: [id])
  toBranch              Branch             @relation("ToBranch", fields: [toBranchId], references: [id])
  updatedBy             User?              @relation("UpdatedOrders", fields: [updatedById], references: [id])
  vehicleType           VehicleType?       @relation(fields: [vehicleTypeId], references: [id])
  consignments          OrderConsignment[]
  events                OrderEvent[]
  items                 OrderItem[]

  @@index([status])
  @@index([fromBranchId])
  @@index([customerId])
  @@index([fyCode])
  @@index([routeId])
}

model OrderItem {
  id       String @id @default(cuid())
  orderId  String
  goodsId  String
  quantity Int

  goods Goods @relation(fields: [goodsId], references: [id])
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model OrderConsignment {
  id                  String                  @id @default(cuid())
  orderId             String
  truckIndex          Int                     @default(1)
  totalWeight         Decimal?                @db.Decimal(14, 4)
  weightUnitId        String?
  unit                String?
  loadingLocationId   String?
  unloadingLocationId String?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  loadingLocation     CustomerLocation?       @relation("ConsignmentLoading", fields: [loadingLocationId], references: [id])
  order               Order                   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  unloadingLocation   CustomerLocation?       @relation("ConsignmentUnloading", fields: [unloadingLocationId], references: [id])
  weightUnit          UnitOfMeasure?          @relation("OrderConsignmentWeightUnit", fields: [weightUnitId], references: [id], onDelete: Restrict)
  goods               OrderConsignmentGoods[]

  @@index([orderId])
  @@index([weightUnitId])
}

model OrderConsignmentGoods {
  id             String           @id @default(cuid())
  consignmentId  String
  goodsId        String
  quantity       Int
  unit           String?
  weight         Decimal?         @db.Decimal(14, 4)
  quantityUnitId String?
  weightUnitId   String?
  consignment    OrderConsignment @relation(fields: [consignmentId], references: [id], onDelete: Cascade)
  goods          Goods            @relation(fields: [goodsId], references: [id])
  quantityUnit   UnitOfMeasure?   @relation("OrderGoodsQuantityUnit", fields: [quantityUnitId], references: [id], onDelete: Restrict)
  weightUnit     UnitOfMeasure?   @relation("OrderGoodsWeightUnit", fields: [weightUnitId], references: [id], onDelete: Restrict)

  @@index([consignmentId])
  @@index([quantityUnitId])
  @@index([weightUnitId])
}

model OrderEvent {
  id          String   @id @default(cuid())
  orderId     String
  actorId     String
  eventType   String
  note        String?
  payloadDiff Json?
  createdAt   DateTime @default(now())
  actor       User     @relation(fields: [actorId], references: [id])
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model VehicleType {
  id               String       @id @default(cuid())
  code             String       @unique
  name             String
  freightRangeFrom Int?
  freightRangeTo   Int?
  isActive         Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  orders           Order[]
  rateMatrices     RateMatrix[]
  vehicles         Vehicle[]

  @@index([name])
}

model CustomerLocation {
  id           String   @id @default(cuid())
  customerId   String
  name         String
  address      String?
  areaId       String?
  cityId       String
  contactName  String?
  contactPhone String?
  gstNo        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customer              Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  city                  City                 @relation(fields: [cityId], references: [id])
  orders                Order[]
  tripUnloadingPoints   TripUnloadingPoint[]
  area                  Area?                @relation(fields: [areaId], references: [id])
  loadingLRs            LorryReceipt[]       @relation("LRLoadingLocation")
  unloadingLRs          LorryReceipt[]       @relation("LRUnloadingLocation")
  consignmentLoadings   OrderConsignment[]   @relation("ConsignmentLoading")
  consignmentUnloadings OrderConsignment[]   @relation("ConsignmentUnloading")
  deliveryChallans      DeliveryChallan[]    @relation("DeliveryChallanDestinationLocation")
  bills                 Bill[]

  @@index([customerId])
  @@index([areaId])
}

model DocumentSequence {
  id         String   @id @default(cuid())
  branchCode String
  fyCode     String
  docType    String
  nextSeq    Int      @default(1)
  updatedAt  DateTime @updatedAt

  @@unique([branchCode, fyCode, docType])
}

model LRGroup {
  id                        String          @id @default(cuid())
  groupNumber               String          @unique
  fyCode                    String
  source                    LRSource
  orderId                   String?
  truckIndex                Int             @default(1)
  originBranchId            String
  destinationBranchId       String
  consignorId               String
  consigneeId               String
  transportType             LRTransportType @default(Road)
  // Freight billing basis, chosen at LR creation, locked once the group leaves
  // DRAFT. TO_BE_BILLED -> GST invoice to a contracted client (Road GTA / Road
  // & Rail). TO_PAY -> non-GST "to pay" freight to a transporter-as-customer
  // (billed under the ROAD bill type), any transport mode.
  paymentMode               LRPaymentMode   @default(TO_BE_BILLED)
  priority                  LRPriority      @default(Normal)
  isMarketVehicle           Boolean         @default(false)
  primaryTripId             String?
  secondaryTripId           String?
  marketVehicleNumber       String?
  marketTransportId         String?
  marketVehicleId           String?
  marketDriverName          String?
  marketFreightAmount       BigInt?
  marketAdvanceAmount       BigInt?
  marketCommissionAmount    BigInt?
  marketHamaliAmount        BigInt?
  marketTdsAmount           BigInt?
  tripLegType               LRTripLegType   @default(DIRECT)
  hubId                     String?
  // Stamped by hold-at-hub. With hubId set and secondaryTripId null the group
  // is "lying at hub" — exempt from the trip-close delivery gate.
  hubArrivalAt              DateTime?
  railheadBranchId          String?
  sourceRailheadAreaId      String?
  destinationRailheadAreaId String?
  baseFreightAmount         BigInt?
  sealNumber                String?
  status                    LRGroupStatus   @default(DRAFT)
  cancelReason              String?
  finalisedAt               DateTime?
  finalisedById             String?
  createdById               String
  updatedById               String?
  version                   Int             @default(1)
  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @updatedAt
  deletedAt                 DateTime?
  marketTransport           Transport?      @relation("LRGroupMarketTransport", fields: [marketTransportId], references: [id], onDelete: Restrict)
  marketVehicle             Vehicle?        @relation("LRGroupMarketVehicle", fields: [marketVehicleId], references: [id], onDelete: Restrict)

  consignee               Customer       @relation("GroupConsignee", fields: [consigneeId], references: [id])
  consignor               Customer       @relation("GroupConsignor", fields: [consignorId], references: [id])
  createdBy               User           @relation("CreatedLRGroup", fields: [createdById], references: [id])
  destinationBranch       Branch         @relation("GroupDestination", fields: [destinationBranchId], references: [id])
  finalisedBy             User?          @relation("FinalisedLRGroup", fields: [finalisedById], references: [id])
  hub                     Branch?        @relation("GroupHub", fields: [hubId], references: [id])
  order                   Order?         @relation(fields: [orderId], references: [id])
  originBranch            Branch         @relation("GroupOrigin", fields: [originBranchId], references: [id])
  primaryTrip             VehicleTrip?   @relation("GroupPrimaryTrip", fields: [primaryTripId], references: [id])
  railheadBranch          Branch?        @relation("GroupRailhead", fields: [railheadBranchId], references: [id])
  sourceRailheadArea      Area?          @relation("LRGroupSourceRailheadArea", fields: [sourceRailheadAreaId], references: [id], onDelete: Restrict)
  destinationRailheadArea Area?          @relation("LRGroupDestinationRailheadArea", fields: [destinationRailheadAreaId], references: [id], onDelete: Restrict)
  secondaryTrip           VehicleTrip?   @relation("GroupSecondaryTrip", fields: [secondaryTripId], references: [id])
  updatedBy               User?          @relation("UpdatedLRGroup", fields: [updatedById], references: [id])
  lorryReceipts           LorryReceipt[]
  transport               Transport?     @relation(fields: [transportId], references: [id])
  transportId             String?

  @@index([status])
  @@index([orderId])
  @@index([originBranchId])
  @@index([destinationBranchId])
  @@index([sourceRailheadAreaId])
  @@index([destinationRailheadAreaId])
  @@index([railheadBranchId])
  @@index([fyCode])
  @@index([marketTransportId])
  @@index([marketVehicleId])
  @@index([paymentMode])
}

model LorryReceipt {
  id                  String          @id @default(cuid())
  cancelReason        String?
  createdById         String
  updatedById         String?
  createdAt           DateTime        @default(now())
  deletedAt           DateTime?
  fyCode              String
  lrNumber            String          @unique
  status              LRStatus        @default(DRAFT)
  billingStatus       LRBillingStatus @default(NOT_BILLABLE)
  updatedAt           DateTime        @updatedAt
  version             Int             @default(1)
  invoiceAmount       BigInt?
  invoiceNumber       String?
  invoiceRemark       String?
  groupId             String
  loadingLocationId   String?
  unloadingLocationId String?
  ewayBill            EwayBill?
  totalWeight         Decimal?        @db.Decimal(14, 4)
  weightUnitId        String?
  unit                String?

  goods           LRGoods[]
  grn             GRN?
  delivery        LRDelivery?
  acknowledgement LRAcknowledgement?

  billableCharges LRCharge[]
  billLines       BillLine[]
  billLinks       BillLorryReceipt[]

  createdBy         User              @relation("CreatedLR", fields: [createdById], references: [id])
  group             LRGroup           @relation(fields: [groupId], references: [id])
  loadingLocation   CustomerLocation? @relation("LRLoadingLocation", fields: [loadingLocationId], references: [id])
  unloadingLocation CustomerLocation? @relation("LRUnloadingLocation", fields: [unloadingLocationId], references: [id])
  updatedBy         User?             @relation("UpdatedLR", fields: [updatedById], references: [id])
  weightUnit        UnitOfMeasure?    @relation("LRWeightUnit", fields: [weightUnitId], references: [id], onDelete: Restrict)

  @@index([status])
  @@index([billingStatus])
  @@index([groupId])
  @@index([fyCode])
  @@index([weightUnitId])
}

model LRGoods {
  id             String                  @id @default(cuid())
  lorryReceiptId String
  name           String
  description    String?
  quantity       Int
  quantityUnitId String?
  weight         Decimal?                @db.Decimal(14, 4)
  weightUnitId   String?
  unit           String?
  length         Float?
  width          Float?
  height         Float?
  grnGoods       GRNGoods[]
  ackItems       LRAcknowledgementItem[]
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  lorryReceipt   LorryReceipt            @relation(fields: [lorryReceiptId], references: [id])
  quantityUnit   UnitOfMeasure?          @relation("LRGoodsQuantityUnit", fields: [quantityUnitId], references: [id], onDelete: Restrict)
  weightUnit     UnitOfMeasure?          @relation("LRGoodsWeightUnit", fields: [weightUnitId], references: [id], onDelete: Restrict)

  @@index([lorryReceiptId])
  @@index([quantityUnitId])
  @@index([weightUnitId])
}

/**
 * Delivery record — goods handed to the consignee. One per LR; creating it
 * flips the LR to DELIVERED, deleting it (undo) reverts to FINALISED. The
 * record is the source of truth, the status is the queryable flag. POD photos
 * attach via the generic Attachment model (entityType "lr-delivery").
 */
model LRDelivery {
  id               String       @id @default(cuid())
  lrId             String       @unique
  deliveredAt      DateTime
  // Truck arrival at the consignee — the deliveredAt-reportedAt gap is the
  // detention basis charged at acknowledgement time.
  reportedAt       DateTime?
  // Goods unloading completion at the consignee. Kept separate from
  // deliveredAt so reporting, unloading and receiver handover remain distinct.
  unloadingAt      DateTime?
  receiverName     String?
  receiverPhone    String?
  unloadingCharges BigInt?
  remark           String?
  createdById      String
  updatedById      String?
  version          Int          @default(1)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  lr               LorryReceipt @relation(fields: [lrId], references: [id])
  createdBy        User         @relation("CreatedLRDelivery", fields: [createdById], references: [id])
  updatedBy        User?        @relation("UpdatedLRDelivery", fields: [updatedById], references: [id])

  @@index([deliveredAt])
  @@index([unloadingAt])
}

/**
 * Acknowledgement — the signed POD paper is back at the booking branch.
 * Creating it flips the LR to ACKNOWLEDGED; undo reverts to DELIVERED.
 * Scans attach via Attachment (entityType "lr-acknowledgement"). Designed as
 * the future billing gate.
 */
model LRAcknowledgement {
  id              String                  @id @default(cuid())
  lrId            String                  @unique
  receivedAt      DateTime
  courierName     String?
  courierDocketNo String?
  courierCharge   BigInt?
  detentionDays   Int?
  detentionAmount BigInt?
  damageAmount    BigInt?
  remark          String?
  createdById     String
  updatedById     String?
  version         Int                     @default(1)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  items           LRAcknowledgementItem[]
  lr              LorryReceipt            @relation(fields: [lrId], references: [id])
  createdBy       User                    @relation("CreatedLRAck", fields: [createdById], references: [id])
  updatedBy       User?                   @relation("UpdatedLRAck", fields: [updatedById], references: [id])

  @@index([receivedAt])
}

model LRAcknowledgementItem {
  id          String            @id @default(cuid())
  ackId       String
  lrGoodsId   String
  receivedQty Decimal?
  damagedQty  Decimal?
  ack         LRAcknowledgement @relation(fields: [ackId], references: [id], onDelete: Cascade)
  goods       LRGoods           @relation(fields: [lrGoodsId], references: [id])

  @@unique([ackId, lrGoodsId])
}

model BillLorryReceipt {
  billId    String
  lrId      String
  createdAt DateTime @default(now())

  bill Bill         @relation(fields: [billId], references: [id], onDelete: Cascade)
  lr   LorryReceipt @relation(fields: [lrId], references: [id], onDelete: Restrict)

  @@id([billId, lrId])
  @@index([lrId])
}

/// A billable amount originating from one LR. Freight, POD detention and
/// approved manual adjustments all enter billing through this auditable row.
/// Money is stored in paise. Billing progress is independent of LR movement.
model LRCharge {
  id                  String         @id @default(cuid())
  lrId                String
  type                LRChargeType
  effect              LRChargeEffect @default(ADDITION)
  source              LRChargeSource
  sourceReferenceId   String?
  description         String?
  amountPaise         BigInt
  approvedAmountPaise BigInt?
  isTaxable           Boolean        @default(true)
  sacCode             String?
  status              LRChargeStatus @default(DRAFT)
  reason              String?

  createdById  String
  updatedById  String?
  approvedById String?
  approvedAt   DateTime?
  version      Int       @default(1)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  lr         LorryReceipt @relation(fields: [lrId], references: [id], onDelete: Restrict)
  createdBy  User         @relation("CreatedLRCharges", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy  User?        @relation("UpdatedLRCharges", fields: [updatedById], references: [id], onDelete: SetNull)
  approvedBy User?        @relation("ApprovedLRCharges", fields: [approvedById], references: [id], onDelete: SetNull)
  billLines  BillLine[]

  @@index([lrId, status])
  @@index([type, status])
  @@index([source, sourceReferenceId])
}

/// Customer invoice generated from one or more LR charges. Party, GSTIN,
/// address, supplier registration and state names are frozen as snapshots so
/// a later master edit cannot rewrite an issued tax invoice.
model Bill {
  id                   String              @id @default(cuid())
  billNumber           String?             @unique
  fyCode               String
  status               BillStatus          @default(DRAFT)
  billType             BillType
  billingPartyType     BillPartyType
  chargeMechanism      BillChargeMechanism @default(NOT_APPLICABLE)
  taxTreatment         BillTaxTreatment
  billDate             DateTime
  billingCutoffDate    DateTime?
  dueDate              DateTime?
  branchId             String
  companyId            String
  serviceCustomerId    String
  billingCustomerId    String
  billingLocationId    String?
  supplierStateId      String
  placeOfSupplyStateId String
  taxRuleId            String?

  billingPartyNameSnapshot  String
  billingGstinSnapshot      String?
  billingAddressSnapshot    String?
  supplierNameSnapshot      String
  supplierGstinSnapshot     String?
  supplierAddressSnapshot   String?
  supplierStateNameSnapshot String
  placeOfSupplyNameSnapshot String

  subtotalAmountPaise    BigInt @default(0)
  taxableAmountPaise     BigInt @default(0)
  taxAmountPaise         BigInt @default(0)
  roundOffPaise          BigInt @default(0)
  totalAmountPaise       BigInt @default(0)
  paidAmountPaise        BigInt @default(0)
  outstandingAmountPaise BigInt @default(0)

  remarks            String?
  cancellationReason String?
  createdById        String
  updatedById        String?
  reviewedById       String?
  reviewedAt         DateTime?
  approvedById       String?
  approvedAt         DateTime?
  finalisedById      String?
  finalisedAt        DateTime?
  cancelledById      String?
  cancelledAt        DateTime?
  version            Int       @default(1)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  branch             Branch              @relation(fields: [branchId], references: [id], onDelete: Restrict)
  company            Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  serviceCustomer    Customer            @relation("BillServiceCustomer", fields: [serviceCustomerId], references: [id], onDelete: Restrict)
  billingCustomer    Customer            @relation("BillBillingCustomer", fields: [billingCustomerId], references: [id], onDelete: Restrict)
  billingLocation    CustomerLocation?   @relation(fields: [billingLocationId], references: [id], onDelete: SetNull)
  supplierState      State               @relation("BillSupplierState", fields: [supplierStateId], references: [id], onDelete: Restrict)
  placeOfSupplyState State               @relation("BillPlaceOfSupplyState", fields: [placeOfSupplyStateId], references: [id], onDelete: Restrict)
  taxRule            BillingTaxRule?     @relation(fields: [taxRuleId], references: [id], onDelete: SetNull)
  createdBy          User                @relation("CreatedBills", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy          User?               @relation("UpdatedBills", fields: [updatedById], references: [id], onDelete: SetNull)
  reviewedBy         User?               @relation("ReviewedBills", fields: [reviewedById], references: [id], onDelete: SetNull)
  approvedBy         User?               @relation("ApprovedBills", fields: [approvedById], references: [id], onDelete: SetNull)
  finalisedBy        User?               @relation("FinalisedBills", fields: [finalisedById], references: [id], onDelete: SetNull)
  cancelledBy        User?               @relation("CancelledBills", fields: [cancelledById], references: [id], onDelete: SetNull)
  lines              BillLine[]
  taxLines           BillTaxLine[]
  statusHistory      BillStatusHistory[]
  lrLinks            BillLorryReceipt[]
  receiptAllocations ReceiptAllocation[]
  cashReceivable     CashReceivable?
  journalEntryId     String?             @unique
  journalEntry       JournalEntry?       @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)
  ledgerAllocations  LedgerAllocation[]
  creditNotes        BillCreditNote[]

  @@index([branchId, status])
  @@index([serviceCustomerId, status])
  @@index([billingCustomerId, status])
  @@index([billDate])
  @@index([fyCode])
  @@index([placeOfSupplyStateId])
}

/// Post-finalisation correction against a FINALISED+ bill. GST makes invoice
/// fields immutable once issued, so a rate/discount/damage correction is
/// made here instead of editing the frozen bill (see CONTEXT.md "Freight is
/// locked on bill"). CREDIT_NOTE reduces what the customer owes; DEBIT_NOTE
/// increases it. Each posts its own JournalEntry rather than reversing the
/// original SALES voucher, so both the original charge and the correction
/// stay visible in the ledger.
model BillCreditNote {
  id          String      @id @default(cuid())
  noteType    VoucherType
  noteNumber  String      @unique
  fyCode      String
  branchId    String
  billId      String
  customerId  String
  amountPaise BigInt
  reason      String
  createdById String
  createdAt   DateTime    @default(now())

  branch         Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  bill           Bill          @relation(fields: [billId], references: [id], onDelete: Restrict)
  customer       Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdBy      User          @relation(fields: [createdById], references: [id], onDelete: Restrict)
  // Nullable: the note row is created first (to get an id for the voucher's
  // sourceId), then the voucher is posted, then this is patched — same
  // two-step order as Bill.journalEntryId / Receipt.journalEntryId.
  journalEntryId String?       @unique
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)

  @@index([billId])
  @@index([customerId])
  @@index([branchId, fyCode])
}

/// Frozen allocation of one LR charge to one bill. A charge may be allocated
/// over several bills, allowing partial billing and separate freight/add-on
/// invoices without creating dummy LR numbers.
model BillLine {
  id                  String         @id @default(cuid())
  billId              String
  lrId                String
  lrChargeId          String
  lineNumber          Int
  chargeTypeSnapshot  LRChargeType
  effectSnapshot      LRChargeEffect
  descriptionSnapshot String?
  sacCodeSnapshot     String?
  quantity            Decimal        @default(1) @db.Decimal(14, 4)
  ratePaise           BigInt
  amountPaise         BigInt
  taxableAmountPaise  BigInt         @default(0)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  bill     Bill         @relation(fields: [billId], references: [id], onDelete: Cascade)
  lr       LorryReceipt @relation(fields: [lrId], references: [id], onDelete: Restrict)
  lrCharge LRCharge     @relation(fields: [lrChargeId], references: [id], onDelete: Restrict)

  @@unique([billId, lineNumber])
  @@unique([billId, lrChargeId])
  @@index([lrId])
  @@index([lrChargeId])
}

/// Frozen GST component for an issued bill. `rateBps` uses basis points:
/// 250 = 2.50%, 500 = 5.00%.
model BillTaxLine {
  id                 String      @id @default(cuid())
  billId             String
  taxType            BillTaxType
  rateBps            Int
  taxableAmountPaise BigInt
  taxAmountPaise     BigInt
  createdAt          DateTime    @default(now())

  bill Bill @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@unique([billId, taxType, rateBps])
  @@index([billId])
}

model BillStatusHistory {
  id          String      @id @default(cuid())
  billId      String
  fromStatus  BillStatus?
  toStatus    BillStatus
  reason      String?
  changedById String
  changedAt   DateTime    @default(now())

  bill      Bill @relation(fields: [billId], references: [id], onDelete: Cascade)
  changedBy User @relation(fields: [changedById], references: [id], onDelete: Restrict)

  @@index([billId, changedAt])
}

/// Customer payment receipt — the "Client Payment Receivable" flow. One
/// Receipt can settle several bills (ReceiptAllocation), and each allocation
/// carries its own TDS/damage/rate-difference deductions rather than a
/// single fixed rate on the receipt.
model Receipt {
  id                    String             @id @default(cuid())
  receiptNumber         String?            @unique
  fyCode                String
  status                ReceiptStatus      @default(DRAFT)
  customerId            String
  branchId              String
  companyId             String
  receivedIntoAccountId String? // required by the app for new receipts; nullable for pre-existing rows
  amountPaise           BigInt
  unallocatedPaise      BigInt             @default(0)
  paymentMode           ReceiptPaymentMode
  referenceNumber       String?
  receivedAt            DateTime
  remarks               String?
  createdById           String
  updatedById           String?
  approvedById          String?
  approvedAt            DateTime?
  cancelledById         String?
  cancelledAt           DateTime?
  cancellationReason    String?
  version               Int                @default(1)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  customer            Customer                @relation(fields: [customerId], references: [id], onDelete: Restrict)
  branch              Branch                  @relation(fields: [branchId], references: [id], onDelete: Restrict)
  company             Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict)
  receivedIntoAccount CashAccount?            @relation(fields: [receivedIntoAccountId], references: [id], onDelete: SetNull)
  createdBy           User                    @relation("CreatedReceipts", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy           User?                   @relation("UpdatedReceipts", fields: [updatedById], references: [id], onDelete: SetNull)
  approvedBy          User?                   @relation("ApprovedReceipts", fields: [approvedById], references: [id], onDelete: SetNull)
  cancelledBy         User?                   @relation("CancelledReceipts", fields: [cancelledById], references: [id], onDelete: SetNull)
  allocations         ReceiptAllocation[]
  statusHistory       ReceiptStatusHistory[]
  accountAdjustments  CashAccountAdjustment[]
  journalEntryId      String?                 @unique
  journalEntry        JournalEntry?           @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)

  @@index([branchId, status])
  @@index([customerId, status])
  @@index([receivedAt])
  @@index([fyCode])
}

/// Frozen allocation of one receipt to one bill — replaces the legacy
/// RefNo$Amount string-packed allocation with a real, queryable row.
model ReceiptAllocation {
  id                  String    @id @default(cuid())
  receiptId           String
  billId              String
  amountAppliedPaise  BigInt
  tdsAmountPaise      BigInt    @default(0)
  tdsSection          String?
  tdsCertNumber       String?
  tdsCertDate         DateTime?
  damageAmountPaise   BigInt    @default(0)
  rateDiffAmountPaise BigInt    @default(0)
  createdAt           DateTime  @default(now())

  receipt Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  bill    Bill    @relation(fields: [billId], references: [id], onDelete: Restrict)

  @@unique([receiptId, billId])
  @@index([billId])
}

model ReceiptStatusHistory {
  id          String         @id @default(cuid())
  receiptId   String
  fromStatus  ReceiptStatus?
  toStatus    ReceiptStatus
  reason      String?
  changedById String
  changedAt   DateTime       @default(now())

  receipt   Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  changedBy User    @relation(fields: [changedById], references: [id], onDelete: Restrict)

  @@index([receiptId, changedAt])
}

/// Effective-dated GST configuration. Bill tax lines remain snapshots; this
/// rule is only the source used by the billing calculation at finalisation.
model BillingTaxRule {
  id              String              @id @default(cuid())
  name            String
  billType        BillType
  chargeMechanism BillChargeMechanism
  sacCode         String
  effectiveFrom   DateTime
  effectiveTo     DateTime?
  cgstRateBps     Int                 @default(0)
  sgstRateBps     Int                 @default(0)
  igstRateBps     Int                 @default(0)
  isActive        Boolean             @default(true)
  createdById     String
  updatedById     String?
  version         Int                 @default(1)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  createdBy User   @relation("CreatedBillingTaxRules", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy User?  @relation("UpdatedBillingTaxRules", fields: [updatedById], references: [id], onDelete: SetNull)
  bills     Bill[]

  @@index([billType, chargeMechanism, effectiveFrom, isActive])
  @@index([effectiveTo])
}

model EwayBill {
  lorryReceiptId String       @unique
  createdAt      DateTime     @default(now())
  documentUrl    String?
  ewayBillNo     String
  expiresAt      DateTime
  generatedAt    DateTime
  generatedBy    String?
  id             String       @id @default(cuid())
  updatedAt      DateTime     @updatedAt
  lorryReceipt   LorryReceipt @relation(fields: [lorryReceiptId], references: [id])

  @@index([lorryReceiptId])
}

model VehicleTrip {
  vehicleId            String
  isTripEmpty          Boolean              @default(false)
  driverId             String
  rateMatrixId         String?
  routeId              String
  status               TripStatus           @default(Planned)
  cancelReason         String?
  onwardFreight        BigInt
  tripType             TripType
  closingKm            Int?
  createdAt            DateTime             @default(now())
  createdById          String
  deletedAt            DateTime?
  endDateTime          DateTime?
  fyCode               String
  id                   String               @id @default(cuid())
  openingKm            Int
  rakeDate             DateTime?
  startDateTime        DateTime?
  // Scheduled/expected dispatch time captured while the trip is still Planned.
  // Never drives status — only `startDateTime` (the actual dispatch) does.
  plannedStartDateTime DateTime?
  // How the trip entered the system: the normal Planned flow, or back-filled
  // as already in transit (truck left before the LR/trip was entered).
  createdAs            TripCreatedAs        @default(PLANNED)
  tripNumber           String               @unique
  updatedAt            DateTime             @updatedAt
  updatedById          String?
  version              Int                  @default(1)
  consignorId          String?
  tripName             String
  // --- Journey leg fields (null for standalone trips created before journeys) ---
  journeyId            String?
  sequenceNo           Int?
  legType              TripLegType?
  fromCityId           String?
  toCityId             String?
  isReturnLeg          Boolean              @default(false)
  arrivalDateTime      DateTime?
  unloadingCompletedAt DateTime?
  closedById           String?
  closeReason          String?
  // Reason recorded when the operator breaks city/KM/time continuity.
  chainExceptionReason String?
  journey              VehicleJourney?      @relation(fields: [journeyId], references: [id])
  fromCity             City?                @relation("TripFromCity", fields: [fromCityId], references: [id])
  toCity               City?                @relation("TripToCity", fields: [toCityId], references: [id])
  expenses             TripExpense[]
  advances             DriverAdvance[]
  primaryGroups        LRGroup[]            @relation("GroupPrimaryTrip")
  secondaryGroups      LRGroup[]            @relation("GroupSecondaryTrip")
  TripStatusHistory    TripStatusHistory[]
  TripUnloadingPoint   TripUnloadingPoint[]
  consignor            Customer?            @relation(fields: [consignorId], references: [id])
  createdBy            User                 @relation("CreatedTrips", fields: [createdById], references: [id])
  driver               Driver               @relation(fields: [driverId], references: [id])
  rateMatrix           RateMatrix?          @relation(fields: [rateMatrixId], references: [id])
  route                Route                @relation(fields: [routeId], references: [id])
  updatedBy            User?                @relation("UpdatedTrips", fields: [updatedById], references: [id])
  vehicle              Vehicle              @relation(fields: [vehicleId], references: [id])

  @@unique([journeyId, sequenceNo])
  @@index([status])
  @@index([journeyId])
}

model TripUnloadingPoint {
  id                String            @id @default(cuid())
  sequence          Int
  vehicleTripId     String
  actualDate        DateTime?
  cityId            String
  locationId        String?
  plannedDate       DateTime?
  actualArrivalAt   DateTime?
  actualUnloadingAt DateTime?
  actualDepartureAt DateTime?
  receivedQty       Int?
  damageQty         Int?
  shortageQty       Int?
  remarks           String?
  city              City              @relation(fields: [cityId], references: [id])
  location          CustomerLocation? @relation(fields: [locationId], references: [id])
  trip              VehicleTrip       @relation(fields: [vehicleTripId], references: [id], onDelete: Cascade)

  @@index([vehicleTripId])
}

model TripStatusHistory {
  id            String      @id @default(cuid())
  vehicleTripId String
  status        TripStatus
  changedAt     DateTime    @default(now())
  note          String?
  userId        String
  changedBy     User        @relation(fields: [userId], references: [id])
  trip          VehicleTrip @relation(fields: [vehicleTripId], references: [id], onDelete: Cascade)
}

model VPSchedule {
  id String @id @default(cuid())

  scheduleNumber String   @unique
  scheduleDate   DateTime
  scheduleName   String

  fromBranchId String
  toBranchId   String

  sourceAreaId      String
  destinationAreaId String

  status VPScheduleStatus @default(DRAFT)

  totalWagonCount  Int    @default(0)
  totalCapacityCft Float? @default(0)
  totalCapacityMt  Float? @default(0)

  remarks String?

  createdById   String
  updatedById   String?
  finalisedById String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  finalisedAt DateTime?
  version     Int       @default(1)
  mrRr        MRRR?
  railRake    RailRake? @relation("VPScheduleRailRake")

  fromBranch Branch @relation("VPScheduleFromBranch", fields: [fromBranchId], references: [id])
  toBranch   Branch @relation("VPScheduleToBranch", fields: [toBranchId], references: [id])

  sourceArea      Area @relation("VPScheduleSourceArea", fields: [sourceAreaId], references: [id])
  destinationArea Area @relation("VPScheduleDestinationArea", fields: [destinationAreaId], references: [id])

  createdBy   User  @relation("CreatedVPSchedules", fields: [createdById], references: [id])
  updatedBy   User? @relation("UpdatedVPSchedules", fields: [updatedById], references: [id])
  finalisedBy User? @relation("FinalisedVPSchedules", fields: [finalisedById], references: [id], onDelete: SetNull)

  wagonCounts        VPScheduleWagonCount[]
  trackerAssignments OneLapTrackerAssignment[]

  @@index([scheduleDate])
  @@index([status])
  @@index([fromBranchId])
  @@index([toBranchId])
  @@index([sourceAreaId])
  @@index([destinationAreaId])
  @@index([finalisedById])
  @@index([deletedAt])
  // Serves the list endpoint's branch + status filter, sorted by newest first.
  @@index([fromBranchId, status, createdAt(sort: Desc)])
  // Serves the create-time duplicate-schedule check (same route + date).
  @@index([fromBranchId, toBranchId, sourceAreaId, destinationAreaId, scheduleDate])
}

/// ERP master record for a physical tracker synchronized from OneLap.
/// Live positions and route history remain in OneLap and are not persisted here.
model OneLapTracker {
  id String @id @default(cuid())

  oneLapDeviceId Int    @unique
  uniqueId       String @unique
  name           String

  phone          String?
  providerStatus String?
  vehicleNumber  String?
  validityAt     DateTime?
  attributes     Json?

  isEnabled           Boolean @default(true)
  isPresentOnProvider Boolean @default(true)

  lastProviderUpdateAt DateTime?
  lastSyncedAt         DateTime  @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments OneLapTrackerAssignment[]

  @@index([isEnabled])
  @@index([isPresentOnProvider])
  @@index([providerStatus])
  @@index([lastSyncedAt])
}

/// Assignment history for one tracker tracking one complete VP schedule/rake journey.
/// installedOnMrRrRow identifies the wagon physically carrying the tracker.
model OneLapTrackerAssignment {
  id String @id @default(cuid())

  trackerId String
  tracker   OneLapTracker @relation(fields: [trackerId], references: [id], onDelete: Restrict)

  vpScheduleId String
  vpSchedule   VPSchedule @relation(fields: [vpScheduleId], references: [id], onDelete: Restrict)

  installedOnMrRrRowId String
  installedOnMrRrRow   MRRRRow @relation(fields: [installedOnMrRrRowId], references: [id], onDelete: Restrict)

  assignedAt   DateTime @default(now())
  assignedById String
  assignedBy   User     @relation("AssignedOneLapTrackerAssignments", fields: [assignedById], references: [id], onDelete: Restrict)

  releasedAt     DateTime?
  releasedById   String?
  releasedBy     User?                       @relation("ReleasedOneLapTrackerAssignments", fields: [releasedById], references: [id], onDelete: SetNull)
  releaseReason  OneLapTrackerReleaseReason?
  releaseRemarks String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([trackerId])
  @@index([vpScheduleId])
  @@index([installedOnMrRrRowId])
  @@index([releasedAt])
}

model RailRake {
  id String @id @default(cuid())

  rakeNumber        String  @unique
  railwayRakeNumber String?
  fyCode            String

  vpScheduleId String     @unique
  vpSchedule   VPSchedule @relation("VPScheduleRailRake", fields: [vpScheduleId], references: [id], onDelete: Restrict)

  fromBranchId String
  toBranchId   String
  fromBranch   Branch @relation("RailRakeFromBranch", fields: [fromBranchId], references: [id], onDelete: Restrict)
  toBranch     Branch @relation("RailRakeToBranch", fields: [toBranchId], references: [id], onDelete: Restrict)

  status RailRakeStatus @default(CREATED)

  generatedAt   DateTime @default(now())
  generatedById String
  generatedBy   User     @relation("GeneratedRailRakes", fields: [generatedById], references: [id], onDelete: Restrict)

  expectedArrivalAt DateTime?

  dispatchedAt   DateTime?
  dispatchedById String?
  dispatchedBy   User?     @relation("DispatchedRailRakes", fields: [dispatchedById], references: [id], onDelete: SetNull)

  unloadingStartedAt DateTime?
  receivedAt         DateTime?

  dispatchRemarks String?
  remarks         String?

  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branchGrns       RailBranchGRN[]
  operations       RailRakeOperation[]
  deliveryChallans DeliveryChallan[]

  @@index([fromBranchId, status])
  @@index([toBranchId, status])
  @@index([status])
  @@index([fyCode])
  @@index([railwayRakeNumber])
  @@index([createdAt])
}

model RailRakeOperation {
  id String @id @default(cuid())

  railRakeId String
  railRake   RailRake @relation(fields: [railRakeId], references: [id], onDelete: Restrict)

  stage RailRakeOperationStage

  // The API derives branchId from the stage:
  // ORIGIN_RAILHEAD = RailRake.fromBranchId
  // DESTINATION_BRANCH = RailRake.toBranchId
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  // The API derives areaId from the stage:
  // ORIGIN_RAILHEAD = VPSchedule.sourceAreaId
  // DESTINATION_BRANCH = VPSchedule.destinationAreaId
  areaId String
  area   Area   @relation(fields: [areaId], references: [id], onDelete: Restrict)

  arrivalAt   DateTime?
  departureAt DateTime?

  status  RailRakeOperationStatus @default(DRAFT)
  remarks String?

  createdById String
  createdBy   User   @relation("CreatedRailRakeOperations", fields: [createdById], references: [id], onDelete: Restrict)

  updatedById String?
  updatedBy   User?   @relation("UpdatedRailRakeOperations", fields: [updatedById], references: [id], onDelete: SetNull)

  submittedById String?
  submittedBy   User?     @relation("SubmittedRailRakeOperations", fields: [submittedById], references: [id], onDelete: SetNull)
  submittedAt   DateTime?

  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  placements RailRakePlacement[]
  charges    RailRakeCharge[]

  @@unique([railRakeId, stage])
  @@index([branchId, status])
  @@index([stage, status])
  @@index([createdAt])
}

model RailRakePlacement {
  id String @id @default(cuid())

  operationId String
  operation   RailRakeOperation @relation(fields: [operationId], references: [id], onDelete: Cascade)

  sequence Int

  placedAt  DateTime
  removedAt DateTime?

  // Calculation snapshots. Calculation logic remains in the API.
  actualMinutes     Int?
  freeMinutes       Int?
  chargeableMinutes Int?

  calculationVersion Int     @default(1)
  calculationCode    String?

  remarks String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([operationId, sequence])
  @@index([operationId])
}

model RailRakeCharge {
  id String @id @default(cuid())

  operationId String
  operation   RailRakeOperation @relation(fields: [operationId], references: [id], onDelete: Cascade)

  type   RailRakeChargeType
  status RailRakeChargeStatus @default(DRAFT)

  // Calculation inputs/results stored as snapshots.
  actualMinutes     Int?
  freeMinutes       Int?
  chargeableMinutes Int?

  // Money is stored in paise.
  ratePerHour BigInt?
  grossAmount BigInt  @default(0)

  approvedWaiverAmount BigInt @default(0)
  netPayableAmount     BigInt @default(0)
  paidAmount           BigInt @default(0)
  balanceAmount        BigInt @default(0)

  chargeLetterDate DateTime?
  paymentBy        RailRakeChargeParty?

  // No relation to a rate or calculation-method master.
  calculationVersion Int     @default(1)
  calculationCode    String?

  remarks String?

  createdById String
  createdBy   User   @relation("CreatedRailRakeCharges", fields: [createdById], references: [id], onDelete: Restrict)

  updatedById String?
  updatedBy   User?   @relation("UpdatedRailRakeCharges", fields: [updatedById], references: [id], onDelete: SetNull)

  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  waivers  RailRakeChargeWaiver[]
  payments RailRakeChargePayment[]

  @@unique([operationId, type])
  @@index([operationId])
  @@index([status])
}

model RailRakeChargeWaiver {
  id String @id @default(cuid())

  chargeId String
  charge   RailRakeCharge @relation(fields: [chargeId], references: [id], onDelete: Cascade)

  sequence Int
  status   RailRakeWaiverStatus @default(REQUESTED)

  letterGivenAt    DateTime?
  letterApprovedAt DateTime?
  letterReceivedAt DateTime?

  waiverPercentage Decimal? @db.Decimal(5, 2)
  requestedAmount  BigInt?
  approvedAmount   BigInt?

  referenceNumber String?
  remarks         String?

  createdById String
  createdBy   User   @relation("CreatedRailRakeWaivers", fields: [createdById], references: [id], onDelete: Restrict)

  approvedById String?
  approvedBy   User?   @relation("ApprovedRailRakeWaivers", fields: [approvedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([chargeId, sequence])
  @@index([chargeId, status])
}

model RailRakeChargePayment {
  id String @id @default(cuid())

  chargeId String
  charge   RailRakeCharge @relation(fields: [chargeId], references: [id], onDelete: Restrict)

  kind   RailRakePaymentKind
  status RailRakePaymentStatus @default(PENDING)

  // Money is stored in paise.
  amount BigInt

  paymentBy   RailRakeChargeParty
  paymentMode PaymentMode
  paymentAt   DateTime

  referenceNumber String?
  remarks         String?

  createdById String
  createdBy   User   @relation("CreatedRailRakeChargePayments", fields: [createdById], references: [id], onDelete: Restrict)

  confirmedById String?
  confirmedBy   User?     @relation("ConfirmedRailRakeChargePayments", fields: [confirmedById], references: [id], onDelete: SetNull)
  confirmedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([chargeId, status])
  @@index([paymentAt])
}

model VPScheduleWagonCount {
  id String @id @default(cuid())

  vpScheduleId    String
  wagonId         String
  freightMatrixId String?

  count Int @default(0)

  capacityCft   Float?
  capacityMt    Float?
  totalCft      Float?
  totalMt       Float?
  freightAmount BigInt?
  totalFreight  BigInt?

  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  mrRrRows      MRRRRow[]
  vpSchedule    VPSchedule            @relation(fields: [vpScheduleId], references: [id], onDelete: Cascade)
  wagon         Wagon                 @relation(fields: [wagonId], references: [id])
  freightMatrix RailwayFreightMatrix? @relation(fields: [freightMatrixId], references: [id])

  @@unique([vpScheduleId, wagonId])
  @@index([vpScheduleId])
  @@index([wagonId])
  @@index([freightMatrixId])
}

// ── Cash Planning ─────────────────────────────────────────────────────────
// Global, single-tenant (not company/branch scoped). One CashPlanDay per date.
// Money stored as paise in BigInt (see lib/bigint-json.ts, lib/money.ts).

model Creditor {
  id                 String           @id @default(cuid())
  name               String
  category           CreditorCategory
  defaultMode        PaymentMode?
  branchId           String?
  phone              String?
  // Outstanding amount owed (paise). Ledger view groups by category and
  // auto-totals; approving a linked payment draws this down.
  outstandingBalance BigInt           @default(0)
  isActive           Boolean          @default(true)
  deletedAt          DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  branch        Branch?       @relation("BranchCreditor", fields: [branchId], references: [id])
  payments      CashPayment[]
  ledgerEntries LedgerEntry[]
  ledger        Ledger?

  @@index([deletedAt, name])
  @@index([branchId])
}

model CashAccount {
  id           String          @id @default(cuid())
  name         String
  type         CashAccountType
  bankName     String?
  accountLast4 String?
  isActive     Boolean         @default(true)
  deletedAt    DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  balances            CashAccountBalance[]
  payments            CashPayment[]
  driverAdvances      DriverAdvance[]
  adjustments         CashAccountAdjustment[]
  receipts            Receipt[]
  ledgerEntries       LedgerEntry[]
  ledger              Ledger?
  serviceBillPayments ServiceBillPayment[]

  @@index([deletedAt, name])
}

model CashPlanDay {
  id         String        @id @default(cuid())
  date       DateTime      @unique @db.Date
  status     CashDayStatus @default(OPEN)
  closedAt   DateTime?
  closedById String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  balances    CashAccountBalance[]
  payments    CashPayment[]
  adjustments CashAccountAdjustment[]
}

/// A credit or correction to a cash account's balance outside the normal
/// payment-approval flow — either a manual top-up/correction someone logs
/// directly, or an automatic credit created when a Receipt posts and the
/// money lands in this account. Signed so a correction can also subtract.
model CashAccountAdjustment {
  id          String   @id @default(cuid())
  dayId       String
  accountId   String
  amountPaise BigInt
  reason      String
  receiptId   String?
  createdById String
  createdAt   DateTime @default(now())

  day       CashPlanDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  account   CashAccount @relation(fields: [accountId], references: [id])
  receipt   Receipt?    @relation(fields: [receiptId], references: [id])
  createdBy User        @relation("CreatedCashAccountAdjustments", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([dayId, accountId])
  @@index([receiptId])
}

enum LedgerDirection {
  IN
  OUT
}

enum LedgerSourceType {
  RECEIPT
  PAYMENT
  ADJUSTMENT
}

/// Append-only record of every money movement, written alongside (never
/// instead of) the CashAccountAdjustment/CashPayment/Receipt rows that
/// already exist — powers the Bank/Cash/Debtor/Creditor/Expense ledger
/// reports as simple filtered reads of this one table. `sourceId` is
/// intentionally not a typed relation: it points at Receipt, CashPayment, or
/// CashAccountAdjustment depending on `sourceType`, and Prisma has no
/// polymorphic FK — the pairing is a contract enforced by the write helper
/// (recordLedgerEntry), not by Postgres. A reversal (payment un-approved/
/// deleted, receipt cancelled) writes a second mirror-direction row sharing
/// the same sourceId rather than deleting the original — don't assume
/// sourceId is unique.
model LedgerEntry {
  id            String            @id @default(cuid())
  occurredAt    DateTime // business date of the event (receivedAt / approvedAt / adjustment createdAt)
  direction     LedgerDirection
  amountPaise   BigInt // always positive; direction carries the sign
  cashAccountId String?
  customerId    String?
  creditorId    String?
  category      CreditorCategory? // snapshot of CashPayment.category at write time; null for RECEIPT/ADJUSTMENT
  sourceType    LedgerSourceType
  sourceId      String
  description   String
  createdById   String
  createdAt     DateTime          @default(now())

  cashAccount CashAccount? @relation(fields: [cashAccountId], references: [id])
  customer    Customer?    @relation(fields: [customerId], references: [id])
  creditor    Creditor?    @relation(fields: [creditorId], references: [id])
  createdBy   User         @relation("CreatedLedgerEntries", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([cashAccountId, occurredAt])
  @@index([customerId, occurredAt])
  @@index([creditorId, occurredAt])
  @@index([sourceType, sourceId])
  @@index([category, occurredAt])
}

/// Chart of accounts. One row per account a JournalLine can hit.
/// kind = PARTY -> exactly one party FK set (customer/transport/creditor/labour/
/// pump), or cashAccountId for a bank/cash ledger that mirrors a CashAccount.
/// kind = GL    -> a named head, looked up by `code`.
model Ledger {
  id       String             @id @default(cuid())
  kind     LedgerKind
  name     String
  group    LedgerAccountGroup
  code     String?            @unique
  isActive Boolean            @default(true)
  branchId String?
  // Opening balances are NOT stored here — they come from a balanced
  // "Opening Balance" JOURNAL voucher so every figure stays auditable.

  customerId          String? @unique
  transportId         String? @unique
  creditorId          String? @unique
  labourId            String? @unique
  pumpId              String? @unique
  cashAccountId       String? @unique
  sparePartSupplierId String? @unique
  driverId            String? @unique

  branch            Branch?            @relation(fields: [branchId], references: [id], onDelete: SetNull)
  customer          Customer?          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  transport         Transport?         @relation(fields: [transportId], references: [id], onDelete: Restrict)
  creditor          Creditor?          @relation(fields: [creditorId], references: [id], onDelete: Restrict)
  labour            Labour?            @relation(fields: [labourId], references: [id], onDelete: Restrict)
  pump              Pump?              @relation(fields: [pumpId], references: [id], onDelete: Restrict)
  cashAccount       CashAccount?       @relation(fields: [cashAccountId], references: [id], onDelete: Restrict)
  sparePartSupplier SparePartSupplier? @relation(fields: [sparePartSupplierId], references: [id], onDelete: Restrict)
  driver            Driver?            @relation(fields: [driverId], references: [id], onDelete: Restrict)
  lines             JournalLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // No unique on (kind, name): two real-world parties can share a name.
  // GL uniqueness is `code`; party uniqueness is the party FK. Display-name
  // clashes are a Chart-of-Accounts / Tally-sync concern, handled there.
  @@index([kind, name])
  @@index([group])
}

/// Voucher header. A voucher is N balanced JournalLine rows sharing this row.
model JournalEntry {
  id            String        @id @default(cuid())
  voucherType   VoucherType
  voucherNumber String
  voucherDate   DateTime
  fyCode        String
  branchId      String
  narration     String?
  // Born DRAFT; the posting service flips it to POSTED only after it has
  // validated total debit == total credit, inside one transaction.
  status        JournalStatus @default(DRAFT)

  sourceType   JournalSourceType
  sourceId     String
  sourceNumber String?

  // At most one contra entry may point at a given original -> a voucher can
  // be reversed at most once (DB-enforced, not just app-level).
  reversesId String? @unique

  // Tally sync is its own state machine, separate from the posting lifecycle.
  tallyMasterId     String?
  tallySyncStatus   TallySyncStatus @default(NOT_SYNCED)
  tallySyncedAt     DateTime?
  tallySyncError    String?
  tallySyncAttempts Int             @default(0)

  createdById String
  postedById  String?
  postedAt    DateTime?
  version     Int       @default(1)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  branch             Branch              @relation(fields: [branchId], references: [id], onDelete: Restrict)
  createdBy          User                @relation("CreatedJournalEntries", fields: [createdById], references: [id], onDelete: Restrict)
  postedBy           User?               @relation("PostedJournalEntries", fields: [postedById], references: [id], onDelete: SetNull)
  reverses           JournalEntry?       @relation("JournalReversal", fields: [reversesId], references: [id], onDelete: SetNull)
  reversedBy         JournalEntry?       @relation("JournalReversal")
  lines              JournalLine[]
  allocations        LedgerAllocation[]
  bill               Bill?
  receipt            Receipt?
  cashPayment        CashPayment?
  spareInward        SpareInward?
  jobCard            JobCard?
  jobCardRemovedPart JobCardRemovedPart?
  serviceBill        ServiceBill?
  replacementInward  ReplacementInward?
  serviceBillPayment ServiceBillPayment?
  billCreditNote     BillCreditNote?
  logSlip            LogSlip?

  @@unique([voucherType, sourceType, sourceId])
  @@unique([voucherType, voucherNumber])
  @@index([branchId, voucherDate])
  @@index([sourceType, sourceId])
  @@index([status])
  @@index([tallySyncStatus])
  @@index([voucherType, fyCode])
}

/// One debit OR one credit line. Exactly one of debitPaise / creditPaise is > 0.
model JournalLine {
  id             String  @id @default(cuid())
  journalEntryId String
  ledgerId       String
  lineNumber     Int
  debitPaise     BigInt  @default(0)
  creditPaise    BigInt  @default(0)
  narration      String?

  journalEntry JournalEntry       @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  ledger       Ledger             @relation(fields: [ledgerId], references: [id], onDelete: Restrict)
  allocations  LedgerAllocation[]

  @@unique([journalEntryId, lineNumber])
  @@index([ledgerId])
}

/// Bill-wise settlement trail. NEW_REF opens an outstanding reference (a sale),
/// AGAINST_REF consumes it (a receipt / credit note).
/// Outstanding(bill) = sum(NEW_REF.amountPaise) - sum(AGAINST_REF.amountPaise).
model LedgerAllocation {
  id             String            @id @default(cuid())
  journalEntryId String
  journalLineId  String
  billId         String
  refType        AllocationRefType
  amountPaise    BigInt
  createdAt      DateTime          @default(now())

  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  journalLine  JournalLine  @relation(fields: [journalLineId], references: [id], onDelete: Cascade)
  bill         Bill         @relation(fields: [billId], references: [id], onDelete: Restrict)

  @@index([billId])
  @@index([journalEntryId])
}

model CashAccountBalance {
  id             String  @id @default(cuid())
  dayId          String
  accountId      String
  openingBalance BigInt // paise; seeded from prior closing, editable
  carriedOpening BigInt? // paise; what carry-forward proposed (for delta flag)

  day     CashPlanDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  account CashAccount @relation(fields: [accountId], references: [id])

  @@unique([dayId, accountId])
}

model CashPayment {
  id            String           @id @default(cuid())
  dayId         String
  creditorId    String?
  payeeName     String
  amount        BigInt // paise
  category      CreditorCategory
  mode          PaymentMode
  segment       CashSegment? // Road / Rail / FCI business segment tag
  projectCode   String? // e.g. "A-52" site/project bucket
  priority      Int              @default(0) // queue ordering; lower = pay first
  branchId      String?
  fromAccountId String?
  status        PaymentStatus    @default(PENDING)
  isLate        Boolean          @default(false)
  note          String?
  approvedById  String?
  approvedAt    DateTime?
  createdById   String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  journalEntryId String? @unique

  day          CashPlanDay   @relation(fields: [dayId], references: [id], onDelete: Cascade)
  creditor     Creditor?     @relation(fields: [creditorId], references: [id])
  fromAccount  CashAccount?  @relation(fields: [fromAccountId], references: [id])
  branch       Branch?       @relation("BranchCashPayment", fields: [branchId], references: [id])
  journalEntry JournalEntry? @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)

  @@index([dayId])
  @@index([status])
}

// Global (not day-scoped). One row per party/invoice still owed to us. Carries
// the full outstanding (totalAmount) plus the slice expected by expectedDate
// (expectedAmount) — the day forecast sums the expected slices due by the day.
model CashReceivable {
  id             String                  @id @default(cuid())
  partyName      String
  source         CashReceivableSource    @default(MANUAL)
  billId         String?                 @unique
  customerId     String?
  totalAmount    BigInt // outstanding still to be received from this party (paise)
  expectedAmount BigInt                  @default(0) // next slice expected by expectedDate (paise)
  expectedDate   DateTime?               @db.Date
  receivedAmount BigInt? // cumulative received (paise), null until first receipt
  ackReceived    Boolean                 @default(false) // true once fully settled (outstanding = 0)
  note           String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  bill           Bill?                   @relation(fields: [billId], references: [id], onDelete: SetNull)
  customer       Customer?               @relation(fields: [customerId], references: [id], onDelete: SetNull)
  receipts       CashReceivableReceipt[]

  @@index([customerId])
}

// One recorded receipt against a receivable — the slice history / audit trail
// that powers the receivable's timeline view.
model CashReceivableReceipt {
  id           String         @id @default(cuid())
  receivableId String
  receivable   CashReceivable @relation(fields: [receivableId], references: [id], onDelete: Cascade)
  amount       BigInt // received this slice (paise)
  receivedAt   DateTime       @default(now())
  note         String?
  createdAt    DateTime       @default(now())

  @@index([receivableId])
}

model MRRR {
  id String @id @default(cuid())

  mrRrNumber String? @unique

  vpScheduleId String     @unique
  vpSchedule   VPSchedule @relation(fields: [vpScheduleId], references: [id])

  rakeType RakeType?
  status   MRRRStatus @default(DRAFT)

  remarks String?

  createdById String
  updatedById String?

  createdBy User  @relation("CreatedMRRR", fields: [createdById], references: [id])
  updatedBy User? @relation("UpdatedMRRR", fields: [updatedById], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  version   Int       @default(1)

  rows MRRRRow[]

  @@index([vpScheduleId])
  @@index([status])
  @@index([deletedAt])
  @@index([createdById])
}

model MRRRRow {
  id String @id @default(cuid())

  mrRrId String
  mrRr   MRRR   @relation(fields: [mrRrId], references: [id], onDelete: Cascade)

  vpScheduleWagonCountId String
  vpScheduleWagonCount   VPScheduleWagonCount @relation(fields: [vpScheduleWagonCountId], references: [id])

  wagonId        String
  wagon          Wagon  @relation(fields: [wagonId], references: [id])
  wagonTypeLabel String
  rowNumber      Int
  rowLabel       String

  sequenceNo String?
  vpNo       String?
  mrRrNo     String?
  sealNo     String?

  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  vpWagonLoading       VPWagonLoading?
  trackerInstallations OneLapTrackerAssignment[]

  @@unique([mrRrId, rowNumber])
  @@index([mrRrId])
  @@index([wagonId])
  @@index([vpScheduleWagonCountId])
  @@index([mrRrNo])
  @@index([vpNo])
  @@index([sealNo])
}

model GRN {
  id String @id @default(cuid())

  grnNumber String @unique

  lorryReceiptId String       @unique
  lorryReceipt   LorryReceipt @relation(fields: [lorryReceiptId], references: [id])

  status GRNStatus @default(DRAFT)

  gateNo      String
  labourCount Int

  inDateTime       DateTime?
  outDateTime      DateTime?
  unloadingMinutes Int?

  totalQty    Int @default(0)
  receivedQty Int @default(0)
  damageQty   Int @default(0)
  shortageQty Int @default(0)

  totalWeightMt Decimal?

  totalFreight   BigInt?
  balanceFreight BigInt?
  freightPerMt   BigInt?

  detentionDays   Int     @default(0)
  detentionRate   BigInt?
  detentionAmount BigInt  @default(0)

  grossTotal BigInt @default(0)

  advanceAmount            BigInt @default(0)
  damageAmount             BigInt @default(0)
  tdsAmount                BigInt @default(0)
  hamaliAmount             BigInt @default(0)
  printingStationaryAmount BigInt @default(0)

  netAmount BigInt @default(0)

  labourId     String?
  labour       Labour? @relation("GRNLabour", fields: [labourId], references: [id])
  labourName   String?
  labourCharge BigInt?

  unloadingSupervisorId String?
  unloadingSupervisor   Labour?       @relation("GRNUnloadingSupervisor", fields: [unloadingSupervisorId], references: [id], onDelete: SetNull)
  damagesBy             GRNDamagesBy?

  lrCopyChecked      Boolean @default(false)
  invoiceChecked     Boolean @default(false)
  kataReceiptChecked Boolean @default(false)
  wayBillChecked     Boolean @default(false)
  sealNoChecked      Boolean @default(false)

  lrCopyRemark      String?
  invoiceRemark     String?
  kataReceiptRemark String?
  wayBillRemark     String?
  sealNoRemark      String?

  remarks      String?
  cancelReason String?

  createdById String
  updatedById String?

  createdBy User  @relation("CreatedGRN", fields: [createdById], references: [id])
  updatedBy User? @relation("UpdatedGRN", fields: [updatedById], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  version   Int       @default(1)

  goods      GRNGoods[]
  vpLoadings VPLoading[]

  @@index([status])
  @@index([createdById])
  @@index([deletedAt])
}

model GRNGoods {
  id String @id @default(cuid())

  grnId String
  grn   GRN    @relation(fields: [grnId], references: [id], onDelete: Cascade)

  lrGoodsId String?
  lrGoods   LRGoods? @relation(fields: [lrGoodsId], references: [id])

  goodsName   String
  description String?

  totalQty       Int              @default(0)
  receivedQty    Int              @default(0)
  damageQty      Int              @default(0)
  shortageQty    Int              @default(0)
  vpLoadingGoods VPLoadingGoods[]
  quantityUnitId String?
  weight         Decimal?         @db.Decimal(14, 4)
  weightUnitId   String?
  unit           String?

  remarks String?

  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  quantityUnit UnitOfMeasure? @relation("GRNGoodsQuantityUnit", fields: [quantityUnitId], references: [id], onDelete: Restrict)
  weightUnit   UnitOfMeasure? @relation("GRNGoodsWeightUnit", fields: [weightUnitId], references: [id], onDelete: Restrict)

  @@index([grnId])
  @@index([lrGoodsId])
  @@index([quantityUnitId])
  @@index([weightUnitId])
}

model VPLoading {
  id String @id @default(cuid())

  loadingNumber    String @unique
  vpWagonLoadingId String

  vpWagonLoading VPWagonLoading @relation(fields: [vpWagonLoadingId], references: [id], onDelete: Restrict)

  grnId String
  grn   GRN    @relation(fields: [grnId], references: [id], onDelete: Restrict)

  status VPLoadingStatus @default(DRAFT)

  loadedQty      Int      @default(0)
  loadedCft      Decimal? @db.Decimal(14, 4)
  loadedWeightMt Decimal? @db.Decimal(14, 4)

  remarks       String?
  cancelReason  String?
  cancelledById String?

  cancelledBy User? @relation("CancelledVPLoading", fields: [cancelledById], references: [id])

  cancelledAt DateTime?
  createdById String
  updatedById String?

  createdBy User  @relation("CreatedVPLoading", fields: [createdById], references: [id])
  updatedBy User? @relation("UpdatedVPLoading", fields: [updatedById], references: [id])

  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  version   Int              @default(1)
  goods     VPLoadingGoods[]

  @@unique([vpWagonLoadingId, grnId])
  @@index([vpWagonLoadingId])
  @@index([grnId])
  @@index([status])
}

model VPWagonLoading {
  id String @id @default(cuid())

  mrRrRowId String  @unique
  mrRrRow   MRRRRow @relation(fields: [mrRrRowId], references: [id], onDelete: Restrict)

  status VPWagonLoadingStatus @default(DRAFT)

  gateNo String?

  // Hamal / labour handling the wagon loading
  labourId String?
  labour   Labour? @relation("VPWagonLoadingLabour", fields: [labourId], references: [id])

  labourCharge BigInt?

  wagonCapacityCftSnapshot Decimal? @db.Decimal(14, 4)
  wagonCapacityMtSnapshot  Decimal? @db.Decimal(14, 4)

  capacityCheckStatus CapacityCheckStatus @default(NOT_CHECKED)

  capacityExceededCft Decimal? @db.Decimal(14, 4)
  capacityExceededMt  Decimal? @db.Decimal(14, 4)

  capacityOverrideReason String?
  capacityOverrideById   String?
  capacityOverrideBy     User?     @relation("VPWagonCapacityOverride", fields: [capacityOverrideById], references: [id])
  capacityOverrideAt     DateTime?

  loadingSupervisorId String?
  loadingSupervisor   Labour? @relation("VPWagonLoadingSupervisor", fields: [loadingSupervisorId], references: [id], onDelete: SetNull)

  createdById String
  createdBy   User   @relation("CreatedVPWagonLoading", fields: [createdById], references: [id])

  updatedById String?
  updatedBy   User?   @relation("UpdatedVPWagonLoading", fields: [updatedById], references: [id])

  verifiedById String?
  verifiedBy   User?     @relation("VerifiedVPWagonLoading", fields: [verifiedById], references: [id])
