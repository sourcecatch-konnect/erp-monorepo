/**
 * Vehicle journey / log slip (docs/TRIP_JOURNEY_LOGSLIP_PLAN.md)
 */
/**
 * ------------------------------------------------------------------
 */

/// Full own-vehicle truck cycle: sequential trip legs starting from a base
/// city and normally closing when the vehicle returns to `returnCityId`.
/// Settled by exactly one LogSlip. Return base is configured per journey -
/// never hardcoded.
model VehicleJourney {
  id               String                  @id @default(cuid())
  journeyNumber    String                  @unique
  fyCode           String
  vehicleId        String
  driverId         String
  homeBranchId     String
  startCityId      String
  returnCityId     String
  currentCityId    String
  openingKm        Int
  closingKm        Int?
  startedAt        DateTime
  closedAt         DateTime?
  status           VehicleJourneyStatus    @default(ACTIVE)
  settlementStatus JourneySettlementStatus @default(NOT_READY)
  // Reason recorded when the journey is closed away from the return city.
  closeReason      String?
  cancelReason     String?
  remarks          String?
  createdById      String
  updatedById      String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  deletedAt        DateTime?
  version          Int                     @default(1)

  vehicle     Vehicle @relation(fields: [vehicleId], references: [id])
  driver      Driver  @relation(fields: [driverId], references: [id])
  homeBranch  Branch  @relation("JourneyHomeBranch", fields: [homeBranchId], references: [id])
  startCity   City    @relation("JourneyStartCity", fields: [startCityId], references: [id])
  returnCity  City    @relation("JourneyReturnCity", fields: [returnCityId], references: [id])
  currentCity City    @relation("JourneyCurrentCity", fields: [currentCityId], references: [id])
  createdBy   User    @relation("CreatedJourneys", fields: [createdById], references: [id])
  updatedBy   User?   @relation("UpdatedJourneys", fields: [updatedById], references: [id])

  trips    VehicleTrip[]
  expenses TripExpense[]
  advances DriverAdvance[]
  logSlip  LogSlip?

  @@index([vehicleId, status])
  @@index([driverId, status])
  @@index([fyCode])
  @@index([homeBranchId])
  @@index([settlementStatus])
  @@index([status])
}

model TripExpense {
  id              String            @id @default(cuid())
  journeyId       String
  tripId          String?
  expenseTypeId   String
  amountPaise     BigInt
  paymentMode     TripPaymentMode
  cityId          String?
  pumpId          String?
  dieselQty       Float?
  dieselRatePaise BigInt?
  expenseDate     DateTime
  receiptNo       String?
  paidByDriver    Boolean           @default(true)
  remarks         String?
  status          TripExpenseStatus @default(DRAFT)
  approvedById    String?
  approvedAt      DateTime?
  rejectReason    String?
  reversedById    String?
  reversedAt      DateTime?
  reverseReason   String?
  journalEntryId  String?
  createdById     String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  deletedAt       DateTime?

  journey     VehicleJourney  @relation(fields: [journeyId], references: [id])
  trip        VehicleTrip?    @relation(fields: [tripId], references: [id])
  expenseType TripExpenseType @relation(fields: [expenseTypeId], references: [id])
  city        City?           @relation("TripExpenseCity", fields: [cityId], references: [id])
  pump        Pump?           @relation(fields: [pumpId], references: [id])
  createdBy   User            @relation("CreatedTripExpenses", fields: [createdById], references: [id])

  @@index([journeyId])
  @@index([tripId])
  @@index([expenseTypeId])
  @@index([status])
}

/// Configurable journey expense category. System categories seed the standard
/// ERP behaviour; users can add further categories without a code deployment.
model TripExpenseType {
  id                    String   @id @default(cuid())
  code                  String   @unique
  name                  String   @unique
  requiresDieselDetails Boolean  @default(false)
  isSystem              Boolean  @default(false)
  isActive              Boolean  @default(true)
  sortOrder             Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  expenses TripExpense[]

  @@index([isActive, sortOrder])
}

/// Cash/bank/card advance handed to the driver for a journey. Settled against
/// the driver's cash expenses when the log slip is generated.
model DriverAdvance {
  id             String              @id @default(cuid())
  journeyId      String
  tripId         String?
  driverId       String
  vehicleId      String
  amountPaise    BigInt
  paymentMode    TripPaymentMode
  cashAccountId  String?
  paidAt         DateTime
  narration      String?
  status         DriverAdvanceStatus @default(POSTED)
  reversedById   String?
  reversedAt     DateTime?
  reverseReason  String?
  // Set by the accounts posting service (Phase 6) — null until posted.
  journalEntryId String?
  createdById    String
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  journey     VehicleJourney @relation(fields: [journeyId], references: [id])
  trip        VehicleTrip?   @relation(fields: [tripId], references: [id])
  driver      Driver         @relation(fields: [driverId], references: [id])
  vehicle     Vehicle        @relation(fields: [vehicleId], references: [id])
  cashAccount CashAccount?   @relation(fields: [cashAccountId], references: [id])
  createdBy   User           @relation("CreatedDriverAdvances", fields: [createdById], references: [id])

  @@index([journeyId])
  @@index([driverId])
  @@index([status])
}

/// Final settlement document for a VehicleJourney. Totals are frozen at
/// generation time (snapshot lines in LogSlipLine) so the print stays
/// historically stable even if trip/expense rows change later.
model LogSlip {
  id                      String        @id @default(cuid())
  journeyId               String        @unique
  logSlipNumber           String?       @unique
  fyCode                  String
  logSlipDate             DateTime
  status                  LogSlipStatus @default(DRAFT)
  vehicleId               String
  driverId                String
  openingKm               Int
  closingKm               Int
  totalKm                 Int
  totalDays               Int
  totalFreightPaise       BigInt        @default(0)
  totalAdvancePaise       BigInt        @default(0)
  totalDieselQty          Float         @default(0)
  totalDieselAmountPaise  BigInt        @default(0)
  totalCashExpensePaise   BigInt        @default(0)
  totalCreditExpensePaise BigInt        @default(0)
  totalExpensePaise       BigInt        @default(0)
  netVehicleResultPaise   BigInt        @default(0)
  driverCashExpensePaise  BigInt        @default(0)
  driverReceivablePaise   BigInt        @default(0)
  driverPayablePaise      BigInt        @default(0)
  // Diesel accounting: fuel left in tank from the previous journey plus this
  // journey's fills, compared against expected consumption at the standard
  // average, yields the short/excess diesel figure.
  previousDieselQty       Float         @default(0)
  dieselRatePaise         BigInt?
  standardAverage         Float?
  actualAverage           Float?
  expectedDieselQty       Float?
  shortDieselQty          Float?
  remarks                 String?
  generatedById           String?
  generatedAt             DateTime?
  postedJournalEntryId    String?
  postedById              String?
  postedAt                DateTime?
  reopenedById            String?
  reopenedAt              DateTime?
  reopenReason            String?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
  version                 Int           @default(1)

  journey     VehicleJourney @relation(fields: [journeyId], references: [id])
  vehicle     Vehicle        @relation(fields: [vehicleId], references: [id])
  driver      Driver         @relation(fields: [driverId], references: [id])
  generatedBy User?          @relation("GeneratedLogSlips", fields: [generatedById], references: [id])
  lines       LogSlipLine[]

  @@index([status])
  @@index([fyCode])
}

/// Snapshot line frozen at log slip generation. `sourceType`/`sourceId` point
/// back at the origin row (VehicleTrip / DriverAdvance / TripExpense) so
/// accounts can audit, and reopen can diff old vs new.
model LogSlipLine {
  id          String          @id @default(cuid())
  logSlipId   String
  lineType    LogSlipLineType
  sourceType  String?
  sourceId    String?
  description String
  quantity    Float?
  ratePaise   BigInt?
  amountPaise BigInt
  sortOrder   Int             @default(0)
  metadata    Json?

  logSlip LogSlip @relation(fields: [logSlipId], references: [id], onDelete: Cascade)

  @@index([logSlipId])
}

model UnitOfMeasure {
  id        String       @id @default(cuid())
  code      String       @unique
  name      String
  category  UnitCategory
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  orderConsignmentWeightUnits OrderConsignment[]      @relation("OrderConsignmentWeightUnit")
  orderGoodsQuantityUnits     OrderConsignmentGoods[] @relation("OrderGoodsQuantityUnit")
  orderGoodsWeightUnits       OrderConsignmentGoods[] @relation("OrderGoodsWeightUnit")
  lrWeightUnits               LorryReceipt[]          @relation("LRWeightUnit")
  lrGoodsQuantityUnits        LRGoods[]               @relation("LRGoodsQuantityUnit")
  lrGoodsWeightUnits          LRGoods[]               @relation("LRGoodsWeightUnit")
  grnGoodsQuantityUnits       GRNGoods[]              @relation("GRNGoodsQuantityUnit")
  grnGoodsWeightUnits         GRNGoods[]              @relation("GRNGoodsWeightUnit")

  @@index([category])
  @@index([isActive])
  @@index([name])
}

