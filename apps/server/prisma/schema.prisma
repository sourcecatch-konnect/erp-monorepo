generator client {
  provider        = "prisma-client-js"
  output          = "../generated/prisma"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
}

/// Polymorphic file attachment. Referenced by any host entity via
/// (entityType, entityId). Bytes live in S3; this row holds metadata only.
model Attachment {
  id              String          @id @default(cuid())
  entityType      String
  entityId        String
  branchId        String?
  s3Key           String          @unique
  originalName    String
  mime            String
  sizeBytes       Int
  uploaded        Boolean         @default(false)
  antivirusStatus AntivirusStatus @default(PENDING)
  scanError       String?
  uploadedBy      String
  uploadedAt      DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?
  uploader        User            @relation(fields: [uploadedBy], references: [id])

  @@index([entityType, entityId])
  @@index([antivirusStatus])
  @@index([branchId])
}

model User {
  id                          String      @id @default(uuid())
  userName                    String      @unique
  firstName                   String
  middleName                  String?
  lastName                    String
  email                       String      @unique
  companyId                   String
  branchId                    String
  roleId                      String
  createdAt                   DateTime    @default(now())
  updatedAt                   DateTime    @updatedAt
  password                    String?
  status                      Boolean
  branchScope                 BranchScope @default(ASSIGNED)
  mobile                      String?
  whatsappOptIn               Boolean     @default(false)
  emailOptIn                  Boolean     @default(true)
  notificationQuietHoursStart String?
  notificationQuietHoursEnd   String?

  attachments               Attachment[]
  auditLogs                 AuditLog[]
  inAppNotifications        InAppNotification[]
  notificationDeliveries    NotificationDelivery[]
  notificationSubscriptions UserNotificationSubscription[]
  userPermissions           UserPermission[]
  userBranches              UserBranch[]

  branch  Branch  @relation(fields: [branchId], references: [id])
  company Company @relation(fields: [companyId], references: [id])
  role    Role    @relation(fields: [roleId], references: [id])

  createdLRGroups   LRGroup[] @relation("CreatedLRGroup")
  finalisedLRGroups LRGroup[] @relation("FinalisedLRGroup")
  updatedLRGroups   LRGroup[] @relation("UpdatedLRGroup")

  createdLR LorryReceipt[] @relation("CreatedLR")
  updatedLR LorryReceipt[] @relation("UpdatedLR")

  createdLRDeliveries LRDelivery[]        @relation("CreatedLRDelivery")
  updatedLRDeliveries LRDelivery[]        @relation("UpdatedLRDelivery")
  createdLRAcks       LRAcknowledgement[] @relation("CreatedLRAck")
  updatedLRAcks       LRAcknowledgement[] @relation("UpdatedLRAck")

  approvedOrders Order[]      @relation("ApprovedOrders")
  createdOrders  Order[]      @relation("CreatedOrders")
  updatedOrders  Order[]      @relation("UpdatedOrders")
  orderEvents    OrderEvent[]

  TripStatusHistory TripStatusHistory[]

  createdTrips VehicleTrip[] @relation("CreatedTrips")
  updatedTrips VehicleTrip[] @relation("UpdatedTrips")

  createdVPSchedules   VPSchedule[] @relation("CreatedVPSchedules")
  updatedVPSchedules   VPSchedule[] @relation("UpdatedVPSchedules")
  finalisedVPSchedules VPSchedule[] @relation("FinalisedVPSchedules")

  generatedRailRakes  RailRake[] @relation("GeneratedRailRakes")
  dispatchedRailRakes RailRake[] @relation("DispatchedRailRakes")

  createdMRRRs MRRR[] @relation("CreatedMRRR")
  updatedMRRRs MRRR[] @relation("UpdatedMRRR")

  createdGRNs GRN[] @relation("CreatedGRN")
  updatedGRNs GRN[] @relation("UpdatedGRN")

  createdVPLoadings   VPLoading[] @relation("CreatedVPLoading")
  updatedVPLoadings   VPLoading[] @relation("UpdatedVPLoading")
  cancelledVPLoadings VPLoading[] @relation("CancelledVPLoading")

  createdVPWagonLoadings          VPWagonLoading[] @relation("CreatedVPWagonLoading")
  updatedVPWagonLoadings          VPWagonLoading[] @relation("UpdatedVPWagonLoading")
  verifiedVPWagonLoadings         VPWagonLoading[] @relation("VerifiedVPWagonLoading")
  cancelledVPWagonLoadings        VPWagonLoading[] @relation("CancelledVPWagonLoading")
  capacityOverrideVPWagonLoadings VPWagonLoading[] @relation("VPWagonCapacityOverride")

  createdRailBranchGRNs   RailBranchGRN[] @relation("CreatedRailBranchGRNs")
  updatedRailBranchGRNs   RailBranchGRN[] @relation("UpdatedRailBranchGRNs")
  submittedRailBranchGRNs RailBranchGRN[] @relation("SubmittedRailBranchGRNs")

  createdDeliveryChallans   DeliveryChallan[] @relation("CreatedDeliveryChallans")
  updatedDeliveryChallans   DeliveryChallan[] @relation("UpdatedDeliveryChallans")
  issuedDeliveryChallans    DeliveryChallan[] @relation("IssuedDeliveryChallans")
  cancelledDeliveryChallans DeliveryChallan[] @relation("CancelledDeliveryChallans")

  createdRailRakeOperations   RailRakeOperation[]     @relation("CreatedRailRakeOperations")
  updatedRailRakeOperations   RailRakeOperation[]     @relation("UpdatedRailRakeOperations")
  submittedRailRakeOperations RailRakeOperation[]     @relation("SubmittedRailRakeOperations")
  createdRailRakeCharges      RailRakeCharge[]        @relation("CreatedRailRakeCharges")
  updatedRailRakeCharges      RailRakeCharge[]        @relation("UpdatedRailRakeCharges")
  createdRailRakeWaivers      RailRakeChargeWaiver[]  @relation("CreatedRailRakeWaivers")
  approvedRailRakeWaivers     RailRakeChargeWaiver[]  @relation("ApprovedRailRakeWaivers")
  createdRailRakePayments     RailRakeChargePayment[] @relation("CreatedRailRakeChargePayments")
  confirmedRailRakePayments   RailRakeChargePayment[] @relation("ConfirmedRailRakeChargePayments")

  assignedOneLapTrackerAssignments OneLapTrackerAssignment[] @relation("AssignedOneLapTrackerAssignments")
  releasedOneLapTrackerAssignments OneLapTrackerAssignment[] @relation("ReleasedOneLapTrackerAssignments")

  createdJourneys VehicleJourney[] @relation("CreatedJourneys")
  updatedJourneys VehicleJourney[] @relation("UpdatedJourneys")

  createdTripExpenses   TripExpense[]   @relation("CreatedTripExpenses")
  createdDriverAdvances DriverAdvance[] @relation("CreatedDriverAdvances")
  generatedLogSlips     LogSlip[]       @relation("GeneratedLogSlips")

  createdLRCharges  LRCharge[] @relation("CreatedLRCharges")
  updatedLRCharges  LRCharge[] @relation("UpdatedLRCharges")
  approvedLRCharges LRCharge[] @relation("ApprovedLRCharges")

  createdBills      Bill[]              @relation("CreatedBills")
  billCreditNotes   BillCreditNote[]
  updatedBills      Bill[]              @relation("UpdatedBills")
  reviewedBills     Bill[]              @relation("ReviewedBills")
  approvedBills     Bill[]              @relation("ApprovedBills")
  finalisedBills    Bill[]              @relation("FinalisedBills")
  cancelledBills    Bill[]              @relation("CancelledBills")
  billStatusChanges BillStatusHistory[]

  createdPurchaseOrders   PurchaseOrder[] @relation("CreatedPurchaseOrders")
  updatedPurchaseOrders   PurchaseOrder[] @relation("UpdatedPurchaseOrders")
  approvedPurchaseOrders  PurchaseOrder[] @relation("ApprovedPurchaseOrders")
  cancelledPurchaseOrders PurchaseOrder[] @relation("CancelledPurchaseOrders")

  createdSpareInwards   SpareInward[]   @relation("CreatedSpareInwards")
  postedSpareInwards    SpareInward[]   @relation("PostedSpareInwards")
  cancelledSpareInwards SpareInward[]   @relation("CancelledSpareInwards")
  createdStockMovements StockMovement[] @relation("CreatedStockMovements")

  createdJobCards            JobCard[]            @relation("CreatedJobCards")
  finalisedJobCards          JobCard[]            @relation("FinalisedJobCards")
  cancelledJobCards          JobCard[]            @relation("CancelledJobCards")
  createdJobCardRemovedParts JobCardRemovedPart[] @relation("CreatedJobCardRemovedParts")

  createdServiceBills        ServiceBill[]        @relation("CreatedServiceBills")
  postedServiceBills         ServiceBill[]        @relation("PostedServiceBills")
  cancelledServiceBills      ServiceBill[]        @relation("CancelledServiceBills")
  createdServiceBillPayments ServiceBillPayment[] @relation("CreatedServiceBillPayments")

  createdReplacementLists     ReplacementList[]   @relation("CreatedReplacementLists")
  cancelledReplacementLists   ReplacementList[]   @relation("CancelledReplacementLists")
  createdReplacementInwards   ReplacementInward[] @relation("CreatedReplacementInwards")
  postedReplacementInwards    ReplacementInward[] @relation("PostedReplacementInwards")
  cancelledReplacementInwards ReplacementInward[] @relation("CancelledReplacementInwards")

  createdBillingTaxRules BillingTaxRule[] @relation("CreatedBillingTaxRules")
  updatedBillingTaxRules BillingTaxRule[] @relation("UpdatedBillingTaxRules")

  createdReceipts               Receipt[]               @relation("CreatedReceipts")
  updatedReceipts               Receipt[]               @relation("UpdatedReceipts")
  approvedReceipts              Receipt[]               @relation("ApprovedReceipts")
  cancelledReceipts             Receipt[]               @relation("CancelledReceipts")
  receiptStatusChanges          ReceiptStatusHistory[]
  createdCashAccountAdjustments CashAccountAdjustment[] @relation("CreatedCashAccountAdjustments")
  createdLedgerEntries          LedgerEntry[]           @relation("CreatedLedgerEntries")
  createdJournalEntries         JournalEntry[]          @relation("CreatedJournalEntries")
  postedJournalEntries          JournalEntry[]          @relation("PostedJournalEntries")

  tablePrefs UserTablePref[]

  passwordResetTokens PasswordResetToken[]
}

/// Single-use, time-limited tokens for the "forgot password" flow. Only the
/// SHA-256 hash of the token is stored; the raw token lives only in the email
/// link. A row is spent by setting `usedAt`.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Per-user UI table layout (column order + visibility), keyed per table.
model UserTablePref {
  id        String   @id @default(cuid())
  userId    String
  tableKey  String
  prefs     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tableKey])
}

model Company {
  id                String      @id @default(cuid())
  name              String      @unique
  address           String?
  country           String
  contactPhone      String?
  establishmentYear DateTime
  companyPAN        String?
  companyTAN        String?
  mainLogoPath      String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  cityId            String?
  stateId           String?
  agreements        Agreement[]
  branches          Branch[]
  city              City?       @relation("CityCompanies", fields: [cityId], references: [id])
  state             State?      @relation(fields: [stateId], references: [id])
  users             User[]
  bills             Bill[]
  receipts          Receipt[]

  @@index([cityId])
  @@index([stateId])
}

model Branch {
  id           String  @id @default(cuid())
  branchCode   String  @unique
  name         String
  cityId       String?
  address      String?
  contactName  String?
  contactPhone String?
  email        String?
  weeklyOffDay String?
  gstNo        String?
  workingHours String?

  allowLR      Boolean @default(false)
  isRailHead   Boolean @default(false)
  allowReceipt Boolean @default(true)
  // Marks the HO / hub branch (Jalgaon). Hub on an LR is derived from this,
  // never picked. Exactly one branch should have this set.
  isHeadOffice Boolean @default(false)

  companyId   String
  warehouseId String?

  company    Company     @relation(fields: [companyId], references: [id])
  warehouses Warehouse[] @relation("BranchWarehouses")
  agreements Agreement[] @relation("BranchAgreement")
  workers    Labour[]    @relation("WorkerBranch")

  homeJourneys VehicleJourney[] @relation("JourneyHomeBranch")

  users              User[]
  userBranches       UserBranch[]
  city               City?                @relation(fields: [cityId], references: [id])
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  fromOrders         Order[]              @relation("FromBranch")
  toOrders           Order[]              @relation("ToBranch")
  originGroups       LRGroup[]            @relation("GroupOrigin")
  destinationGroups  LRGroup[]            @relation("GroupDestination")
  hubGroups          LRGroup[]            @relation("GroupHub")
  railheadGroups     LRGroup[]            @relation("GroupRailhead")
  vpSchedulesFrom    VPSchedule[]         @relation("VPScheduleFromBranch")
  vpSchedulesTo      VPSchedule[]         @relation("VPScheduleToBranch")
  railRakesFrom      RailRake[]           @relation("RailRakeFromBranch")
  railRakesTo        RailRake[]           @relation("RailRakeToBranch")
  railRakeOperations RailRakeOperation[]
  deliveryChallans   DeliveryChallan[]    @relation("DeliveryChallanSourceBranch")
  managedRailheads   BranchRailheadArea[]
  creditors          Creditor[]           @relation("BranchCreditor")
  cashPayments       CashPayment[]        @relation("BranchCashPayment")
  bills              Bill[]
  billCreditNotes    BillCreditNote[]
  receipts           Receipt[]
  ledgers            Ledger[]
  journalEntries     JournalEntry[]
  purchaseOrders     PurchaseOrder[]
  spareInwards       SpareInward[]
  spareBatches       SpareBatch[]
  stockLedgers       StockLedger[]
  stockMovements     StockMovement[]
  jobCards           JobCard[]
  serviceBills       ServiceBill[]
  replacementLists   ReplacementList[]
  replacementInwards ReplacementInward[]

  @@index([name])
  @@index([cityId])
  @@index([companyId])
  @@index([warehouseId])
}

model Warehouse {
  id              String    @id @default(cuid())
  name            String
  type            String
  address         String?
  country         String
  branchId        String
  contactName     String?
  contactPhone    String?
  monthlyRent     BigInt?
  securityDeposit BigInt?
  agreementDate   DateTime?
  expiryDate      DateTime?
  length          Float?
  width           Float?
  breadth         Float?
  gateNo          String?
  storageCapacity Float?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  cityId          String
  stateId         String
  branch          Branch    @relation("BranchWarehouses", fields: [branchId], references: [id])
  city            City      @relation(fields: [cityId], references: [id])
  state           State     @relation(fields: [stateId], references: [id])

  @@index([name])
  @@index([branchId])
  @@index([cityId])
  @@index([stateId])
}

model Role {
  id              String           @id @default(cuid())
  name            String           @unique
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @default(now()) @updatedAt
  isSystem        Boolean          @default(false)
  rolePermissions RolePermission[]
  users           User[]
}

model PermissionDef {
  id              String           @id @default(cuid())
  key             String           @unique
  moduleCode      String
  description     String?
  isSystem        Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions RolePermission[]
  userPermissions UserPermission[]

  @@index([moduleCode])
}

model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime      @default(now())
  permission   PermissionDef @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role          @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model UserPermission {
  userId       String
  permissionId String
  effect       PermissionEffect
  createdAt    DateTime         @default(now())
  permission   PermissionDef    @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
  @@index([permissionId])
}

model UserBranch {
  userId    String
  branchId  String
  createdAt DateTime @default(now())
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, branchId])
  @@index([branchId])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  action    String
  entity    String
  entityId  String
  before    Json?
  after     Json?
  createdAt DateTime @default(now())
  actor     User     @relation(fields: [actorId], references: [id])

  @@index([entity, entityId])
  @@index([actorId])
  @@index([createdAt])
}

model NotificationEvent {
  id            String                  @id @default(cuid())
  eventType     String
  sourceModule  String
  aggregateType String
  aggregateId   String
  branchId      String?
  actorId       String?
  payload       Json
  dedupeKey     String?                 @unique
  status        NotificationEventStatus @default(PENDING)
  attemptCount  Int                     @default(0)
  lastError     String?
  createdAt     DateTime                @default(now())
  processedAt   DateTime?
  deliveries    NotificationDelivery[]

  @@index([eventType])
  @@index([sourceModule])
  @@index([aggregateType, aggregateId])
  @@index([branchId])
  @@index([status, createdAt])
}

model NotificationRule {
  id                   String                @id @default(cuid())
  eventType            String
  name                 String
  description          String?
  enabled              Boolean               @default(true)
  severity             NotificationSeverity  @default(INFO)
  critical             Boolean               @default(false)
  recipientResolverKey String
  channels             NotificationChannel[]
  templateId           String?
  sourceModule         String?
  branchId             String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  template             NotificationTemplate? @relation(fields: [templateId], references: [id])

  @@index([eventType])
  @@index([enabled])
  @@index([sourceModule])
  @@index([branchId])
}

model NotificationTemplate {
  id                 String              @id @default(cuid())
  code               String
  channel            NotificationChannel
  subject            String?
  body               String
  meta               Json?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  metaCategory       String?
  metaFooter         String?
  metaLanguage       String?
  metaName           String?
  metaParamOrder     String[]            @default([])
  metaRejectedReason String?
  metaStatus         String?
  metaSubmittedAt    DateTime?
  metaSyncedAt       DateTime?
  metaTemplateId     String?
  rules              NotificationRule[]

  @@unique([code, channel])
}

model NotificationDelivery {
  id                String                     @id @default(cuid())
  eventId           String
  channel           NotificationChannel
  recipientUserId   String
  status            NotificationDeliveryStatus @default(PENDING)
  providerMessageId String?
  attemptCount      Int                        @default(0)
  lastError         String?
  sentAt            DateTime?
  deliveredAt       DateTime?
  failedAt          DateTime?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  inAppNotification InAppNotification?
  event             NotificationEvent          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  recipient         User                       @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@unique([eventId, channel, recipientUserId])
  @@index([recipientUserId, status])
  @@index([channel, status])
  @@index([createdAt])
}

model InAppNotification {
  id         String               @id @default(cuid())
  deliveryId String               @unique
  userId     String
  title      String
  body       String
  severity   NotificationSeverity @default(INFO)
  linkUrl    String?
  readAt     DateTime?
  archivedAt DateTime?
  createdAt  DateTime             @default(now())
  delivery   NotificationDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([userId, archivedAt])
}

model UserNotificationSubscription {
  userId     String
  eventType  String
  channel    NotificationChannel
  subscribed Boolean             @default(true)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, eventType, channel])
  @@index([eventType, channel])
}

model Vehicle {
  id                 String        @id @default(cuid())
  vehicleNumber      String        @unique
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  bodyType           String?
  capacityMT         Float
  insuranceCompany   String?
  insuranceDueDate   DateTime?
  insuranceIssueDate DateTime?
  insuranceNumber    String?
  lengthFeet         String?
  ownershipType      ownershipType
  purchaseDate       DateTime?
  wheels             String?
  currentKM          Int
  openingKM          Int
  status             VehicleStatus @default(AVAILABLE)
  vehicleTypeId      String
  transportId        String?
  marketLRGroups     LRGroup[]     @relation("LRGroupMarketVehicle")
  vehicleTypeRef     VehicleType   @relation(fields: [vehicleTypeId], references: [id])
  transport          Transport?    @relation(fields: [transportId], references: [id], onDelete: Restrict)

  VehicleTrip      VehicleTrip[]
  journeys         VehicleJourney[]
  driverAdvances   DriverAdvance[]
  logSlips         LogSlip[]
  deliveryChallans DeliveryChallan[]
  jobCards         JobCard[]
  costDefault      VehicleCostDefault?
  monthlyCosts     VehicleMonthlyCost[]

  @@index([transportId, ownershipType])
  @@index([vehicleTypeId])
}

/// Standing monthly fixed costs for a vehicle (annual tax/insurance/fitness
/// spread over 12 months, EMI, permit). Applies to every month that has no
/// VehicleMonthlyCost override. Reporting only — nothing posts to accounts.
model VehicleCostDefault {
  vehicleId      String   @id
  taxPaise       BigInt   @default(0)
  insurancePaise BigInt   @default(0)
  permitPaise    BigInt   @default(0)
  fitnessPaise   BigInt   @default(0)
  emiPaise       BigInt   @default(0)
  updatedById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
}

/// One vehicle's costs for one calendar month ("YYYY-MM"). Fixed costs here
/// override the vehicle's defaults for that month; salary, tyre and other are
/// entered monthly (no default). Spare & repairs come from Job Cards, not here.
model VehicleMonthlyCost {
  id             String   @id @default(cuid())
  vehicleId      String
  month          String
  taxPaise       BigInt   @default(0)
  insurancePaise BigInt   @default(0)
  permitPaise    BigInt   @default(0)
  fitnessPaise   BigInt   @default(0)
  emiPaise       BigInt   @default(0)
  salaryPaise    BigInt   @default(0)
  tyrePaise      BigInt   @default(0)
  otherPaise     BigInt   @default(0)
  remarks        String?
  updatedById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@unique([vehicleId, month])
  @@index([month])
}

model Customer {
  id                      String             @id @default(cuid())
  name                    String
  shortName               String?
  customerPAN             String?
  disallowNewLRBooking    Boolean            @default(false)
  splitBillsByChargeType  Boolean            @default(false)
  interestRateLatePayment BigInt?
  gstNo                   String?
  creditLimit             BigInt?
  tdsDeductionRate        BigInt?
  address                 String?
  country                 String?
  contactPhone            String?
  primaryEmail            String?
  contactPerson           String?
  mobileNo                String?
  website                 String?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  cityId                  String
  stateId                 String
  agreements              Agreement[]        @relation("CustomerAgreements")
  city                    City               @relation(fields: [cityId], references: [id])
  state                   State              @relation(fields: [stateId], references: [id])
  locations               CustomerLocation[]
  consigneeGroups         LRGroup[]          @relation("GroupConsignee")
  consignorGroups         LRGroup[]          @relation("GroupConsignor")
  consigneeOrders         Order[]            @relation("OrderConsignee")
  orders                  Order[]            @relation("OrderCustomer")
  vehicleTrips            VehicleTrip[]
  billsAsServiceCustomer  Bill[]             @relation("BillServiceCustomer")
  billsAsBillingCustomer  Bill[]             @relation("BillBillingCustomer")
  billCreditNotes         BillCreditNote[]
  receipts                Receipt[]
  cashReceivables         CashReceivable[]
  ledgerEntries           LedgerEntry[]
  ledger                  Ledger?

  @@index([name])
  @@index([cityId])
  @@index([stateId])
}

model Agreement {
  id                      String          @id @default(cuid())
  companyId               String
  clientId                String
  startDate               DateTime
  agreementDate           DateTime
  expiryDate              DateTime
  leadGeneratedByBranchId String
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
  cityId                  String
  city                    City            @relation(fields: [cityId], references: [id])
  client                  Customer        @relation("CustomerAgreements", fields: [clientId], references: [id])
  company                 Company         @relation(fields: [companyId], references: [id])
  branch                  Branch          @relation("BranchAgreement", fields: [leadGeneratedByBranchId], references: [id])
  detentionRates          DetentionRate[]
  RateMatrix              RateMatrix[]

  @@index([agreementDate(sort: Desc)])
  @@index([companyId])
  @@index([clientId])
  @@index([leadGeneratedByBranchId])
  @@index([cityId])
}

model DetentionRate {
  id           String            @id @default(cuid())
  agreementId  String
  type         DetentionRateType
  fromDuration Int
  toDuration   Int
  rate         Int
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  agreement    Agreement         @relation(fields: [agreementId], references: [id], onDelete: Cascade)
}

model Route {
  id                String        @id @default(cuid())
  sourceCityId      String
  destinationCityId String
  orders            Order[]
  rateMatrixEntries RateMatrix[]
  destinationCity   City          @relation("DestinationRoute", fields: [destinationCityId], references: [id])
  sourceCity        City          @relation("SourceRoute", fields: [sourceCityId], references: [id])
  VehicleTrip       VehicleTrip[]

  @@unique([sourceCityId, destinationCityId])
  @@index([destinationCityId])
}

model RateUnit {
  id         String       @id @default(cuid())
  unitValue  BigInt
  unitType   RateUnitType
  isActive   Boolean      @default(true)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  rateMatrix RateMatrix[]

  @@unique([unitValue, unitType])
}

model RateMatrix {
  id            String            @id @default(cuid())
  agreementId   String
  routeId       String
  rate          BigInt
  transitDays   Int?
  remarks       String?
  vehicleTypeId String?
  transportType RateTransportType @default(ROAD)
  unitId        String?
  agreement     Agreement         @relation(fields: [agreementId], references: [id])
  route         Route             @relation(fields: [routeId], references: [id])
  unit          RateUnit?         @relation(fields: [unitId], references: [id])
  vehicleType   VehicleType?      @relation(fields: [vehicleTypeId], references: [id])
  VehicleTrip   VehicleTrip[]

  @@unique([agreementId, routeId, vehicleTypeId, unitId, transportType])
  @@index([routeId])
  @@index([vehicleTypeId])
  @@index([unitId])
  @@index([rate])
}

model Driver {
  id                 String           @id @default(cuid())
  name               String
  photoPath          String?
  type               String
  birthDate          DateTime?
  anniversaryDate    DateTime?
  mobile             String?
  licenseNo          String?
  licenseDate        DateTime?
  licenseExpiryDate  DateTime?
  licenseCity        String?
  address            String?
  country            String?
  state              String?
  city               String?
  referencePerson    String?
  referenceContactNo String?
  otherDetails       String?
  salary             BigInt?
  panNo              String?
  aadharCardNo       String?
  onLeave            Boolean          @default(false)
  blackListed        Boolean          @default(false)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  status             DriverStatus     @default(AVAILABLE)
  VehicleTrip        VehicleTrip[]
  journeys           VehicleJourney[]
  advances           DriverAdvance[]
  logSlips           LogSlip[]
  jobCards           JobCard[]
  ledger             Ledger?

