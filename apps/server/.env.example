# PostgreSQL connection string used by Prisma and the server.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/skerp?schema=public"

# Server runtime.
PORT=5000
NODE_ENV=development

# Authentication secrets. Replace these with long random values locally.
ACCESS_TOKEN_SECRET="replace-with-access-token-secret"
REFRESH_TOKEN_SECRET="replace-with-refresh-token-secret"
JWT_SECRET="replace-with-jwt-secret"

# Employee web app URL — used in credential emails.
EMPLOYEE_WEB_URL="http://localhost:3002"

# Amazon SES (optional). If AWS_REGION is unset, employee credential emails
# are logged to the server console instead of being sent.
# The MAIL_FROM identity (domain or address) must be verified in SES.
# Leave the access keys blank on AWS infra to use an IAM role instead.
AWS_REGION="ap-south-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
MAIL_FROM="SK Translines ERP <no-reply@sckonnect.com>"
