# Public URL for the API server used by the admin web app.
NEXT_PUBLIC_API_URL="http://localhost:5000"
NEXT_PUBLIC_SOCKET_URL="http://localhost:5000"

# Google Maps JS SDK key for the Vehicle Tracking map (restrict by HTTP referrer).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
# Optional Cloud-configured Map ID for AdvancedMarker styling (falls back to DEMO_MAP_ID).
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=""

# In-app feedback — testing phase only (remove-before-prod). Build-time flag:
# "true" shows the Feedback button and Settings → Feedback. The server must
# also have FEEDBACK_ENABLED="true".
NEXT_PUBLIC_FEEDBACK_ENABLED="false"
# Shown on feedback reports so developers know which build was tested (e.g. git SHA).
NEXT_PUBLIC_APP_VERSION=""
# "training" on the training deployment only: shows the Training environment
# badge and the Practice missions page. Must match the server's APP_ENVIRONMENT.
NEXT_PUBLIC_APP_ENVIRONMENT="production"
