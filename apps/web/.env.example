# Public URL for the API server used by the admin web app.
NEXT_PUBLIC_API_URL="http://localhost:5000"
NEXT_PUBLIC_SOCKET_URL="http://localhost:5000"

# Google Maps JS SDK key for the Vehicle Tracking map (restrict by HTTP referrer).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
# Optional Cloud-configured Map ID for AdvancedMarker styling (falls back to DEMO_MAP_ID).
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=""
