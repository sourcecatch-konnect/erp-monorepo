# Optional shared environment values for monorepo-level commands.
# The server app loads apps/server/.env when running @skerp/server scripts.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/skerp?schema=public"
PORT=5000
NODE_ENV=development

# Authentication secrets. Replace these with long random values locally.
ACCESS_TOKEN_SECRET="replace-with-access-token-secret"
REFRESH_TOKEN_SECRET="replace-with-refresh-token-secret"
JWT_SECRET="replace-with-jwt-secret"

# Admin web app.
NEXT_PUBLIC_API_URL="http://localhost:5000"
