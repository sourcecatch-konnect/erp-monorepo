{
  "extends": "@skerp/typescript-config/react-library.json",
  "compilerOptions": {
    "rootDir": "src",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "outDir": "dist",
    "strictNullChecks": true,
    "types": ["vite/client"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowArbitraryExtensions": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", ".storybook"]
}