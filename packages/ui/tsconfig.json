{
  "extends": "@skerp/typescript-config/react-library.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    },
    "outDir": "dist",
    "strictNullChecks": true,
    "types": ["vite/client"],
    "moduleResolution": "Bundler",
    "allowArbitraryExtensions": true
  },
  "include": ["src", ".storybook"],
  "exclude": ["node_modules", "dist"]
}