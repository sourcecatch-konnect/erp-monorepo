{
  "name": "@skerp/validators",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./master/state": {
      "types": "./src/master/state.schema.ts",
      "import": "./dist/master/state.schema.js"
    },
    "./master/city": {
      "types": "./src/master/city.schema.ts",
      "import": "./dist/master/city.schema.js"
    },
    "./master/area": {
      "types": "./src/master/area.schema.ts",
      "import": "./dist/master/area.schema.js"
    },
    "./master/transport": {
      "types": "./src/master/transport.schema.ts",
      "import": "./dist/master/transport.schema.js"
    },
    "./master/vehicle": {
      "types": "./src/master/vehicle.schema.ts",
      "import": "./dist/master/vehicle.schema.js"
    },
    "./master/vehicle-type": {
      "types": "./src/master/vehicleType.schema.ts",
      "import": "./dist/master/vehicleType.schema.js"
    },
    "./order": {
      "types": "./src/order/order.schema.ts",
      "import": "./dist/order/order.schema.js"
    },
    "./admin/rbac": {
      "types": "./src/admin/rbac.schema.ts",
      "import": "./dist/admin/rbac.schema.js"
    },
    "./attachments": {
      "types": "./src/attachments/attachment.schema.ts",
      "import": "./dist/attachments/attachment.schema.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@skerp/eslint-config": "workspace:*",
    "@skerp/typescript-config": "workspace:*",
    "eslint": "^9.39.1",
    "typescript": "5.9.2"
  }
}
