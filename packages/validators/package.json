{
  "name": "@skerp/validators",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./master/state": {
      "types": "./dist/master/state.schema.d.ts",
      "import": "./dist/master/state.schema.js"
    },
    "./master/city": {
      "types": "./dist/master/city.schema.d.ts",
      "import": "./dist/master/city.schema.js"
    },
    "./master/area": {
      "types": "./dist/master/area.schema.d.ts",
      "import": "./dist/master/area.schema.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@skerp/eslint-config": "workspace:*",
    "@skerp/typescript-config": "workspace:*",
    "eslint": "^9.39.1",
    "typescript": "5.9.2"
  }
}