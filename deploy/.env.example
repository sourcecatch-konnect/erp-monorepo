# Copy to `.env` on the production host, next to docker-compose.prod.yml.
# Never commit the real file.

# Image tag to run — the deploy workflow rewrites this line on every deploy.
# Roll back by setting a previous git short-sha and `docker compose up -d`.
IMAGE_TAG=latest

# Address Caddy serves. ":80" = plain HTTP on the instance IP.
# Set a domain (e.g. erp.example.com) to get automatic HTTPS.
SITE_ADDRESS=:80

# Public origin of the site as the browser sees it (used for CORS).
# Must match SITE_ADDRESS, e.g. http://203.0.113.10 or https://erp.example.com
WEB_URL=https://erp.example.com

# --- Postgres (backend network only, never exposed) --------------------------
POSTGRES_USER=skerp
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=skerp

# --- Redis (backend network only) --------------------------------------------
REDIS_PASSWORD=replace-me

# --- Auth ---------------------------------------------------------------------
ACCESS_TOKEN_SECRET=replace-me
REFRESH_TOKEN_SECRET=replace-me
JWT_SECRET=replace-me
# Same-origin behind Caddy — leave unset unless web and API live on
# different origins.
# COOKIE_CROSS_SITE=true

# --- AWS (S3 attachments + SES mail) ------------------------------------------
AWS_REGION="ap-south-1"
AWS_ACCESS_KEY_ID="replace-me"
AWS_SECRET_ACCESS_KEY="replace-me"
AWS_S3_BUCKET="replace-me"
AWS_S3_REGION="ap-south-1"
MAIL_FROM="SK Translines ERP <no-reply@example.com>"

# --- Attachments ---------------------------------------------------------------
ATTACHMENT_MAX_SIZE_BYTES="10485760"
ATTACHMENT_ALLOWED_MIME="image/jpeg,image/png,image/webp,image/gif,application/pdf"

# --- Notifications --------------------------------------------------------------
NOTIFICATION_QUEUE_PREFIX="skerp"

# --- E-way bill (WB) -------------------------------------------------------------
WB_EWAY_BASE_URL="https://apisandbox.whitebooks.in"
WB_EWAY_CLIENT_ID="replace-me"
WB_EWAY_CLIENT_SECRET="replace-me"
WB_EWAY_USERNAME="replace-me"
WB_EWAY_PASSWORD="replace-me"
WB_EWAY_GSTIN="replace-me"
WB_EWAY_EMAIL="replace-me"

# --- Meta WhatsApp -----------------------------------------------------------------
META_WHATSAPP_API_BASE_URL="https://graph.facebook.com/v20.0"
META_WHATSAPP_APP_ID="replace-me"
META_WHATSAPP_APP_SECRET="replace-me"
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN="replace-me"
META_WHATSAPP_PHONE_NUMBER_ID="replace-me"
META_WHATSAPP_ACCESS_TOKEN="replace-me"
META_WHATSAPP_BUSINESS_ACCOUNT_ID="replace-me"
META_WHATSAPP_DEFAULT_LANGUAGE="en_US"
META_WHATSAPP_DEFAULT_TEMPLATE_NAME="skerp_notification"

# --- Onelap GPS (Traccar) -------------------------------------------------------------
ONELAP_BASE_URL="https://web.onelap.in"
ONELAP_EMAIL="replace-me"
ONELAP_PASSWORD="replace-me"
