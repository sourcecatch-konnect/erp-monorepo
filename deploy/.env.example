# Copy to `.env` on the production host, next to docker-compose.prod.yml.
# Never commit the real file.

# Image tag to run — the deploy workflow rewrites this line on every deploy.
# Roll back by setting a previous git short-sha and `docker compose up -d`.
IMAGE_TAG=latest

# Address Caddy serves. ":80" = plain HTTP on the instance IP.
# Set a domain (e.g. erp.example.com) to get automatic HTTPS.
SITE_ADDRESS=:80

# Public origin of the site as the browser sees it (used for CORS).
# Must match SITE_ADDRESS, e.g. http://203.0.113.10 or https://erp.example.com
WEB_URL=https://test-erp.sktranslines.com

# --- Postgres (backend network only, never exposed) --------------------------
POSTGRES_USER=skerp
POSTGRES_PASSWORD=QtK0192823
POSTGRES_DB=skerp

# --- Redis (backend network only) --------------------------------------------
