{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "DATABASE_URL",
    "DIRECT_URL",
    "JWT_SECRET",
    "NODE_ENV",
    "PORT",
    "REDIS_URL",
    "NOTIFICATION_QUEUE_PREFIX",
    "AWS_REGION",
    "AWS_S3_REGION",
    "AWS_S3_BUCKET",
    "AWS_ACCESS_KEY_ID",
    "AWS_SECRET_ACCESS_KEY",
    "ATTACHMENT_MAX_SIZE_BYTES",
    "ATTACHMENT_ALLOWED_MIME",
    "API_PROXY_TARGET",
    "NEXT_OUTPUT",
    "NEXT_PUBLIC_TEST_MODE",
    "ACCESS_TOKEN_SECRET",
    "REFRESH_TOKEN_SECRET",
    "COOKIE_CROSS_SITE",
    "MAIL_FROM",
    "WEB_URL",
    "WB_EWAY_BASE_URL",
    "WB_EWAY_CLIENT_ID",
    "WB_EWAY_CLIENT_SECRET",
    "WB_EWAY_USERNAME",
    "WB_EWAY_PASSWORD",
    "WB_EWAY_GSTIN",
    "WB_EWAY_EMAIL",
    "META_WHATSAPP_API_BASE_URL",
    "META_WHATSAPP_PHONE_NUMBER_ID",
    "META_WHATSAPP_ACCESS_TOKEN",
    "META_WHATSAPP_DEFAULT_TEMPLATE_NAME",
    "META_WHATSAPP_BUSINESS_ACCOUNT_ID",
    "META_WHATSAPP_DEFAULT_LANGUAGE",
    "META_WHATSAPP_WEBHOOK_VERIFY_TOKEN",
    "META_WHATSAPP_APP_SECRET",
    "META_WHATSAPP_MANAGEMENT_TOKEN",
    "ONELAP_BASE_URL",
    "ONELAP_EMAIL",
    "ONELAP_PASSWORD"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "db:generate": {
      "cache": false
    }
  }
}
